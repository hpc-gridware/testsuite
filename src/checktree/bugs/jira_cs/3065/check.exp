# CS-3065: with TLS, a client which connects but never sends a handshake blocks the daemon.
#
# The daemon ran the SSL accept on a blocking socket. SSL_accept() waited in read() for the
# handshake, and the daemon handled no other connection until the client sent data or closed
# the connection. The socket is now non-blocking during the SSL accept, which gives up after
# one second.
#
# The check holds an idle TCP connection to sge_qmaster open and runs qstat meanwhile.
# Without the fix qstat fails with "SSL connect timed out after 10 seconds".

# define global variable in this namespace
global check_name
global check_category
global check_description
global check_needs
global check_functions
global check_root_access_needs
global check_version_range

set check_root_access_needs "no"
set check_version_range "9.1.8"

# define test's name and run level descriptions
set check_name            "cs3065"
set check_category        "BUG SECURITY TLS VERIFIED"
set check_description(0)  "an idle TCP connection without TLS handshake does not block sge_qmaster"

# define test's dependencies
set check_needs           "init_core_system"

# setup and cleanup functions
set check_setup_function cs3065_setup
set check_cleanup_function cs3065_cleanup

# define test's procedure order
set check_functions {}
lappend check_functions "cs3065_idle_connection"

# -------- local test procedures: initialization------------------------------

proc cs3065_setup {} {
   global cs3065_idle_seconds cs3065_max_qstat_seconds

   if {![config_has_product_feature "tls"]} {
      ts_log_config "the check requires product feature tls"
      return 99
   }

   # how long the helper holds the idle connection open
   set cs3065_idle_seconds 60
   # with the fix sge_qmaster gives up the SSL accept after one second
   set cs3065_max_qstat_seconds 5

   return 0
}

proc cs3065_cleanup {} {
   global cs3065_idle_seconds cs3065_max_qstat_seconds

   unset -nocomplain cs3065_idle_seconds cs3065_max_qstat_seconds
}

# -------- test procedures ---------------------------------------------------

## @brief qstat works while an idle TCP connection to sge_qmaster is open
#
# Before the fix sge_qmaster blocked in SSL_accept() on the idle connection and qstat timed out.
proc cs3065_idle_connection {} {
   get_current_cluster_config_array ts_config
   global CHECK_USER CHECK_ACTUAL_TEST_PATH
   global cs3065_idle_seconds cs3065_max_qstat_seconds

   set host [host_conf_get_suited_hosts]
   set script "$CHECK_ACTUAL_TEST_PATH/idle_connect.sh"
   set args "$ts_config(master_host) $ts_config(commd_port) $cs3065_idle_seconds"
   set sp_id [open_remote_spawn_process $host $CHECK_USER $script $args]
   set spawn_id [lindex $sp_id 1]

   set connected 0
   set timeout 30
   expect {
      -i $spawn_id "idle connection established" {
         set connected 1
      }
      -i $spawn_id timeout {
         ts_log_severe "the helper on host $host did not connect to sge_qmaster"
      }
      -i $spawn_id eof {
         ts_log_severe "the helper on host $host exited before it connected to sge_qmaster"
      }
   }

   if {$connected} {
      ts_log_fine "idle connection from host $host is open, running qstat"
      set start [clock milliseconds]
      set output [start_sge_bin "qstat" "" $host]
      set duration [expr ([clock milliseconds] - $start) / 1000.0]
      if {$prg_exit_state != 0} {
         ts_log_severe "qstat failed after $duration seconds while an idle connection was\
                        open:\n$output"
      } elseif {$duration > $cs3065_max_qstat_seconds} {
         ts_log_severe "qstat took $duration seconds while an idle connection was open,\
                        expected at most $cs3065_max_qstat_seconds seconds"
      } else {
         ts_log_fine "qstat took $duration seconds while an idle connection was open"
      }
   }

   close_spawn_process $sp_id
}
