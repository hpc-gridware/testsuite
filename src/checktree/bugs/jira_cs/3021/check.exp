# CS-3021: failed job scopes are never reset and pile up in systemd.
#
# A job scope which ends in the failed state, e.g. with Result=oom-kill after a memory cgroup OOM
# kill, stays loaded in systemd until its failed state is reset. sge_execd resets the scope of a
# job when it cleans up the job. A failed scope with the name of a new job's scope, e.g. left over
# from before the update, is reset by sge_shepherd before it creates the job scope - before the
# fix the job failed to start with "Unit ... was already loaded".
#
# The OOM kill needs OOMPolicy=kill on the scope, which needs cgroup v2 and systemd 252 or newer.
# The jobs are submitted with SGE_DEBUG_MEMORY_SWAP_MAX=0 in their environment, which makes
# sge_shepherd set MemorySwapMax=0 on the job scope - otherwise the memory above MemoryMax is
# swapped out on a host with swap space, and no OOM kill happens.

# define global variable in this namespace
global check_name
global check_category
global check_description
global check_needs
global check_functions
global check_root_access_needs
global check_version_range

set check_root_access_needs "yes"
set check_version_range "9.1.8"

# define test's name and run level descriptions
set check_name            "cs3021"
# not VERIFIED yet: without the fix of CS-3021 the OOM kills leave the job scopes in the failed
# state. The framework reports the failed scopes as error after the check, and a later job with
# the same job id cannot start. Add VERIFIED when CS-3021 is in all branches the testsuite runs on.
set check_category        "BUG EXECD SYSTEMD"
set check_description(0)  "failed job scopes are reset"

# define test's dependencies
set check_needs           "init_core_system"

# setup and cleanup functions
set check_setup_function cs3021_setup
set check_cleanup_function cs3021_cleanup

# define test's procedure order
set check_functions {}
lappend check_functions "cs3021_oom_killed_scope_is_reset"
lappend check_functions "cs3021_leftover_failed_scope"

# -------- local test procedures: initialization------------------------------

proc cs3021_setup {} {
   get_current_cluster_config_array ts_config
   global cs3021_host

   # a host where OOMPolicy can be set on the job scope: cgroup v2 and systemd >= 252
   set cs3021_host ""
   foreach host $ts_config(execd_nodes) {
      if {[systemd_get_version $host] >= 252 && [systemd_get_cgroup_version $host] == 2} {
         set cs3021_host $host
         break
      }
   }
   if {$cs3021_host == ""} {
      ts_log_config "no execution host with cgroup v2 and systemd 252 or newer"
      return 99
   }

   return 0
}

proc cs3021_cleanup {} {
   global cs3021_host

   delete_all_jobs
   wait_for_end_of_all_jobs 60

   unset -nocomplain cs3021_host
}

# -------- test procedures ---------------------------------------------------

## @brief get the LoadState of a unit
#
# @param host the host
# @param unit the unit, e.g. a job scope
# @return the LoadState, e.g. "loaded" or "not-found"
proc cs3021_get_load_state {host unit} {
   set output [start_remote_prog $host "root" "systemctl" \
                  "--no-pager show -p LoadState --value $unit"]
   return [string trim $output]
}

## @brief the failed scope of an OOM killed job is reset
#
# The OOM killer ends the job scope, it is left in the failed state. After the job has ended,
# sge_execd has reset it, and systemd has unloaded it.
proc cs3021_oom_killed_scope_is_reset {} {
   get_current_cluster_config_array ts_config
   global cs3021_host

   set work "$ts_config(product_root)/examples/jobsbin/[resolve_arch $cs3021_host]/work"
   set job_args "-l h=$cs3021_host,h_rss=100M -v SGE_DEBUG_MEMORY_SWAP_MAX=0 -o /dev/null -j y"
   append job_args " -b y $work -touchM 300 -w 1"
   set job_id [submit_job $job_args]
   if {$job_id <= 0} {
      return
   }
   if {[wait_for_job_end $job_id 120] != 0} {
      return
   }

   # make sure the job scope really ended in the failed state
   if {[get_qacct $job_id qacct_info] != 0} {
      return
   }
   if {![info exists qacct_info(deleted_by)] ||
       ![string match "oom-killer@*" $qacct_info(deleted_by)]} {
      ts_log_severe "job $job_id was not ended by the OOM killer, the check does not test\
                     anything"
      return
   }

   set scope [systemd_get_job_scope $job_id]
   set load_state [cs3021_get_load_state $cs3021_host $scope]
   if {$load_state != "not-found"} {
      ts_log_severe "the failed job scope $scope on host $cs3021_host has not been reset,\
                     its LoadState is \"$load_state\""
   } else {
      ts_log_fine "the failed job scope $scope on host $cs3021_host has been reset"
   }
}

## @brief a job starts although a failed scope with the name of its scope is still loaded
#
# A failed scope is created with the name of the scope of the next job. sge_shepherd resets it and
# creates the job scope. Before the fix the job failed, its scope was "already loaded".
proc cs3021_leftover_failed_scope {} {
   get_current_cluster_config_array ts_config
   global cs3021_host

   # the next job id: the one of a job which is deleted again, plus 1
   set job_id [submit_job "-h -o /dev/null -j y -b y /bin/true"]
   if {$job_id <= 0} {
      return
   }
   delete_job $job_id 1
   set next_job_id [expr {$job_id + 1}]
   set scope [systemd_get_job_scope $next_job_id]

   # create the failed scope: its process is killed by the OOM killer
   set work "$ts_config(product_root)/examples/jobsbin/[resolve_arch $cs3021_host]/work"
   start_remote_prog $cs3021_host "root" "systemd-run" "--scope --unit=$scope -p MemoryMax=20M\
                     -p MemorySwapMax=0 -p OOMPolicy=kill $work -touchM 100 -w 1"
   set output [start_remote_prog $cs3021_host "root" "systemctl" "is-failed $scope"]
   if {[string trim $output] != "failed"} {
      ts_log_severe "cannot create a failed scope $scope on host $cs3021_host, systemctl\
                     is-failed says \"[string trim $output]\""
      start_remote_prog $cs3021_host "root" "systemctl" "reset-failed $scope"
      return
   }

   set job_id [submit_job "-l h=$cs3021_host -o /dev/null -j y -b y /bin/sleep 5"]
   if {$job_id != $next_job_id} {
      ts_log_severe "the job got the id $job_id, expected $next_job_id - the check cannot work"
      start_remote_prog $cs3021_host "root" "systemctl" "reset-failed $scope"
      return
   }
   if {[wait_for_job_end $job_id 120] != 0} {
      return
   }
   if {[get_qacct $job_id qacct_info] != 0} {
      return
   }
   # failed is the number followed by its description, e.g. "100 : assumedly after job"
   regexp {[0-9]+} $qacct_info(failed) failed
   if {$qacct_info(exit_status) != 0 || $failed != 0} {
      ts_log_severe "job $job_id did not run with the failed scope $scope left over:\
                     exit_status $qacct_info(exit_status), failed $qacct_info(failed),\
                     expected exit_status 0, failed 0"
   }
   # the Result of the left over scope is not the one of the job
   if {[info exists qacct_info(deleted_by)]} {
      ts_log_severe "job $job_id has deleted_by \"$qacct_info(deleted_by)\", expected none"
   }
}
