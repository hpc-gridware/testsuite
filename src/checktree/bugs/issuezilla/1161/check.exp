# Define the global variables to give them back
global check_name check_description check_needs check_functions
global check_category
global check_root_access_needs

set check_category            "COMPATIBILITY SYSTEM VERIFIED"
set check_name                "issue_1161"
set check_description(0)      "qconf -mc segfaults"
set check_needs               "init_core_system"      ;# dependencies of this check (name of other check)
set check_root_access_needs   "no"

# setup and cleanup functions

# define test's procedure order
set check_functions           ""
lappend check_functions       "issue_1161_run"   ;# functions to call (in order)

## @brief Hand "qconf -mc" a complex entry that is not one and expect a refusal
#
# Issuezilla 1161: the client dereferenced name and shortcut without checking
# them, so a text whose entry carried neither made qconf die. What the vi
# command leaves behind is still exactly that text - the trailing newline of the
# insert puts "complex1161" alone on line 1 and pushes the header comment down,
# so the first element has neither a shortcut nor a type. The assertion is that
# qconf refuses it with a reason instead of crashing.
#
# Which of the two possible refusals is printed depends on the release, so the
# expectation does too:
#
#  - up to 9.1 the client checked name, shortcut and urgency inside the pairwise
#    duplicate loop, and that loop never runs for the first element because it
#    has no predecessor to compare against. The missing shortcut was skipped and
#    the type check in centry_elem_validate() reported first.
#  - from 9.2 on the write procedure's qconf_ce_verify_list() (CS-2823) checks
#    every element once before the request is sent, so the missing shortcut is
#    found first and the type is never reached. The same change closed the hole
#    the old loop left: a text holding exactly one entry was never checked.
#
# Both refusals are correct for this doubly invalid text, and neither writes
# anything, so the version distinction records what each line does rather than
# accepting either on both.
#
# @return none - the check reports through ts_log_severe
proc issue_1161_run {} {
   global ts_config

   set vi_commands ""
   lappend vi_commands "1Gicomplex1161\n[format "%c" 27]"

   # localize messages
   if {[is_version_in_range "9.2.0"]} {
      set INVALID [translate_macro MSG_CENTRY_NULL_SHORTCUT_S "complex1161"]
   } else {
      set INVALID [translate_macro MSG_SGETEXT_UNKNOWN_ATTR_TYPE_U 0]
   }

   # add by handling vi
   set master_arch [resolve_arch $ts_config(master_host)]
   handle_vi_edit "echo" "\"\"\nSGE_ENABLE_MSG_ID=1\nexport SGE_ENABLE_MSG_ID\n$ts_config(product_root)/bin/$master_arch/qconf -mc" $vi_commands $INVALID
}
