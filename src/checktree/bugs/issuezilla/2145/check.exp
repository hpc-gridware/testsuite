# define global variable in this namespace
global check_name 
global check_category 
global check_description 
global check_needs
global check_functions 
global check_root_access_needs

# define test's name and run level descriptions
set check_name            "issue_2145"
set check_category        "COMPATIBILITY SYSTEM VERIFIED"
set check_description(0)  "verify scheduler profiles for installation"

# define test's dependencies
set check_needs           "init_core_system" 

# setup and cleanup functions
set check_setup_function issue_2145_setup
set check_cleanup_function issue_2145_cleanup

# define test's procedure order
set check_functions ""
lappend check_functions "issue_2145_test"

# -------- local test procedures: initialization------------------------------

proc issue_2145_setup {} {
   global ts_config
   global complex_backup
   global issue_2145_qinstance
   global issue_2145_global_host_touched

   # backup complex
   get_complex complex_backup

   # nothing modified yet - the test function fills these in once it has touched
   # the queue instance and the global host, and the cleanup uses them to know
   # what to put back. Restoring unconditionally would be wrong: writing "NONE"
   # to a global host that carried complex_values before the test would wipe
   # them, and the check would report itself as the test that broke the cluster.
   unset -nocomplain issue_2145_qinstance issue_2145_global_host_touched
}

proc issue_2145_cleanup {} {
   global ts_config
   global complex_backup
   global issue_2145_qinstance
   global issue_2145_global_host_touched

   # Take the host specific complex_values entry off the queue again.
   #
   # It cannot be undone by writing "NONE": since 9.2 a modification implies an
   # add (CS-2300), so "qconf -rattr queue" on a QUEUE INSTANCE always creates
   # the host override - with "NONE" it just becomes an empty one. The cluster
   # queue then keeps an entry for this host that was not there before the test
   # (CS-2595). "qconf -purge" is the operation that removes it.
   #
   # This sits in the cleanup and no longer at the end of the test function, so
   # a severe in the middle of the test does not leave the override behind.
   if {[info exists issue_2145_qinstance]} {
      purge_queue $issue_2145_qinstance "complex_values"
      unset issue_2145_qinstance
   }

   # the global host takes a plain list, so "NONE" really empties it there
   if {[info exists issue_2145_global_host_touched]} {
      mhattr "complex_values" "NONE" "global"
      unset issue_2145_global_host_touched
   }

   # reset complex configuration - last, while nothing references it any more
   reset_complex complex_backup
   unset complex_backup
}


proc issue_2145_test {} {
   global ts_config
   global issue_2145_qinstance
   global issue_2145_global_host_touched

   set exechost_name [host_conf_get_suited_hosts]
   set qinstance_name [get_queue_instance all.q $exechost_name]

   # add a additional complex entry
   set test_complex(test) "test INT <= YES YES 0 1000"
   set_complex test_complex

   # add a value test=5 to the global host
   set issue_2145_global_host_touched 1
   set ret [mhattr "complex_values" "test=5" "global"]

   # check if queue is returned
   set result [start_sge_bin "qselect" "-l test=5"]
   if {[string compare $qinstance_name $result] == 0} {
      ts_log_severe "qselect returned queue although there was no output expected"
   }   

   # add a value test=1 to all.q@$exechost_name
   # from here on the queue instance carries a host override the cleanup has to
   # remove again
   set issue_2145_qinstance $qinstance_name
   set ret [mqattr "complex_values" "test=1" $qinstance_name]

   # check if queue is returned
   set result [start_sge_bin "qselect" "-l test=1"]
   if {[string compare $qinstance_name $result] == 0} {
      ts_log_severe "qselect returned queue although there was one expected after modifying qinstance"
   }   

}

