# define global variable in this namespace
global check_name
global check_category
global check_description
global check_needs
global check_functions
global check_root_access_needs

# define test's name and run level descriptions
set check_name            "issue_1473"
set check_category        "COMPATIBILITY SYSTEM L10N VERIFIED"
set check_description(0)  "check performance problem when adding/modifying/deleting centries"

# define test's dependencies
set check_needs           "init_core_system"


# setup and cleanup functions
set check_setup_function "issue_1473_setup"
set check_cleanup_function "issue_1473_cleanup"

# define test's procedure order
set check_functions ""
lappend check_functions "issue_1473_add"
lappend check_functions "issue_1473_mod"
lappend check_functions "issue_1473_del"

# -------- local test procedures -----------------------------------------------

proc issue_1473_setup {} {
   global ts_config CHECK_PROTOCOL_DIR
   global num_queues complex_backup CHECK_USER

   # create a high number of queues - this will make the bug showing up more likely
   set num_queues 20
   ts_log_fine "creating $num_queues queues"
   set queue_conf(slots) 1
   set queue_names {}
   for {set i 0} {$i < $num_queues} {incr i} {
      lappend queue_names "iz_1473_$i"
   }
   set queue_conf(hostlist) [get_all_hosts_hostgroup]
   cluster_bulk_add_objects "-Aq" $queue_names qname set_queue_defaults queue_conf \
                            {issue_1473_add_queue}

   # backup old complex
   if {[info exists complex_backup]} {
      unset complex_backup
   }
   set complex_backup "$CHECK_PROTOCOL_DIR/complex.txt"
   ts_log_fine "backup current complex to $complex_backup"
   set master_arch [resolve_arch $ts_config(master_host)]
   set output [start_remote_prog $ts_config(master_host) $CHECK_USER $ts_config(product_root)/bin/$master_arch/qconf "-sc > $complex_backup"]
   if {$prg_exit_state != 0} {
      ts_log_severe "backing up complex failed: $output"
   }
}

proc issue_1473_cleanup {} {
   global ts_config
   global num_queues complex_backup

   # delete queues
   ts_log_fine "deleting test queues"
   set queue_names {}
   for {set i 0} {$i < $num_queues} {incr i} {
      lappend queue_names "iz_1473_$i"
   }
   del_queue $queue_names "" 0 1

   # restore old complex
   ts_log_fine "restoring complex from $complex_backup"
   modify_complex_from_file $complex_backup
}

## @brief Write a complex entry file with "qconf -Mc" and classify the output.
#
# Measures how long the write takes and recognises every line qconf can answer
# with, so that an unexpected line is reported instead of being counted as a
# modification.
#
# Two of the recognised lines are release dependent: keeping the built-in
# attributes a file does not define and saying so, and reporting a text that
# changes nothing with a message of its own. Neither exists in every release
# this check runs against, so both lookups ask the version under test whether
# it knows the macro before translating it.
#
# @param filename       the complex entry file to write
# @param time_var       name of the caller's variable that receives the
#                       duration of the write in seconds, -1 if the file is
#                       missing
# @param do_error_check 1 to also require that 200 entries were modified
# @return nothing; problems are reported with ts_log_severe
proc modify_complex_from_file {filename {time_var dummy} {do_error_check 0}} {
   global ts_config CHECK_USER

   upvar $time_var time

   if {![file exists $filename]} {
      ts_log_severe "file $filename doesn't exist"
      set time -1
   } else {
      ts_log_fine "modify complex from file $filename"
      set time_start [clock clicks -milliseconds]
      ts_log_fine "start ..."
      set master_arch [resolve_arch $ts_config(master_host)]
      set output [start_remote_prog $ts_config(master_host) $CHECK_USER $ts_config(product_root)/bin/$master_arch/qconf "-Mc $filename"]
      set time_end [clock clicks -milliseconds]
      set time [expr ($time_end - $time_start) / 1000.0]

      # parse returned strings
      set MSG_CENTRY_NOTCHANGED [translate_macro MSG_CENTRY_NOTCHANGED]
      set MSG_SGETEXT_ADDEDTOLIST_SSSS [translate_macro MSG_SGETEXT_ADDEDTOLIST_SSSS $CHECK_USER "*" "APP*" "*"]
      set MSG_SGETEXT_REMOVEDFROMLIST_SSSS [translate_macro MSG_SGETEXT_REMOVEDFROMLIST_SSSS $CHECK_USER "*" "APP*" "*"]
      set MSG_SGETEXT_MODIFIEDINLIST_SSSS [translate_macro MSG_SGETEXT_MODIFIEDINLIST_SSSS $CHECK_USER "*" "APP*" "*"]
      set MSG_INVALID_CENTRY_DEL_S [translate_macro MSG_INVALID_CENTRY_DEL_S "*"]
      # CS-2523: "qconf -Mc" keeps built-in complexes the file does not define,
      # exits 0 and names them. This check feeds 201 entries and never lists the
      # built-ins, so the notice appears on every call. Without a pattern for it
      # the loop below reaches its "else" and reports "complex failed" for a
      # command that succeeded - which is what happened in the full run of
      # 2026-08-07, where it was the ONLY real defect.
      #
      # The same holds for the second release dependent line: from 9.2 on the
      # write is carried out by the stored procedure in sge_qmaster, and a text
      # that changes nothing is answered with a message of its own instead of
      # the client's MSG_CENTRY_NOTCHANGED. This check reaches it on every
      # restore that has nothing left to restore.
      #
      # Neither message exists in every release the check runs against - it has
      # no check_version_range - and translate_macro on a macro the version
      # under test does not know fails, which would break the check on the older
      # releases instead of fixing it here. So both lookups are guarded, and the
      # guard asks the version under test whether it knows the macro rather than
      # comparing release numbers: CS-2523 was fixed in the 9.1 line as well
      # (e060780e0, not in any release tag yet), so a "from 9.2 on" condition is
      # already wrong for the kept-built-in message and would have to be
      # corrected again with every backport. An empty pattern never matches, so
      # the guard is enough.
      set MSG_CENTRY_KEPT_BUILTIN_S ""
      if {[is_macro_available MSG_CENTRY_KEPT_BUILTIN_S]} {
         set MSG_CENTRY_KEPT_BUILTIN_S [translate_macro MSG_CENTRY_KEPT_BUILTIN_S "*"]
      }
      set MSG_QCONF_WRITENOCHANGE ""
      if {[is_macro_available MSG_QCONF_WRITENOCHANGE]} {
         set MSG_QCONF_WRITENOCHANGE [translate_macro MSG_QCONF_WRITENOCHANGE]
      }
      set output_list [split $output "\n"]
      set changed 0
      foreach line $output_list {
         set line [string trim $line]
         if {[string length $line] > 0} {
            if {[string match $MSG_CENTRY_NOTCHANGED $line] || \
                ($MSG_QCONF_WRITENOCHANGE != "" && \
                 [string match $MSG_QCONF_WRITENOCHANGE $line])} {
               set changed 0
            } else {
               if {[string match $MSG_SGETEXT_ADDEDTOLIST_SSSS $line] || \
                   [string match $MSG_SGETEXT_REMOVEDFROMLIST_SSSS $line] || \
                   [string match $MSG_SGETEXT_MODIFIEDINLIST_SSSS $line] } {
                   incr changed
               } else {
                  if {[string match $MSG_INVALID_CENTRY_DEL_S $line] || \
                      ($MSG_CENTRY_KEPT_BUILTIN_S != "" && \
                       [string match $MSG_CENTRY_KEPT_BUILTIN_S $line])} {
                  } else {
                     ts_log_severe "complex failed: $line"
                  }
               }
            }
         }
      }
      if {$do_error_check == 1 && $changed != 200} {
         ts_log_severe "only $changed of 201 complex entries were modified"
      }
   }
}

proc issue_1473_do_qconf {message filename} {
   ts_log_fine "$message, using file $filename"
   modify_complex_from_file $filename time 1
   ts_log_fine "time required: $time s"

   set max_time [scale_timeout 4.0 0 1 0]

   if {$time > $max_time} {
      ts_log_severe "$message may not take that long ($time s), should take max. $max_time s"
   }
}

proc issue_1473_add {} {
   global CHECK_ACTUAL_TEST_PATH

   set add_file "$CHECK_ACTUAL_TEST_PATH/add_complex.txt"
   issue_1473_do_qconf "adding complex entries" $add_file
}

proc issue_1473_mod {} {
   global CHECK_ACTUAL_TEST_PATH

   set mod_file "$CHECK_ACTUAL_TEST_PATH/mod_complex.txt"
   issue_1473_do_qconf "modifying complex entries" $mod_file
}

proc issue_1473_del {} {
   global complex_backup

   issue_1473_do_qconf "deleting complex entries" $complex_backup
}

## @brief create a single queue - fallback for versions without bulk requests
# @param queue_name name of the queue
proc issue_1473_add_queue {queue_name} {
   set queue_conf(slots) 1
   add_queue $queue_name [get_all_hosts_hostgroup] queue_conf 1
}
