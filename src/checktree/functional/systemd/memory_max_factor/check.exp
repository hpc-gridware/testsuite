# execd_params MEMORY_MAX_FACTOR: on a host with systemd, sge_shepherd sets MemoryMax and
# MemoryHigh of the job scope to the hard and soft memory limits of the job multiplied by the
# factor. 0 means that neither is set, values between 0 and 1 and other invalid values are
# replaced by the default 1.
#
# With a factor greater than 1, a job which exceeds h_rss is killed by sge_execd, not by the
# kernel, and the accounting record shows deleted_by execd@<hostname>.

# define global variable in this namespace
global check_name
global check_category
global check_description
global check_needs
global check_functions
global check_root_access_needs
global check_version_range

set check_root_access_needs "no"
set check_version_range "9.1.8"

# define test's name and run level descriptions
set check_name            "systemd_memory_max_factor"
set check_category        "EXECD SYSTEMD VERIFIED"
set check_description(0)  "execd_params MEMORY_MAX_FACTOR scales MemoryMax and MemoryHigh of the\
                           job scope"

# define test's dependencies
set check_needs           "init_core_system"

# setup and cleanup functions
set check_setup_function systemd_memory_max_factor_setup
set check_cleanup_function systemd_memory_max_factor_cleanup

# define test's procedure order
set check_functions {}
lappend check_functions "systemd_memory_max_factor_scope_limits"
lappend check_functions "systemd_memory_max_factor_execd_kills"

# -------- local test procedures: initialization------------------------------

proc systemd_memory_max_factor_setup {} {
   get_current_cluster_config_array ts_config
   global systemd_memory_max_factor_host systemd_memory_max_factor_backup

   # a host with cgroup v2, where MemoryHigh is applied as well
   set systemd_memory_max_factor_host ""
   foreach host $ts_config(execd_nodes) {
      if {[systemd_get_version $host] >= 0 && [systemd_get_cgroup_version $host] == 2} {
         set systemd_memory_max_factor_host $host
         break
      }
   }
   if {$systemd_memory_max_factor_host == ""} {
      ts_log_config "no execution host with systemd and cgroup v2"
      return 99
   }

   get_config systemd_memory_max_factor_backup $systemd_memory_max_factor_host

   return 0
}

proc systemd_memory_max_factor_cleanup {} {
   global systemd_memory_max_factor_host systemd_memory_max_factor_backup

   delete_all_jobs
   wait_for_end_of_all_jobs 60

   reset_config_and_propagate systemd_memory_max_factor_backup $systemd_memory_max_factor_host

   unset -nocomplain systemd_memory_max_factor_host systemd_memory_max_factor_backup
}

# -------- test procedures ---------------------------------------------------

## @brief set MEMORY_MAX_FACTOR in the execd_params of the test host
#
# @param factor the value
proc systemd_memory_max_factor_set {factor} {
   global systemd_memory_max_factor_host systemd_memory_max_factor_backup

   add_or_replace_array_param conf systemd_memory_max_factor_backup "execd_params" \
      "MEMORY_MAX_FACTOR" $factor
   set_config_and_propagate conf $systemd_memory_max_factor_host
}

## @brief check MemoryMax and MemoryHigh of the scope of a job with h_rss=100M and s_rss=80M
#
# @param factor the factor to set
# @param memory_max the expected MemoryMax
# @param memory_high the expected MemoryHigh
proc systemd_memory_max_factor_check_scope {factor memory_max memory_high} {
   get_current_cluster_config_array ts_config
   global systemd_memory_max_factor_host

   set host $systemd_memory_max_factor_host
   systemd_memory_max_factor_set $factor

   set job_args "-l h=$host,h_rss=100M,s_rss=80M -o /dev/null -j y"
   append job_args " $ts_config(product_root)/examples/jobs/sleeper.sh 60"
   set job_id [submit_job $job_args]
   if {$job_id <= 0} {
      return
   }
   if {[wait_for_jobstart $job_id "" 60] != 0} {
      return
   }

   set scope [systemd_get_job_scope $job_id]
   foreach {property expected} [list MemoryMax $memory_max MemoryHigh $memory_high] {
      set value [systemd_get_property $host $scope $property]
      if {$value != $expected} {
         ts_log_severe "MEMORY_MAX_FACTOR=$factor: $property of the job scope $scope is\
                        \"$value\", expected \"$expected\""
      } else {
         ts_log_fine "MEMORY_MAX_FACTOR=$factor: $property of the job scope $scope is $expected"
      }
   }

   delete_job $job_id 1
}

## @brief MemoryMax and MemoryHigh are the limits multiplied by the factor
proc systemd_memory_max_factor_scope_limits {} {
   set max [transform_unit "100M"]
   set high [transform_unit "80M"]

   systemd_memory_max_factor_check_scope 1 $max $high
   systemd_memory_max_factor_check_scope 1.5 [expr {$max * 3 / 2}] [expr {$high * 3 / 2}]
   systemd_memory_max_factor_check_scope 0 "infinity" "infinity"

   # invalid values: the default 1 is used
   systemd_memory_max_factor_check_scope 0.5 $max $high
   systemd_memory_max_factor_check_scope "abc" $max $high
}

## @brief with a factor greater than 1, sge_execd kills a job which exceeds h_rss
proc systemd_memory_max_factor_execd_kills {} {
   get_current_cluster_config_array ts_config
   global systemd_memory_max_factor_host

   set host $systemd_memory_max_factor_host
   systemd_memory_max_factor_set 2

   # 150M is above h_rss, but below MemoryMax (200M): the kernel does not kill the job
   set work "$ts_config(product_root)/examples/jobsbin/[resolve_arch $host]/work"
   set job_args "-l h=$host,h_rss=100M -v SGE_DEBUG_MEMORY_SWAP_MAX=0 -o /dev/null -j y"
   append job_args " -b y $work -touchM 150 -w 60"
   set job_id [submit_job $job_args]
   if {$job_id <= 0} {
      return
   }
   if {[wait_for_job_end $job_id 120] != 0} {
      return
   }
   if {[get_qacct $job_id qacct_info] != 0} {
      return
   }

   set expected "execd@[resolve_host $host 0]"
   if {![info exists qacct_info(deleted_by)]} {
      ts_log_severe "job $job_id exceeded h_rss, but was not killed by sge_execd: exit_status\
                     $qacct_info(exit_status), failed $qacct_info(failed), no deleted_by"
   } elseif {[resolve_host [lindex [split $qacct_info(deleted_by) "@"] 1] 0] !=
             [resolve_host $host 0] || ![string match "execd@*" $qacct_info(deleted_by)]} {
      ts_log_severe "job $job_id has deleted_by \"$qacct_info(deleted_by)\", expected\
                     \"$expected\""
   } else {
      ts_log_fine "job $job_id was killed by sge_execd: deleted_by \"$qacct_info(deleted_by)\""
   }
}
