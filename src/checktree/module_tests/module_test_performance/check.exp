# define global variable in this namespace

global check_name
global check_category
global check_description
global check_needs
global check_functions
global check_root_access_needs

set check_root_access_needs "no"

set check_name            "module_test_performance"
set check_category        "MODULE TESTBIN PERFORMANCE VERIFIED"
# see module_test_generic: the binaries come from the installed $SGE_ROOT/testbin
set check_needs           "init_core_system"

# ---------------------------------------------------------------------------
# Module tests that MEASURE rather than assert.
#
# These three were split out of module_test_generic (CS-2438 work, 2026-08-04).
# None of them asserts on a timing threshold -- they take a measurement, print
# it and pass. That is exactly why they had to be separated: run next to 31
# other clusters they cannot fail, so nothing draws attention to the fact that
# the numbers they printed measured the contention rather than the code.
#
# Consequences encoded here:
#   * one level per binary, so a run can schedule them one at a time
#   * NO host sweep -- unlike module_test_generic there is no 100/200 band.
#     A measurement is only comparable against the same host, so sweeping
#     architectures would produce numbers that look comparable and are not.
#   * run these serially if the numbers are to be believed:
#         92x check <this dir> 0
#     A full parallel run still executes them; treat the numbers from such a
#     run as indicative only.
#
# The level IS the index into performance_module_tests -- do not reorder.
# ---------------------------------------------------------------------------

# {binary min_version}
# check.exp is sourced from inside a proc, so the list has to be declared global
# HERE, at file scope -- otherwise "set" makes a local and the run function's
# "global performance_module_tests" finds nothing ("no such variable").
global performance_module_tests
set performance_module_tests {}
lappend performance_module_tests {test_uti_profiling ""}
lappend performance_module_tests {test_sgeobj_performance ""}
lappend performance_module_tests {test_sched_eval_performance ""}

set check_description(0) "test_uti_profiling (timing measurement)"
set check_description(1) "test_sgeobj_performance (timing measurement)"
set check_description(2) "test_sched_eval_performance (timing measurement)"

set check_functions {}
lappend check_functions "performance_module_tests_run"

## @brief Run the one performance module test this level selects.
#
# Failures are still failures: these binaries return non-zero when the code
# under test misbehaves. Only their timing output is load-sensitive.
#
# @return none; reports failures through ts_log_severe
proc performance_module_tests_run {} {
   global ts_config CHECK_USER CHECK_ACT_LEVEL
   global performance_module_tests

   set index $CHECK_ACT_LEVEL
   if {$index >= [llength $performance_module_tests]} {
      ts_log_info "level $CHECK_ACT_LEVEL has no performance module test assigned"
      return
   }

   lassign [lindex $performance_module_tests $index] module_test min_version

   # ------------------------------------------------------------------------
   # ts_log_info, NEVER ts_log_config, in a check function.
   #
   # ts_log_config records -3 in check_errno($CHECK_CUR_PROC_NAME), and the
   # framework turns any -3 into "level unsupported"
   # (private_check_error_run_test_level, check.exp). check_errno is keyed by
   # FUNCTION NAME and is not cleared between levels, and every level of this
   # check runs the same function -- so a single ts_log_config here marks every
   # FOLLOWING level unsupported too, including the ones that ran and passed.
   #
   # Observed 2026-08-04: level 23 skips test_RequestLimits on 9.2 (replaced by
   # test_sgeobj_RequestLimits). With ts_log_config, levels 24..149 all reported
   # UNSUPPORTED although their binaries ran and passed.
   #
   # The framework only sanctions ts_log_config in a setup function that then
   # returns 99 (check.exp: "setup_ret == 99 ... this means there was no
   # ts_log_config"). If a level should report "unsupported" rather than simply
   # be logged as skipped, add a check_setup_level_function that does both --
   # do not call ts_log_config from here.
   # ------------------------------------------------------------------------
   if {$min_version ne "" && ![is_version_in_range $min_version]} {
      ts_log_info "$module_test needs version $min_version or newer - skipped"
      return
   }

   # measurements are only comparable on one host - no sweep here on purpose
   set host [lindex [host_conf_get_suited_hosts] 0]
   ts_log_fine "$module_test on $host, arch [resolve_arch $host]"

   set time_in_sec 600
   set output [start_test_bin $module_test "" $host $CHECK_USER ret $time_in_sec]
   if {$ret == 0} {
      ts_log_fine "   => $module_test ok"
      ts_log_fine $output
   } else {
      ts_log_severe "performance module test $module_test failed on $host:\n$output"
   }
}
