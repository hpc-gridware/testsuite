# define global variable in this namespace

global check_name
global check_category
global check_description
global check_needs
global check_functions
global check_root_access_needs

set check_root_access_needs "yes"

set check_name            "module_test_uti"
set check_category        "MODULE TESTBIN VERIFIED UTI"
# start_test_bin runs the binary from the INSTALLED $SGE_ROOT/testbin, so the
# product has to be installed (see module_test_generic)
set check_needs           "init_core_system"

# ---------------------------------------------------------------------------
# The module tests of libs/uti, one level per binary, laid out like
# module_test_generic (see there): the level is the index into the list, in the
# short band 0-99, entries are appended and never reordered or deleted.
# Version and feature gating is done by the run function, not by the level.
# ---------------------------------------------------------------------------

# {binary min_version needs_gcs max_version}
# check.exp is sourced from inside a proc, so the list is declared global here.
global uti_module_tests
set uti_module_tests {}
lappend uti_module_tests {test_uti_bitfield "" 0 ""}
lappend uti_module_tests {test_uti_deadlock "" 0 ""}
lappend uti_module_tests {test_uti_lock_fifo "" 0 ""}
lappend uti_module_tests {test_uti_lock_multiple "" 0 ""}
lappend uti_module_tests {test_uti_lock_simple "" 0 ""}
lappend uti_module_tests {test_uti_err "" 0 ""}
lappend uti_module_tests {test_uti_sl "" 0 ""}
lappend uti_module_tests {test_uti_tq "" 0 ""}
lappend uti_module_tests {test_uti_string "" 0 ""}
lappend uti_module_tests {test_uti_dstring "" 0 ""}
lappend uti_module_tests {test_uti_uidgid "" 0 ""}
lappend uti_module_tests {test_uti_authinfo "9.2.0" 0 ""}
lappend uti_module_tests {test_uti_parse_num "9.2.0" 0 ""}
lappend uti_module_tests {test_uti_peopen "9.1.3" 0 ""}
lappend uti_module_tests {test_uti_threads "" 0 ""}
lappend uti_module_tests {test_uti_thread_local "" 0 ""}
lappend uti_module_tests {test_uti_time "" 0 ""}
lappend uti_module_tests {test_uti_os_fds "" 0 ""}
lappend uti_module_tests {test_uti_Encoder "9.1.0" 0 ""}
lappend uti_module_tests {test_uti_lock_held "9.2.0" 0 ""}
lappend uti_module_tests {test_uti_cpus "9.2.0" 0 ""}
lappend uti_module_tests {test_uti_format_text "9.2.0" 0 ""}
lappend uti_module_tests {test_uti_cpp_features "9.2.0" 0 ""}
lappend uti_module_tests {test_uti_exception "9.2.0" 0 ""}

# the description of a level is the name of its binary, one literal line per
# entry of uti_module_tests in the same order: tools that list the supported
# levels (gcs-testscan) read these lines without running the Tcl
set check_description(0) "test_uti_bitfield"
set check_description(1) "test_uti_deadlock"
set check_description(2) "test_uti_lock_fifo"
set check_description(3) "test_uti_lock_multiple"
set check_description(4) "test_uti_lock_simple"
set check_description(5) "test_uti_err"
set check_description(6) "test_uti_sl"
set check_description(7) "test_uti_tq"
set check_description(8) "test_uti_string"
set check_description(9) "test_uti_dstring"
set check_description(10) "test_uti_uidgid"
set check_description(11) "test_uti_authinfo"
set check_description(12) "test_uti_parse_num"
set check_description(13) "test_uti_peopen"
set check_description(14) "test_uti_threads"
set check_description(15) "test_uti_thread_local"
set check_description(16) "test_uti_time"
set check_description(17) "test_uti_os_fds"
set check_description(18) "test_uti_Encoder"
set check_description(19) "test_uti_lock_held"
set check_description(20) "test_uti_cpus"
set check_description(21) "test_uti_format_text"
set check_description(22) "test_uti_cpp_features"
set check_description(23) "test_uti_exception"

set check_functions {}
lappend check_functions "uti_module_tests_run"


## @brief Run the one uti module test binary this level selects
#
# @return none; reports failures through ts_log_severe
proc uti_module_tests_run {} {
   global uti_module_tests
   ocs_module_test_run_level $uti_module_tests
}
