# define global variable in this namespace

global check_name
global check_category
global check_description
global check_needs
global check_functions
global check_root_access_needs

set check_root_access_needs "no"

set check_name            "module_test_cluster"
# One category per check, not per level -- so both SPOOLING and RBAC select all
# three binaries here. That is deliberate: they are seconds each, and they all
# need the cluster this check already brings up. Splitting further to make the
# tags exact would cost an init_core_system dependency per check.
#   SPOOLING  test_spool_flatfile
#   RBAC      test_qmaster_hgroup_reserved (CS-2438 reserved host groups)
#             test_qmaster_hgroup_cache    (CS-2451 resolved host list cache)
set check_category        "MODULE TESTBIN SPOOLING RBAC VERIFIED"
set check_needs           "init_core_system"

# ---------------------------------------------------------------------------
# Module tests that need an installed $SGE_ROOT or a running qmaster.
#
# Split out of module_test_generic (2026-08-04), which runs with
# check_needs "" -- i.e. with no cluster guaranteed. Two failure modes made the
# split necessary rather than cosmetic:
#
#   * test_spool_flatfile calls ocs::Bootstrap::get_ignore_fqdn(), and that
#     lookup ABORTS the process when SGE_ROOT is unset. Its own comment notes
#     the abort is invisible once the test daemonizes.
#   * test_qmaster_hgroup_reserved enrolls with the qmaster over GDI. Without a
#     cluster it can only report "no cluster reachable" -- a test that always
#     skips is worse than no test, because it looks green.
#
# init_core_system gives both: a running cluster, and with it a valid SGE_ROOT.
#
# One level per binary so the parallel runner can schedule them independently.
# The level IS the index -- do not reorder.
#
# NOT here on purpose:
#   test_mir_basic   subscribes to all events and loops forever with no
#                    termination condition; it would hang the check.
#   test_drmaa*      driven by the api/drmaa checktree, which sets up job
#                    submission; duplicating them here would run them twice.
#   test_uti_authinfo  self-contained: mkdtemp() + sge_setenv("SGE_ROOT", ...),
#                    so it needs no installed root and stays generic.
# ---------------------------------------------------------------------------

# {binary min_version}
# check.exp is sourced from inside a proc, so the list has to be declared global
# HERE, at file scope -- otherwise "set" makes a local and the run function's
# "global cluster_module_tests" finds nothing ("no such variable").
global cluster_module_tests
set cluster_module_tests {}
lappend cluster_module_tests {test_sgeobj_eval_expression ""}
lappend cluster_module_tests {test_spool_flatfile ""}
lappend cluster_module_tests {test_qmaster_hgroup_reserved "9.2.0"}
lappend cluster_module_tests {test_qmaster_hgroup_cache "9.2.0"}

set check_description(0) "test_sgeobj_eval_expression (needs SGE_ROOT)"
set check_description(1) "test_spool_flatfile (needs SGE_ROOT)"
set check_description(2) "test_qmaster_hgroup_reserved (needs a running qmaster)"
set check_description(3) "test_qmaster_hgroup_cache (needs a running qmaster)"

set check_functions {}
lappend check_functions "cluster_module_tests_run"

## @brief Run the one cluster module test this level selects.
#
# @return none; reports failures through ts_log_severe
proc cluster_module_tests_run {} {
   global ts_config CHECK_USER CHECK_ACT_LEVEL
   global cluster_module_tests

   set index $CHECK_ACT_LEVEL
   if {$index >= [llength $cluster_module_tests]} {
      ts_log_info "level $CHECK_ACT_LEVEL has no cluster module test assigned"
      return
   }

   lassign [lindex $cluster_module_tests $index] module_test min_version

   # ------------------------------------------------------------------------
   # ts_log_info, NEVER ts_log_config, in a check function.
   #
   # ts_log_config records -3 in check_errno($CHECK_CUR_PROC_NAME), and the
   # framework turns any -3 into "level unsupported"
   # (private_check_error_run_test_level, check.exp). check_errno is keyed by
   # FUNCTION NAME and is not cleared between levels, and every level of this
   # check runs the same function -- so a single ts_log_config here marks every
   # FOLLOWING level unsupported too, including the ones that ran and passed.
   #
   # Observed 2026-08-04: level 23 skips test_RequestLimits on 9.2 (replaced by
   # test_sgeobj_RequestLimits). With ts_log_config, levels 24..149 all reported
   # UNSUPPORTED although their binaries ran and passed.
   #
   # The framework only sanctions ts_log_config in a setup function that then
   # returns 99 (check.exp: "setup_ret == 99 ... this means there was no
   # ts_log_config"). If a level should report "unsupported" rather than simply
   # be logged as skipped, add a check_setup_level_function that does both --
   # do not call ts_log_config from here.
   # ------------------------------------------------------------------------
   if {$min_version ne "" && ![is_version_in_range $min_version]} {
      ts_log_info "$module_test needs version $min_version or newer - skipped"
      return
   }

   # the master host is where the cluster is guaranteed to be reachable
   set host $ts_config(master_host)
   ts_log_fine "$module_test on $host, arch [resolve_arch $host]"

   set time_in_sec 600
   set output [start_test_bin $module_test "" $host $CHECK_USER ret $time_in_sec]

   # a cluster module test that reports "no cluster" must not pass silently
   if {$ret == 99} {
      ts_log_severe "$module_test could not reach the cluster although init_core_system ran:\n$output"
      return
   }
   if {$ret == 0} {
      ts_log_fine "   => $module_test ok"
      ts_log_fine $output
   } else {
      ts_log_severe "cluster module test $module_test failed on $host:\n$output"
   }
}
