# define global variable in this namespace

global check_name
global check_category
global check_description
global check_needs
global check_functions
global check_cleanup_function
global check_root_access_needs

set check_root_access_needs "yes"

set check_name            "module_test_cull"
set check_category        "MODULE TESTBIN VERIFIED CULL"
# start_test_bin runs the binary from the INSTALLED $SGE_ROOT/testbin, so the
# product has to be installed (see module_test_generic)
set check_needs           "init_core_system"

# ---------------------------------------------------------------------------
# The module tests of libs/cull, one level per binary, laid out like
# module_test_generic (see there): the level is the index into the list, in the
# short band 0-99, entries are appended and never reordered or deleted.
# Version and feature gating is done by the run function, not by the level.
# ---------------------------------------------------------------------------

# {binary min_version needs_gcs max_version}
# check.exp is sourced from inside a proc, so the list is declared global here.
global cull_module_tests
set cull_module_tests {}
lappend cull_module_tests {test_cull_hash "" 0 ""}
lappend cull_module_tests {test_cull_list "" 0 ""}
lappend cull_module_tests {test_cull_observe "" 0 ""}
lappend cull_module_tests {test_cull_pack "" 0 ""}
lappend cull_module_tests {test_cull_enumeration "" 0 ""}
lappend cull_module_tests {test_cull_no_transfer "9.2.0" 0 ""}
lappend cull_module_tests {test_cull_sort "9.2.0" 0 ""}
lappend cull_module_tests {test_cull_access "9.2.0" 0 ""}
lappend cull_module_tests {test_cull_lookup "9.2.0" 0 ""}
lappend cull_module_tests {test_cull_db "9.2.0" 0 ""}
lappend cull_module_tests {test_cull_select_pack "9.2.0" 0 ""}
lappend cull_module_tests {test_cull_owner "9.2.0" 0 ""}
lappend cull_module_tests {test_cull_pack_format "9.2.0" 0 ""}
lappend cull_module_tests {test_cull_lazy "9.2.0" 0 ""}
lappend cull_module_tests {test_cull_descr "9.2.0" 0 ""}

# the description of a level is the name of its binary, one literal line per
# entry of cull_module_tests in the same order: tools that list the supported
# levels (gcs-testscan) read these lines without running the Tcl
set check_description(0) "test_cull_hash"
set check_description(1) "test_cull_list"
set check_description(2) "test_cull_observe"
set check_description(3) "test_cull_pack"
set check_description(4) "test_cull_enumeration"
set check_description(5) "test_cull_no_transfer"
set check_description(6) "test_cull_sort"
set check_description(7) "test_cull_access"
set check_description(8) "test_cull_lookup"
set check_description(9) "test_cull_db"
set check_description(10) "test_cull_select_pack"
set check_description(11) "test_cull_owner"
set check_description(12) "test_cull_pack_format"
set check_description(13) "test_cull_lazy"
set check_description(14) "test_cull_descr"

set check_functions {}
lappend check_functions "cull_module_tests_run"

set check_cleanup_function "cull_module_tests_cleanup"


## @brief Run the one CULL module test binary this level selects
#
# @return none; reports failures through ts_log_severe
proc cull_module_tests_run {} {
   global cull_module_tests
   ocs_module_test_run_level $cull_module_tests
}

## @brief Delete the file test_cull_pack leaves in the home directory
#
# @return none
proc cull_module_tests_cleanup {} {
   global CHECK_USER
   set exec_host [gethostname]
   set home_dir_path [get_home_dir_path $CHECK_USER $exec_host]
   set cull_pack_file_path "$home_dir_path/test_cull_pack.txt"
   ts_log_fine "checking if file \"$cull_pack_file_path\" exists ..."
   if {[is_remote_file $exec_host $CHECK_USER $cull_pack_file_path]} {
      delete_remote_file $exec_host $CHECK_USER $cull_pack_file_path
   }
}
