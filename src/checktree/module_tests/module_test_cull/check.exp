# define global variable in this namespace

global check_name
global check_category
global check_description
global check_needs
global check_functions
global check_cleanup_function
global check_root_access_needs

set check_root_access_needs "yes"

set check_name            "module_test_cull"
set check_category        "MODULE TESTBIN VERIFIED CULL"
# start_test_bin runs the binary from the INSTALLED $SGE_ROOT/testbin, so the
# product has to be installed (see module_test_generic)
set check_needs           "init_core_system"

# ---------------------------------------------------------------------------
# The module tests of libs/cull, one level per binary, laid out like
# module_test_generic (see there): the level is the index into the list, in the
# short band 0-99, entries are appended and never reordered or deleted.
# Version and feature gating is done by the run function, not by the level.
# ---------------------------------------------------------------------------

# {binary min_version needs_gcs max_version}
# check.exp is sourced from inside a proc, so the list is declared global here.
global cull_module_tests
set cull_module_tests {}
lappend cull_module_tests {test_cull_hash "" 0 "9.2.0"}
lappend cull_module_tests {test_cull_list "" 0 "9.2.0"}
lappend cull_module_tests {test_cull_observe "" 0 "9.2.0"}
lappend cull_module_tests {test_cull_pack "" 0 "9.2.0"}
lappend cull_module_tests {test_cull_enumeration "" 0 "9.2.0"}
lappend cull_module_tests {test_cull_no_transfer "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_cull_sort "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_cull_access "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_cull_lookup "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_cull_db "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_cull_select_pack "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_cull_owner "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_cull_pack_format "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_cull_lazy "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_cull_descr "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_cull_plugin "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_tom_traits "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_handles "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_list "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_legacy "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_tom_unique "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_soft_path "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_ops_list "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_tom_ops_own "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_tom_ops_lookup "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_tom_ops_keyed "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_tom_ops_incr "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_tom_ops_select "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_tom_ops_sort "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_tom_ops_pack "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_tom_ops_dump "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_tom_ops_rest "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_tom_ops_free "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_tom_ops_layout "9.2.0" 0 "9.2.0"}
lappend cull_module_tests {test_tom_ops_atomic "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_model "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_raw_access "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_raw_ops "9.2.0" 0 ""}
# CS-3103: the old-vs-new comparison binaries above (test_tom_legacy, test_tom_ops_*) were replaced in 9.2.0 by
# pure TOM tests; their levels stay, gated by max_version
lappend cull_module_tests {test_tom_raw_build "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_free "9.2.0" 0 ""}
# CS-3103: the CULL core tests above were renamed in 9.2.0 when the old list library was removed;
# their levels stay, gated by max_version, and the 9.2 binaries follow
lappend cull_module_tests {test_tom_core_hash "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_core_list "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_core_pack "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_core_enumeration "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_core_no_transfer "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_core_sort "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_core_access "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_core_lookup "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_core_db "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_core_select_pack "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_core_owner "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_core_pack_format "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_core_lazy "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_core_descr "9.2.0" 0 ""}
lappend cull_module_tests {test_tom_core_plugin "9.2.0" 0 ""}

# the description of a level is the name of its binary, one literal line per
# entry of cull_module_tests in the same order: tools that list the supported
# levels (gcs-testscan) read these lines without running the Tcl
set check_description(0) "test_cull_hash"
set check_description(1) "test_cull_list"
set check_description(2) "test_cull_observe"
set check_description(3) "test_cull_pack"
set check_description(4) "test_cull_enumeration"
set check_description(5) "test_cull_no_transfer"
set check_description(6) "test_cull_sort"
set check_description(7) "test_cull_access"
set check_description(8) "test_cull_lookup"
set check_description(9) "test_cull_db"
set check_description(10) "test_cull_select_pack"
set check_description(11) "test_cull_owner"
set check_description(12) "test_cull_pack_format"
set check_description(13) "test_cull_lazy"
set check_description(14) "test_cull_descr"
set check_description(15) "test_cull_plugin"
set check_description(16) "test_tom_traits"
set check_description(17) "test_tom_handles"
set check_description(18) "test_tom_list"
set check_description(19) "test_tom_legacy"
set check_description(20) "test_tom_unique"
set check_description(21) "test_tom_soft_path"
set check_description(22) "test_tom_ops_list"
set check_description(23) "test_tom_ops_own"
set check_description(24) "test_tom_ops_lookup"
set check_description(25) "test_tom_ops_keyed"
set check_description(26) "test_tom_ops_incr"
set check_description(27) "test_tom_ops_select"
set check_description(28) "test_tom_ops_sort"
set check_description(29) "test_tom_ops_pack"
set check_description(30) "test_tom_ops_dump"
set check_description(31) "test_tom_ops_rest"
set check_description(32) "test_tom_ops_free"
set check_description(33) "test_tom_ops_layout"
set check_description(34) "test_tom_ops_atomic"
set check_description(35) "test_tom_model"
set check_description(36) "test_tom_raw_access"
set check_description(37) "test_tom_raw_ops"
set check_description(38) "test_tom_raw_build"
set check_description(39) "test_tom_free"
set check_description(40) "test_tom_core_hash"
set check_description(41) "test_tom_core_list"
set check_description(42) "test_tom_core_pack"
set check_description(43) "test_tom_core_enumeration"
set check_description(44) "test_tom_core_no_transfer"
set check_description(45) "test_tom_core_sort"
set check_description(46) "test_tom_core_access"
set check_description(47) "test_tom_core_lookup"
set check_description(48) "test_tom_core_db"
set check_description(49) "test_tom_core_select_pack"
set check_description(50) "test_tom_core_owner"
set check_description(51) "test_tom_core_pack_format"
set check_description(52) "test_tom_core_lazy"
set check_description(53) "test_tom_core_descr"
set check_description(54) "test_tom_core_plugin"

set check_functions {}
lappend check_functions "cull_module_tests_run"

set check_cleanup_function "cull_module_tests_cleanup"


## @brief Run the one CULL module test binary this level selects
#
# @return none; reports failures through ts_log_severe
proc cull_module_tests_run {} {
   global cull_module_tests
   ocs_module_test_run_level $cull_module_tests
}

## @brief Delete the file the pack test leaves in the home directory
#
# test_cull_pack (up to 9.1) writes test_cull_pack.txt, test_tom_core_pack (9.2) test_tom_core_pack.txt.
#
# @return none
proc cull_module_tests_cleanup {} {
   global CHECK_USER
   set exec_host [gethostname]
   set home_dir_path [get_home_dir_path $CHECK_USER $exec_host]
   foreach file_name {test_cull_pack.txt test_tom_core_pack.txt} {
      set pack_file_path "$home_dir_path/$file_name"
      ts_log_fine "checking if file \"$pack_file_path\" exists ..."
      if {[is_remote_file $exec_host $CHECK_USER $pack_file_path]} {
         delete_remote_file $exec_host $CHECK_USER $pack_file_path
      }
   }
}
