# define global variable in this namespace

global check_name
global check_category
global check_description
global check_needs
global check_functions
global check_root_access_needs

set check_root_access_needs "yes"

set check_name            "module_test_generic"
set check_category        "MODULE TESTBIN VERIFIED COMMLIB"
# start_test_bin runs the binary from the INSTALLED $SGE_ROOT/testbin and fails
# with "cannot find test binary" if the product is not installed -- so even the
# tests that need no running cluster need init_core_system. This used to be ""
# and worked only because gcs-testscan schedules the infra checks first on every
# runner; with one level per binary the dependency has to be declared.
set check_needs           "init_core_system"

# ---------------------------------------------------------------------------
# One level per module test binary, so the parallel runner can schedule them
# independently (gcs-testscan makes one ctest entry per test AND level).
#
#    level == index into generic_module_tests
#
# One band only. The framework reads runlevel bands as DURATION -- 0-99 short,
# 100-199 medium, 200-299 long, 300+ day/week (check.exp runlevel_to_name, and
# gcs-testscan uses the same mapping for its ctest labels). CHECK_ENABLED_RUNLEVELS
# defaults to "0", so only the short band runs unless a full run enables more.
#
# Until 2026-08-05 this check used those bands for HOST SCOPE (suited host / per
# architecture / all hosts), which conflated two unrelated dimensions: a
# two-second binary on six VMs was labelled "long", and "check <level>" could not
# reach it at all. The host sweep is gone; every binary runs on the suited host,
# which is what the levels below say and what the framework can schedule.
#
# The index IS the level, so entries must never be reordered or deleted -- that
# would silently repoint every level below. To retire a binary, keep its slot
# and let the run function skip it. The one exception so far: on 2026-11-04 the
# CULL, uti and sgeobj binaries moved into module_test_cull, module_test_uti and
# module_test_sgeobj and this list was renumbered compactly, as only levels 0-99
# run (CS-2996).
#
# Version and feature gating is NOT expressed with check_version_range(N): the
# level always exists, and the run function skips the binary with ts_log_info
# when the cluster is too old or lacks the feature. That keeps the index stable
# across versions, which a conditional lappend would not.
#
# Binaries that need a running cluster do NOT belong here -- check_needs is "".
# They live in module_test_cluster. The binaries of libs/cull, libs/uti and
# libs/sgeobj live in module_test_cull, module_test_uti and module_test_sgeobj.
# ---------------------------------------------------------------------------

# {binary min_version needs_gcs max_version}
# check.exp is sourced from inside a proc, so the list has to be declared global
# HERE, at file scope -- otherwise "set" makes a local and the run function's
# "global generic_module_tests" finds nothing ("no such variable").
global generic_module_tests
set generic_module_tests {}
lappend generic_module_tests {test_qmaster_timed_event "" 0 ""}
lappend generic_module_tests {test_commlib_issue "" 0 ""}
lappend generic_module_tests {test_comm_xml_parse "9.1.4" 0 ""}
lappend generic_module_tests {test_common_category "" 0 ""}
lappend generic_module_tests {test_qmaster_calendar "" 0 ""}
lappend generic_module_tests {test_sched_resource_utilization "" 0 ""}
lappend generic_module_tests {test_sched_load_formula "" 0 ""}
lappend generic_module_tests {test_procedure_qquota_json "9.2.0" 0 ""}
lappend generic_module_tests {test_procedure_qquota_plain "9.2.0" 0 ""}
lappend generic_module_tests {test_procedure_qrstat_json "9.2.0" 0 ""}
lappend generic_module_tests {test_procedure_qstat_summary "9.2.0" 0 ""}
lappend generic_module_tests {test_qmaster_rusage "9.1.5" 0 ""}
lappend generic_module_tests {test_sched_request_amount "9.1.6" 0 ""}
lappend generic_module_tests {test_procedure_qconf_missing_argument "9.2.0" 0 ""}

# the description of a level is the name of its binary, one literal line per
# entry of generic_module_tests in the same order: tools that list the supported
# levels (gcs-testscan) read these lines without running the Tcl
set check_description(0) "test_qmaster_timed_event"
set check_description(1) "test_commlib_issue"
set check_description(2) "test_comm_xml_parse"
set check_description(3) "test_common_category"
set check_description(4) "test_qmaster_calendar"
set check_description(5) "test_sched_resource_utilization"
set check_description(6) "test_sched_load_formula"
set check_description(7) "test_procedure_qquota_json"
set check_description(8) "test_procedure_qquota_plain"
set check_description(9) "test_procedure_qrstat_json"
set check_description(10) "test_procedure_qstat_summary"
set check_description(11) "test_qmaster_rusage"
set check_description(12) "test_sched_request_amount"
set check_description(13) "test_procedure_qconf_missing_argument"

set check_functions {}
lappend check_functions "generic_module_tests_run"


## @brief Run the one module test binary this level selects.
#
# @return none; reports failures through ts_log_severe
proc generic_module_tests_run {} {
   global generic_module_tests
   ocs_module_test_run_level $generic_module_tests
}
