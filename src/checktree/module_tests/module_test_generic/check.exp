# define global variable in this namespace

global check_name
global check_category
global check_description
global check_needs
global check_functions
global check_root_access_needs

set check_root_access_needs "yes"

set check_name            "module_test_generic"
set check_category        "MODULE TESTBIN VERIFIED COMMLIB"
# start_test_bin runs the binary from the INSTALLED $SGE_ROOT/testbin and fails
# with "cannot find test binary" if the product is not installed -- so even the
# tests that need no running cluster need init_core_system. This used to be ""
# and worked only because gcs-testscan schedules the infra checks first on every
# runner; with one level per binary the dependency has to be declared.
set check_needs           "init_core_system"

# ---------------------------------------------------------------------------
# One level per module test binary, so the parallel runner can schedule them
# independently (gcs-testscan makes one ctest entry per test AND level).
#
#    level div 100 -> host scope   0 suited host, 1 per architecture, 2 all hosts
#    level mod 100 -> index into generic_module_tests
#
# The index IS the level, so entries must never be reordered or deleted -- that
# would silently repoint every level below. To retire a binary, keep its slot
# and let the run function skip it.
#
# Version and feature gating is NOT expressed with check_version_range(N): the
# level always exists, and the run function skips the binary with ts_log_info
# when the cluster is too old or lacks the feature. That keeps the index stable
# across versions, which a conditional lappend would not.
#
# Binaries that need a running cluster do NOT belong here -- check_needs is "".
# They live in module_test_cluster.
# ---------------------------------------------------------------------------

# {binary min_version needs_gcs max_version}
# check.exp is sourced from inside a proc, so the list has to be declared global
# HERE, at file scope -- otherwise "set" makes a local and the run function's
# "global generic_module_tests" finds nothing ("no such variable").
global generic_module_tests
set generic_module_tests {}
lappend generic_module_tests {test_qmaster_timed_event "" 0 ""}
