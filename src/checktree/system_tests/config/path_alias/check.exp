# define global variable in this namespace
global check_name
global check_category
global check_description
global check_needs
global check_functions
global check_root_access_needs
global check_version_range

# define test's name and run level descriptions
set check_name            "path_alias"
set check_category        "COMPATIBILITY SYSTEM L10N VERIFIED"
set check_description(0)  "checking global path alias file"
set check_description(1)  "checking user path alias file"

# Level 1 needs SGE_TEST_USER_HOME_DIR, which the clients honour from 9.1.5 and
# 9.2.0 on (CS-707). Without it they read the per user alias file from the real
# home directory while the test writes it into the runner's own, so the test
# would fail - and on an older client it could not be made parallel safe at all.
# Level 0 uses the cluster's own alias file and is unaffected, which is why the
# range is per runlevel.
set check_version_range(1) "9.1.5"

# define test's dependencies
set check_needs           "init_core_system display_test"


# setup and cleanup functions
set check_setup_function "path_alias_setup"
set check_cleanup_function "path_alias_cleanup"
set check_setup_level_function "path_alias_setup_level"
set check_cleanup_level_function "path_alias_cleanup_level"

# define test's procedure order
set check_functions ""
lappend check_functions "path_alias_main"

global PATH_ALIAS_OUTPUT1
global PATH_ALIAS_OUTPUT2
global path_alias_test
set path_alias_test 0

# The alias file of the current level, and who owns it.
#
# Level 1 tests the per user alias file. It used to write $HOME/.sge_aliases,
# and that made the test unrunnable in a parallel cluster: the clients resolve
# that file through getpwnam(user)->pw_dir (sge_path_alias.cc), so every cluster
# of this operating system user reads the one file. While the test held it, the
# other 31 runners aliased their paths along with it - a resource token could
# have kept the writers apart, but not the readers.
#
# The clients now take the directory from SGE_TEST_USER_HOME_DIR, which
# set_users_environment exports per runner, so level 1 writes into this runner's
# own results directory and reaches nobody else (CS-707).
#
# The ownership bookkeeping stays: with the variable unset - an older client, a
# hand invocation - the test is back on the real home directory, and there it
# must not delete a file it did not create. Cleanup removes only what setup
# created and restores only what setup moved aside. Deleting unconditionally is
# what destroyed the original file once a second run had already restored it.
global path_alias_file
global path_alias_file_created
global path_alias_file_saved
set path_alias_file ""
set path_alias_file_created 0
set path_alias_file_saved 0

# -------- local test procedures -----------------------------------------------

proc path_alias_setup {} {
   setup_host_slots_for_binding
}

proc path_alias_cleanup {} {
   cleanup_host_slots_for_binding
}

proc path_alias_setup_level {} {
   global ts_config
   global CHECK_ACT_LEVEL
   global CHECK_JOB_OUTPUT_DIR
   global CHECK_USER
   global PATH_ALIAS_OUTPUT1
   global PATH_ALIAS_OUTPUT2
   global path_alias_test
   global path_alias_file path_alias_file_created path_alias_file_saved
   global CHECK_PROTOCOL_DIR CHECK_USER_HOME_DIR

   switch -- $CHECK_ACT_LEVEL {
      0 { set path_alias_test 1 }
      1 { set path_alias_test 2 }
   }

   set path_alias_file_created 0
   set path_alias_file_saved   0

   set PATH_ALIAS_OUTPUT1 [ file dirname "$CHECK_JOB_OUTPUT_DIR/adir" ]
   set PATH_ALIAS_OUTPUT2 [ file dirname "$CHECK_JOB_OUTPUT_DIR/adir" ]
   append PATH_ALIAS_OUTPUT1 "/path_alias_output1"
   append PATH_ALIAS_OUTPUT2 "/path_alias_output2"

   ts_log_fine "creating directory: $PATH_ALIAS_OUTPUT1"
   file mkdir $PATH_ALIAS_OUTPUT1
   if { [ file isdirectory $PATH_ALIAS_OUTPUT1 ] != 1 } {
      ts_log_severe "could not create directory $PATH_ALIAS_OUTPUT1"
   }

   ts_log_fine "creating directory: $PATH_ALIAS_OUTPUT2"
   file mkdir $PATH_ALIAS_OUTPUT2
   if { [ file isdirectory $PATH_ALIAS_OUTPUT2 ] != 1 } {
      ts_log_severe "could not create directory $PATH_ALIAS_OUTPUT2"
   }

   if {$path_alias_test == 1} {
      set path_alias_file "$ts_config(product_root)/$ts_config(cell)/common/sge_aliases"
   } else {
      # Not $env(HOME): the clients are told through SGE_TEST_USER_HOME_DIR to
      # read the per user alias file from this runner's own directory. The real
      # home directory is shared by every cluster of this operating system user,
      # so writing there made every other cluster of a parallel run alias its
      # paths along with us. See the note at the top of this file.
      set path_alias_file "$CHECK_USER_HOME_DIR/.sge_aliases"
   }
   set file_name $path_alias_file

   ts_log_fine "testing alias file $file_name"

   # A .sav that is already there was left by a run that never reached its
   # cleanup, or belongs to one that is running right now. Both mean the
   # original file is not where this test would look for it, and carrying on
   # would delete someone else's file at the end. Stop instead and say so.
   if {[file exists "${file_name}.sav"]} {
      ts_log_severe "${file_name}.sav exists before the test started - a previous path_alias run did not clean up, or another one is running concurrently. Restore the file by hand before running this test again."
      return
   }

   if {[file isfile $file_name]} {
      ts_log_fine "moving original alias file to ${file_name}.sav"
      file rename ${file_name} ${file_name}.sav
      set path_alias_file_saved 1

      # The rename is visible on the other hosts only once NFS has caught up.
      foreach elem $ts_config(unique_arch_nodes) {
         set gone 0
         for {set i 0} {$i < 60} {incr i} {
            start_remote_prog $elem $CHECK_USER "cat" $file_name
            if {$prg_exit_state != 0} {
               set gone 1
               break
            }
            after 1000
         }
         # The old loop derived this from its counter and reported an error
         # whenever the file disappeared in the very last round.
         if {!$gone} {
            ts_log_severe "error moving file ${file_name} on host $elem"
            return
         }
      }
   }

   set index 0
   foreach host $ts_config(unique_arch_nodes) {
      set output [start_remote_prog $host $CHECK_USER "pwd" "" prg_exit_state 60 0 $ts_config(product_root)]
      set output [string trim $output]
      if { $output != $ts_config(product_root) } {
         ts_log_fine "host $host seems to have an automounter prefix! checking ... (got \"$output\"   expected \"$ts_config(product_root)\")"
         set pos [string first $ts_config(product_root) $output]
         set prefix [string range $output 0 $pos]
         ts_log_fine "automounter prefix is \"$prefix\" on host $host"
         # This is the one rule of the file that is not confined to this
         # runner's own paths: it matches "*"/"*" and rewrites every path that
         # begins with the prefix. At level 1 it therefore reaches every cluster
         # of this user for as long as the test runs. It stays because a host
         # set behind an automounter needs it to work at all - the lab has no
         # prefix, so nothing is written there in practice.
         #sge-root can be a symbolic link (the prefix can still be empty)
         if {$prefix != ""} {
            set data(src-path,$index)     "$prefix"
            set data(sub-host,$index)     "*"
            set data(exec-host,$index)    "*"
            set data(replacement,$index)  "/"
            incr index 1
         }
      }
   }

   # Everything else is keyed on this runner's own results directory, which no
   # other runner's path can match.
   set data(src-path,$index)     "$PATH_ALIAS_OUTPUT1"
   set data(sub-host,$index)     "*"
   set data(exec-host,$index)    "*"
   set data(replacement,$index)  "$PATH_ALIAS_OUTPUT2"
   incr index 1

   create_path_aliasing_file ${file_name} data $index
   set path_alias_file_created 1

   set cat_output ""
   set old_cat_output ""
   set cat_hostname ""
   set last_host ""
   foreach elem $ts_config(unique_arch_nodes) {
      set counter 60
      while {$counter > 0} {
         set result [start_remote_prog $elem $CHECK_USER "cat" $file_name]
         incr counter -1
         if {$prg_exit_state == 0} {
            break;
         }
         after 1000
      }
      if {$prg_exit_state != 0} {
         ts_log_severe "error reading file ${file_name} on host $elem"
      }
      lappend cat_hostname $elem
      lappend cat_output $result
      set last_host $elem
   }

   set elem_nr 0
   set orig [open "$CHECK_PROTOCOL_DIR/test1.txt" "w"]
   puts $orig $result
   close $orig
   foreach elem $cat_output {
       set diff [open "$CHECK_PROTOCOL_DIR/test2.txt" "w"]
       puts $diff $elem
       close $diff

       set catch_return [ catch { eval exec "diff -w $CHECK_PROTOCOL_DIR/test1.txt $CHECK_PROTOCOL_DIR/test2.txt" } diff_output ]
       if { $catch_return != 0 } {
          ts_log_severe "error compareing output of cat command:\n$diff_output"
       }
   }

   delete_file "$CHECK_PROTOCOL_DIR/test1.txt"
   delete_file "$CHECK_PROTOCOL_DIR/test2.txt"
}

proc path_alias_main {} {
   global ts_config
   global path_alias_test
   global PATH_ALIAS_OUTPUT1
   global PATH_ALIAS_OUTPUT2
   global CHECK_DISPLAY_OUTPUT
   global CHECK_USER

   # The qsh below opens an xterm. Without a display it fails, no output file is
   # written and the test reports a wrong file count - which says nothing about
   # path aliasing. check_needs pulls in display_test, so a missing display here
   # is a configuration problem, not a product defect.
   if {$CHECK_DISPLAY_OUTPUT == "undefined"} {
      ts_log_config "no DISPLAY configured - path_alias needs one for its qsh submission"
      return
   }

   set files1_old [start_remote_prog $ts_config(master_host) $CHECK_USER "ls" "$PATH_ALIAS_OUTPUT1"]
   set files2_old [start_remote_prog $ts_config(master_host) $CHECK_USER "ls" "$PATH_ALIAS_OUTPUT2"]

   set job_script "$ts_config(product_root)/examples/jobs/sleeper.sh 10"
   foreach elem $ts_config(unique_arch_nodes) {
      ts_log_fine "submitting job(s) for host $elem"

      ts_log_fine "qsub $elem ..."
      set args     "-cwd -l h=${elem} $job_script"
      ts_log_fine "qsub $args"
      start_sge_bin "qsub" $args $elem $CHECK_USER prg_exit_state 60 $PATH_ALIAS_OUTPUT1

      ts_log_fine "qrsh $elem ..."

      set args "-cwd -l h=${elem} \"pwd\""
      ts_log_fine "qrsh $args"
      set output [start_remote_prog $elem $CHECK_USER "qrsh" $args prg_exit_state 60 0 $PATH_ALIAS_OUTPUT1]
      if { ![qrsh_output_contains $output $PATH_ALIAS_OUTPUT2] } {
         ts_log_severe "host: $elem\nqrsh -cwd directory is\n\"$output\"\n instead of \n\"$PATH_ALIAS_OUTPUT2\""
      }

      ts_log_fine "qsh $elem ..."
      set pwd_script "$PATH_ALIAS_OUTPUT1/global_pwdscript_$elem.sh"
      set command     "> qsh_pwd_output_$elem.txt ; sleep 10"
      create_shell_script $pwd_script $elem "pwd" "$command " "" "" "/bin/sh" 0 1 1 1

      #This job needs a DISPLAY
      set args "-v DISPLAY=$CHECK_DISPLAY_OUTPUT -cwd -l h=${elem} -- -e $pwd_script"
      ts_log_fine "qsh $args"
      set output [start_remote_prog $elem $CHECK_USER "qsh" $args prg_exit_state 60 0 $PATH_ALIAS_OUTPUT1]
      ts_log_fine $output
   }

   wait_for_end_of_all_jobs 100

   set nr_hosts [ llength $ts_config(unique_arch_nodes)]

   # The job output appears in the directories when NFS has caught up, not when
   # the job ends. A fixed "after 10000" was enough on a host set the run had to
   # itself and is not under 32 clusters. Poll for the expected counts instead,
   # and let ts_scale_timeout stretch the limit the way it stretches every other
   # wait of the run (CS-2481). Waiting for "at least" leaves the assertions
   # below intact - too many files is still an error, it is just no longer
   # decided before the files are there.
   set want1 [expr {[llength $files1_old] + $nr_hosts}]
   set want2 [expr {[llength $files2_old] + $nr_hosts * 3}]
   set deadline [expr {[clock seconds] + [ts_scale_timeout 120]}]
   while {1} {
      set files1 [start_remote_prog $ts_config(master_host) $CHECK_USER "ls" "$PATH_ALIAS_OUTPUT1"]
      set files2 [start_remote_prog $ts_config(master_host) $CHECK_USER "ls" "$PATH_ALIAS_OUTPUT2"]
      if {[llength $files1] >= $want1 && [llength $files2] >= $want2} {
         break
      }
      if {[clock seconds] >= $deadline} {
         ts_log_fine "job output did not become visible within the timeout"
         break
      }
      after 2000
   }

   set nr_new_files1 [ expr ([llength $files1] - [llength $files1_old]) ]
   set nr_new_files2 [ expr ([llength $files2] - [llength $files2_old]) ]

   ts_log_fine "files1: $nr_new_files1"
   ts_log_fine "files2: $nr_new_files2"
   ts_log_fine "nr_hosts: $nr_hosts"

   if { $nr_new_files1 != $nr_hosts } {
      ts_log_severe "there are $nr_new_files1 new files in directory $PATH_ALIAS_OUTPUT1, should be $nr_hosts (case 1)"
   }

   set nr_hosts_x2 [ expr ( $nr_hosts * 3 ) ]
   if { $nr_new_files2 != $nr_hosts_x2 } {
      ts_log_severe "there are $nr_new_files2 new files in directory $PATH_ALIAS_OUTPUT2, should be $nr_hosts_x2 (case 2)"
   }

   foreach elem $files1 {
      #ts_log_fine "deleting $elem"
      file delete $PATH_ALIAS_OUTPUT1/$elem
   }
   foreach elem $files2 {
      #ts_log_fine "deleting $elem"
      file delete $PATH_ALIAS_OUTPUT2/$elem
   }
}

proc path_alias_cleanup_level {} {
   global PATH_ALIAS_OUTPUT1
   global PATH_ALIAS_OUTPUT2
   global path_alias_file path_alias_file_created path_alias_file_saved

   delete_all_jobs
   wait_for_end_of_all_jobs 60

   foreach dir [list $PATH_ALIAS_OUTPUT1 $PATH_ALIAS_OUTPUT2] {
      ts_log_fine "deleting directory: $dir"
      # -force: after a failed run the job output is still in there, and a plain
      # "file delete" fails on a non empty directory. The test then reported the
      # leftover instead of the defect that produced it.
      catch { file delete -force $dir }
      if { [ file isdirectory $dir ] == 1 } {
         ts_log_severe "could not delete directory $dir"
      }
   }

   # Remove only what setup_level created, restore only what it moved aside.
   # The old code deleted the alias file unconditionally, which took out the
   # user's own $HOME/.sge_aliases whenever a concurrent run had already put it
   # back - see CS-707 and the note at the top of this file.
   if {$path_alias_file_created} {
      ts_log_fine "deleting $path_alias_file"
      file delete $path_alias_file
      set path_alias_file_created 0
      if { [ file isfile $path_alias_file ] == 1 } {
         ts_log_severe "could not delete file $path_alias_file"
         return
      }
   }

   if {$path_alias_file_saved} {
      ts_log_fine "restoring original alias file $path_alias_file"
      file rename -force "${path_alias_file}.sav" $path_alias_file
      set path_alias_file_saved 0
   }
}

