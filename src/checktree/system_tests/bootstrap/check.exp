# Define the global variables to give them back
global check_name check_description check_needs check_functions
global check_category
global check_root_access_needs check_need_running_system
global check_version_range

set check_root_access_needs   "no"

# communication_params and the test binary this check drives arrive with 9.1.5
set check_version_range       "9.1.5"

set check_name                "bootstrap_parsing"
set check_category            "BOOTSTRAP VERIFIED"
set check_description(0)      "the bootstrap file is parsed as expected"
set check_needs               "init_core_system"

# setup and cleanup functions
set check_setup_function      "bootstrap_parsing_setup"
set check_cleanup_function    "bootstrap_parsing_cleanup"

# define test's procedure order
#
# One function per attribute, each with a case which has to be accepted and one which
# has to be refused or fall back to a default. The attributes which are only stored as
# they are read share one function - they have nothing to tell apart, and a message
# names the attribute it failed on.
set check_functions           {}
lappend check_functions       "bootstrap_parsing_communication_params"
lappend check_functions       "bootstrap_parsing_address_format"
lappend check_functions       "bootstrap_parsing_admin_user"
lappend check_functions       "bootstrap_parsing_default_domain"
lappend check_functions       "bootstrap_parsing_ignore_fqdn"
lappend check_functions       "bootstrap_parsing_stored_attributes"
lappend check_functions       "bootstrap_parsing_security_mode"
lappend check_functions       "bootstrap_parsing_security_params"
lappend check_functions       "bootstrap_parsing_thread_counts"

##
# @brief Prepare a place where generated bootstrap files can be read from.
#
# The bootstrap file cannot be handed to the test binary as a path. Its location is
# derived as $SGE_ROOT/$SGE_CELL/common/bootstrap and both directories have to exist,
# so the check builds a directory that looks like an installation and points the
# binary at it. Only the bootstrap file inside it is ever read.
#
# The bootstrap file of the running cluster serves as the template. Working from it
# rather than from a file written here keeps the cases about the attribute under test
# instead of about whatever else a hand-written file happens to get wrong.
proc bootstrap_parsing_setup {} {
   get_current_cluster_config_array ts_config
   global CHECK_USER
   global bootstrap_parsing_host bootstrap_parsing_root
   global bootstrap_parsing_template bootstrap_parsing_case

   set bootstrap_parsing_host $ts_config(master_host)

   # the binary is installed with the cluster, an installation without it cannot
   # run this check
   set test_bin [get_test_path "test_uti_bootstrap" $bootstrap_parsing_host]
   if {![is_remote_file $bootstrap_parsing_host $CHECK_USER $test_bin]} {
      ts_log_config "test requires the test binary $test_bin"
      return 99
   }

   # read the bootstrap file of the running cluster - it is the template every case
   # starts from
   set template_file "$ts_config(product_root)/$ts_config(cell)/common/bootstrap"
   # get_file_content reports a failure itself, this only stops the check from
   # carrying on with an empty template
   get_file_content $bootstrap_parsing_host $CHECK_USER $template_file file_array
   if {$file_array(0) <= 0} {
      ts_log_fine "no content in the bootstrap file $template_file"
      return 99
   }

   set bootstrap_parsing_template {}
   for {set i 1} {$i <= $file_array(0)} {incr i} {
      lappend bootstrap_parsing_template $file_array($i)
   }

   # the directory lands below the testsuite results directory, which every host
   # reaches, so a file is written once here and read there
   set bootstrap_parsing_root [get_tmp_directory_name $bootstrap_parsing_host]
   set bootstrap_parsing_case 0

   return 0
}

proc bootstrap_parsing_cleanup {} {
   get_current_cluster_config_array ts_config
   global bootstrap_parsing_host bootstrap_parsing_root
   global bootstrap_parsing_template bootstrap_parsing_case

   # the temporary directory is not removed here, the testsuite cleans up the
   # temporary files and directories it handed out

   unset -nocomplain bootstrap_parsing_host bootstrap_parsing_root
   unset -nocomplain bootstrap_parsing_template
   unset -nocomplain bootstrap_parsing_case
}

##
# @brief Write a bootstrap file built from the template and read it back.
#
# The template lines are copied over, except that a line naming one of the attributes
# in a_replace is replaced by the value given there, and an attribute named there but
# absent from the template is appended. An empty value drops the attribute, which is
# how a case for a missing attribute is built.
#
# @param a_replace  name of an array, attribute name to whole replacement line
# @param a_out      name of an array which receives the parsed key/value pairs
# @param a_exit     name of a variable which receives the exit status
# @return the output of the run, stdout and stderr together
proc bootstrap_parsing_run {a_replace a_out a_exit} {
   get_current_cluster_config_array ts_config
   global CHECK_USER
   global bootstrap_parsing_host bootstrap_parsing_root
   global bootstrap_parsing_template bootstrap_parsing_case

   upvar $a_replace replace
   upvar $a_out parsed
   upvar $a_exit exit_state

   # build the file: keep every line, swap the ones we were asked to swap
   set seen {}
   set content(0) 0
   foreach line $bootstrap_parsing_template {
      set attribute [lindex [split [string trim $line]] 0]
      if {[info exists replace($attribute)]} {
         lappend seen $attribute
         if {$replace($attribute) == ""} {
            continue
         }
         set line $replace($attribute)
      }
      incr content(0)
      set content($content(0)) $line
   }
   foreach attribute [array names replace] {
      if {[lsearch -exact $seen $attribute] < 0 && $replace($attribute) != ""} {
         incr content(0)
         set content($content(0)) $replace($attribute)
      }
   }

   # Every case becomes a cell of its own below one SGE_ROOT. That gives each case a
   # path nothing has written before - re-using one would leave the wait below with
   # nothing to wait for and the other host could still be served the previous
   # content - and it puts a cell name other than the usual "default" through the
   # path construction on the way.
   incr bootstrap_parsing_case
   set cell "case_$bootstrap_parsing_case"
   set bootstrap_file "$bootstrap_parsing_root/$cell/common/bootstrap"
   file mkdir "$bootstrap_parsing_root/$cell/common"
   save_file $bootstrap_file content

   # written here, read on the other host - wait until it is actually visible there
   if {[wait_for_remote_file $bootstrap_parsing_host $CHECK_USER $bootstrap_file] != 0} {
      ts_log_severe "the generated bootstrap file did not appear on\
                     $bootstrap_parsing_host"
      set exit_state -1
      return ""
   }

   set envlist(SGE_ROOT) $bootstrap_parsing_root
   set envlist(SGE_CELL) $cell
   set output [start_test_bin "test_uti_bootstrap" "" $bootstrap_parsing_host \
                              $CHECK_USER exit_state 60 envlist]

   # The binary writes one key=value line per attribute it parsed. Log output arrives
   # on the same channel and may itself contain an equals sign - the warning about an
   # unknown parameter quotes the parameter, for one - so only a line that is nothing
   # but an attribute name, an equals sign and a value is taken as a value.
   array unset parsed
   foreach line [split $output "\n"] {
      if {[regexp {^([a-z_]+)=(.*)$} [string trim $line] match key value]} {
         set parsed($key) $value
      }
   }

   return $output
}

##
# @brief Run one case which has to be accepted and check the values it printed.
#
# @param a_replace  attribute name to whole replacement line, as for the run above
# @param a_expect   printed key to the value it has to have
# @param what       what the case is about, for the messages
proc bootstrap_parsing_expect {a_replace a_expect what} {
   upvar $a_replace replace
   upvar $a_expect expect

   set output [bootstrap_parsing_run replace parsed exit_state]
   if {$exit_state != 0} {
      ts_log_severe "reading a bootstrap file with $what failed:\n$output"
      return
   }

   foreach key [array names expect] {
      if {![info exists parsed($key)]} {
         ts_log_severe "the test binary printed no $key with $what:\n$output"
      } elseif {$parsed($key) != $expect($key)} {
         ts_log_severe "$key is \"$parsed($key)\" with $what, expected\
                        \"$expect($key)\":\n$output"
      }
   }
}

##
# @brief Drop a required attribute and expect the file to be refused for it.
#
# The refusal has to name the attribute. A file missing one attribute is easy to get
# wrong in another way as well, and an assertion on the exit status alone would not
# notice the difference.
#
# @param attribute  the attribute to leave out
proc bootstrap_parsing_expect_required {attribute} {
   set replace($attribute) ""

   set output [bootstrap_parsing_run replace parsed exit_state]
   if {$exit_state == 0} {
      ts_log_severe "a bootstrap file without the required attribute $attribute was\
                     read successfully:\n$output"
   } elseif {[string first "cannot read attribute <$attribute>" $output] < 0} {
      ts_log_severe "a bootstrap file without $attribute was refused, but not for\
                     that reason:\n$output"
   }
}

##
# @brief admin_user is taken as it is written.
proc bootstrap_parsing_admin_user {} {
   set replace(admin_user) "admin_user sgetest"
   set expect(admin_user) "sgetest"
   bootstrap_parsing_expect replace expect "admin_user sgetest"
   array unset replace
   array unset expect

   # "none" means the daemons run as root, and it reaches the caller as the string it
   # is rather than as an empty value
   set replace(admin_user) "admin_user none"
   set expect(admin_user) "none"
   bootstrap_parsing_expect replace expect "admin_user none"
   array unset replace
   array unset expect

   bootstrap_parsing_expect_required "admin_user"
}

##
# @brief default_domain is a name, and "none" means there is none.
#
# The attribute is read into two values: the domain itself, and whether one is set at
# all. The second is what the resolving code asks, so a case which only looked at the
# string would miss the answer that matters.
proc bootstrap_parsing_default_domain {} {
   set replace(default_domain) "default_domain example.com"
   set expect(default_domain) "example.com"
   set expect(has_default_domain) "true"
   bootstrap_parsing_expect replace expect "default_domain example.com"
   array unset replace
   array unset expect

   set replace(default_domain) "default_domain none"
   set expect(default_domain) "none"
   set expect(has_default_domain) "false"
   bootstrap_parsing_expect replace expect "default_domain none"
   array unset replace
   array unset expect

   # the spelling of "none" is not significant
   set replace(default_domain) "default_domain NONE"
   set expect(has_default_domain) "false"
   bootstrap_parsing_expect replace expect "default_domain NONE"
   array unset replace
   array unset expect

   bootstrap_parsing_expect_required "default_domain"
}

##
# @brief ignore_fqdn is a boolean, written as a word or as a number.
proc bootstrap_parsing_ignore_fqdn {} {
   foreach {value expected} {true true false false 1 true 0 false TRUE true} {
      set replace(ignore_fqdn) "ignore_fqdn $value"
      set expect(ignore_fqdn) $expected
      bootstrap_parsing_expect replace expect "ignore_fqdn $value"
      array unset replace
      array unset expect
   }

   bootstrap_parsing_expect_required "ignore_fqdn"
}

##
# @brief The attributes which are handed on as they are read.
#
# Nothing is derived from them here, so what is asserted is that the value arrives
# whole and lands under the right name - the file is read by position into an array,
# and a mistake there shows up as one attribute carrying another's value.
#
# spooling_params is the one with something to say: a postgres connection string
# carries spaces between its key=value pairs, and a reader tokenizing on whitespace
# would keep the first pair and drop the rest.
proc bootstrap_parsing_stored_attributes {} {
   set values(spooling_method) "berkeleydb"
   set values(spooling_lib) "libspoolb"
   set values(spooling_params) "host=dbhost port=5432 dbname=sge user=sgeadmin"
   set values(binary_path) "/opt/testsuite/bin"
   set values(qmaster_spool_dir) "/opt/testsuite/spool/qmaster"

   foreach attribute [array names values] {
      set replace($attribute) "$attribute $values($attribute)"
      set expect($attribute) $values($attribute)
      bootstrap_parsing_expect replace expect "$attribute $values($attribute)"
      array unset replace
      array unset expect

      bootstrap_parsing_expect_required $attribute
   }
}

##
# @brief security_mode names the modes which are switched on.
#
# The value is a list, and what comes back is the set of modes which were recognised,
# in the order the product numbers them rather than in the order they were written.
#
# The case which matters is the one nobody wants to be wrong about: a mode which is
# not recognised must not switch anything on. An administrator who misspells a mode
# is told nothing today, so the file reads as if it had asked for no mode at all -
# that is what the last case pins down.
proc bootstrap_parsing_security_mode {} {
   set replace(security_mode) "security_mode none"
   set expect(security_modes) "NONE"
   bootstrap_parsing_expect replace expect "security_mode none"
   array unset replace
   array unset expect

   set replace(security_mode) "security_mode munge"
   set expect(security_modes) "munge"
   bootstrap_parsing_expect replace expect "security_mode munge"
   array unset replace
   array unset expect

   # written the other way round, and it comes back in the product's own order
   set replace(security_mode) "security_mode munge,tls"
   set expect(security_modes) "tls,munge"
   bootstrap_parsing_expect replace expect "security_mode munge,tls"
   array unset replace
   array unset expect

   set replace(security_mode) "security_mode mnuge"
   set expect(security_modes) "NONE"
   bootstrap_parsing_expect replace expect "a misspelled security_mode"
   array unset replace
   array unset expect

   bootstrap_parsing_expect_required "security_mode"
}

##
# @brief security_params carries the certificate times, within bounds.
#
# Both values are held between a minimum and a maximum instead of being refused, so a
# value outside the range is not an error but a different value, and a case has to
# assert which one it became.
proc bootstrap_parsing_security_params {} {
   set replace(security_params) \
      "security_params certificate_lifetime=3600,certificate_start_offset=-60"
   set expect(certificate_lifetime) "3600"
   set expect(certificate_start_offset) "-60"
   bootstrap_parsing_expect replace expect "certificate times inside the range"
   array unset replace
   array unset expect

   # below the minimum lifetime and below the earliest start offset
   set replace(security_params) \
      "security_params certificate_lifetime=60,certificate_start_offset=-9999"
   set expect(certificate_lifetime) "120"
   set expect(certificate_start_offset) "-300"
   bootstrap_parsing_expect replace expect "certificate times below the range"
   array unset replace
   array unset expect

   # an offset into the future is not allowed, the latest one is the moment itself
   set replace(security_params) "security_params certificate_start_offset=3600"
   set expect(certificate_start_offset) "0"
   bootstrap_parsing_expect replace expect "a certificate start offset in the future"
   array unset replace
   array unset expect

   # security_params is optional, and an entry nobody knows leaves the defaults alone
   foreach {line what} {"" "no security_params"
                        "security_params certificate_lifespan=3600"
                        "an unknown security_params entry"} {
      set replace(security_params) $line
      set expect(certificate_lifetime) "31536000"
      set expect(certificate_start_offset) "-10"
      bootstrap_parsing_expect replace expect $what
      array unset replace
      array unset expect
   }
}

##
# @brief The thread counts fall back to a default and are held below a maximum.
#
# None of them is required and none of them is refused: a count which cannot be used
# becomes the default, and one above the maximum becomes the maximum. The maximum is
# not a matter of taste - the locking of the thread pools breaks down above it - so
# the case for a count over it is the one worth having.
proc bootstrap_parsing_thread_counts {} {
   foreach attribute {listener_threads worker_threads reader_threads} {
      foreach {value expected what} {8   8  "set to 8"
                                     100 32 "above the maximum"
                                     0   4  "set to zero"
                                     ""  4  "absent"} {
         if {$value == ""} {
            set replace($attribute) ""
         } else {
            set replace($attribute) "$attribute $value"
         }
         set expect($attribute) $expected
         bootstrap_parsing_expect replace expect "$attribute $what"
         array unset replace
         array unset expect
      }
   }

   # the scheduler is the one thread there can only be one of
   foreach {value expected} {1 1 5 1} {
      set replace(scheduler_threads) "scheduler_threads $value"
      set expect(scheduler_threads) $expected
      bootstrap_parsing_expect replace expect "scheduler_threads $value"
      array unset replace
      array unset expect
   }
}

##
# @brief communication_params is parsed, and a wrong entry is reported.
#
# Both parameters relax a check on incoming connections, so the case that matters most
# is the one where an administrator believes a parameter is in effect and it is not.
# A misspelled entry has to be reported rather than passed over, which is what the
# negative case below asserts.
proc bootstrap_parsing_communication_params {} {
   get_current_cluster_config_array ts_config

   # both parameters set
   set replace(communication_params) \
      "communication_params address_from_hostname=ip-%d-%d-%d-%d,trust_client_hostname=true"
   set output [bootstrap_parsing_run replace parsed exit_state]
   if {$exit_state != 0} {
      ts_log_severe "reading a bootstrap file with communication_params failed:\n$output"
   } elseif {$parsed(address_from_hostname) != "ip-%d-%d-%d-%d"} {
      ts_log_severe "address_from_hostname is\
                     \"$parsed(address_from_hostname)\", expected\
                     \"ip-%d-%d-%d-%d\":\n$output"
   } elseif {$parsed(trust_client_hostname) != "true"} {
      ts_log_severe "trust_client_hostname is \"$parsed(trust_client_hostname)\",\
                     expected \"true\":\n$output"
   }
   array unset replace
   array unset parsed

   # no communication_params at all - the defaults apply and nothing is reported
   set replace(communication_params) ""
   set output [bootstrap_parsing_run replace parsed exit_state]
   if {$exit_state != 0} {
      ts_log_severe "reading a bootstrap file without communication_params failed:\n$output"
   } elseif {$parsed(address_from_hostname) != ""} {
      ts_log_severe "address_from_hostname is \"$parsed(address_from_hostname)\"\
                     without communication_params, expected it to be unset:\n$output"
   } elseif {$parsed(trust_client_hostname) != "false"} {
      ts_log_severe "trust_client_hostname is \"$parsed(trust_client_hostname)\"\
                     without communication_params, expected \"false\":\n$output"
   } elseif {[string first "unknown parameter" $output] >= 0} {
      ts_log_severe "a bootstrap file without communication_params was reported\
                     as having an unknown parameter:\n$output"
   }
   array unset replace
   array unset parsed

   # a misspelled parameter is reported and leaves the default in place
   set replace(communication_params) \
      "communication_params trust_clientname=true"
   set output [bootstrap_parsing_run replace parsed exit_state]
   if {$exit_state != 0} {
      ts_log_severe "a bootstrap file with an unknown communication_params entry\
                     must still be usable:\n$output"
   } elseif {[string first "unknown parameter" $output] < 0} {
      ts_log_severe "an unknown communication_params entry was not reported:\n$output"
   } elseif {$parsed(trust_client_hostname) != "false"} {
      ts_log_severe "trust_client_hostname is \"$parsed(trust_client_hostname)\"\
                     after a misspelled entry, expected the default \"false\":\n$output"
   }
   array unset replace
   array unset parsed
}

##
# @brief Only a format which can yield an IPv4 address is accepted.
#
# The format is handed to snprintf when a host name is built from an address, so what
# is let through here decides what that call is given. Four placeholders and nothing
# else: a format with any other count cannot fill an address, and any other conversion
# would be one nobody accounted for.
#
# A refused format leaves the attribute unset, which means host names keep being
# resolved the usual way rather than through a format that half works.
proc bootstrap_parsing_address_format {} {
   get_current_cluster_config_array ts_config

   # formats which have to be accepted - the separator is not fixed
   foreach format {"ip-%d-%d-%d-%d" "node%d_%d_%d_%d.local" "%d.%d.%d.%d"} {
      set replace(communication_params) "communication_params address_from_hostname=$format"
      set output [bootstrap_parsing_run replace parsed exit_state]
      if {$exit_state != 0} {
         ts_log_severe "reading a bootstrap file with address_from_hostname=$format\
                        failed:\n$output"
      } elseif {$parsed(address_from_hostname) != $format} {
         ts_log_severe "address_from_hostname is \"$parsed(address_from_hostname)\",\
                        expected \"$format\":\n$output"
      }
      array unset replace
      array unset parsed
   }

   # formats which have to be refused: too few and too many placeholders, a conversion
   # which is not a placeholder, and one smuggled in behind four good ones
   foreach format {"ip-%d-%d-%d" "ip-%d-%d-%d-%d-%d" "ip-%d-%d-%d-%s"
                   "ip-%d-%d-%d-%d%n" "nodigits"} {
      set replace(communication_params) "communication_params address_from_hostname=$format"
      set output [bootstrap_parsing_run replace parsed exit_state]
      if {$exit_state != 0} {
         ts_log_severe "a bootstrap file with an unusable address_from_hostname must\
                        still be usable:\n$output"
      } elseif {$parsed(address_from_hostname) != ""} {
         ts_log_severe "address_from_hostname is \"$parsed(address_from_hostname)\"\
                        after the unusable format \"$format\", expected it to be\
                        unset:\n$output"
      } elseif {[string first "does not hold four" $output] < 0} {
         ts_log_severe "the unusable format \"$format\" was not reported:\n$output"
      }
      array unset replace
      array unset parsed
   }
}
