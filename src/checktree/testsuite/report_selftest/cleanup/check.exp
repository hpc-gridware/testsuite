# CS-2936: passes in every function but leaves a job in the cluster, so the
# framework's cleanup check reports an error on an otherwise green check (the
# record stream's cleanup_check, cleanup_failed after merge). It is not
# VERIFIED: no regular run selects it. Run it with TS_REPORT=1 and
# "<line>[-<feature>] test REPORT_SELFTEST", and delete the job afterwards
# (qdel -f -u '*').

global check_name
global check_category
global check_description
global check_needs
global check_functions
global check_test_cases

set check_name            "report_selftest_cleanup"
set check_category        "TESTSUITE REPORT_SELFTEST"
set check_description(0)  "report self test: green check that leaves a job behind"
set check_needs           ""

set check_functions {}
lappend check_functions "report_selftest_leave_job"

set check_test_cases(report_selftest_leave_job) {{SELF-04 covers}}

## @brief Submit a long running job and leave it in the cluster
# @return nothing
proc report_selftest_leave_job {} {
   submit_job "-b y /bin/sleep 3600"
}
