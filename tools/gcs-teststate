#!/usr/bin/env python3
"""gcs-teststate -- remember what has run since the last build.

    gcs-teststate <line> summary            what passed, failed, never ran, when it ends
    gcs-teststate <line> running            what the slots are working on right now
    gcs-teststate <line> pending            names of tests still to do
    gcs-teststate <line> passed             names of tests that passed
    gcs-teststate <line> failed             names of tests that failed
    gcs-teststate <line> reset              forget everything
    gcs-teststate <line> record <name> <ok|fail> [seconds] [slot]

Why this exists next to ctest's own bookkeeping: `--rerun-failed` reads
LastTestsFailed.log, which holds the failures of the last run that *had*
failures. A run with failures replaces that list rather than adding to it -- so
a stray failure somewhere else discards the list one was working through. It is
a snapshot, not a ledger.

What one actually wants while working through a test run is: which tests have
never run, which passed, which still fail -- and all of it invalidated the
moment the binaries change, because a result from the previous build says
nothing about this one.

The build is identified by the mtime and size of the installed sge_qmaster of
the line. That is what the runners mirror, so it is the thing that decides what
the tests are testing. When it changes, the ledger is dropped.

`pending` is meant to be fed straight back:

    gcs-teststate 92x pending > todo.txt
    ctest --test-dir <build> --tests-from-file todo.txt -j 8
"""

import os, re, sys, glob, fcntl, time

CLION_ROOT = os.environ.get("GCS_CLION_ROOT", os.path.expanduser("~/Clion"))


def paths(line):
    root = f"{CLION_ROOT}/{line}"
    return root, f"{root}/runners/teststate.tsv"


def fingerprint(line):
    """Identify the build. Empty when nothing is installed."""
    root, _ = paths(line)
    for p in glob.glob(f"{root}/inst/bin/*/sge_qmaster"):
        st = os.stat(p)
        return f"{int(st.st_mtime)}:{st.st_size}"
    return ""


def load(line):
    """Return (fingerprint, {name: (result, when, seconds, slot)}), dropping a
    ledger that belongs to an older build.

    The slot column was added later, so a row that does not carry it yields an
    empty string -- a ledger written before that keeps working instead of being
    thrown away for a cosmetic reason."""
    _, f = paths(line)
    cur = fingerprint(line)
    state, stored = {}, ""
    if os.path.isfile(f):
        for l in open(f, errors="replace"):
            p = l.rstrip("\n").split("\t")
            if p[0] == "#build":
                stored = p[1]
            elif len(p) >= 4:
                state[p[0]] = (p[1], p[2], p[3], p[4] if len(p) > 4 else "")
    if stored != cur:
        return cur, {}
    return cur, state


def save(line, cur, state):
    _, f = paths(line)
    os.makedirs(os.path.dirname(f), exist_ok=True)
    tmp = f + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(f"#build\t{cur}\n")
        for n, (r, w, s, slot) in sorted(state.items()):
            fh.write(f"{n}\t{r}\t{w}\t{s}\t{slot}\n")
    os.replace(tmp, f)


def record(line, name, result, seconds, slot=""):
    """Append one result. Locked: eight runners record concurrently.

    The slot is worth keeping: a test that fails on one cluster and passes on
    the others points at that cluster, not at the test."""
    _, f = paths(line)
    os.makedirs(os.path.dirname(f), exist_ok=True)
    lock = open(f + ".lock", "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        cur, state = load(line)
        state[name] = (result, time.strftime("%F %T"), str(seconds), slot)
        save(line, cur, state)
        write_pending(line, state)
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)


def registered(line):
    """Every ctest test name of the current checktree.

    Preferably from the list gcs-testscan writes when it generates the ctest
    definition -- that is the same moment the set is defined, so the file cannot
    disagree with what ctest knows. Only when it is missing is the checktree
    rescanned, which costs a fraction of a second but spawns a process, and this
    is called once per finished test.
    """
    root, _ = paths(line)
    cached = f"{root}/runners/lists/ctest-names.txt"
    if os.path.isfile(cached):
        return [l.strip() for l in open(cached) if l.strip()]
    import subprocess
    here = os.path.dirname(os.path.abspath(__file__))
    out = subprocess.run([f"{here}/gcs-testscan", line, "ctest-names"],
                         capture_output=True, text=True)
    return [l for l in out.stdout.split("\n") if l.strip()]


def running(line):
    """What each runner is working on right now.

    gcs-run-unit drops a marker before it starts a group and removes it when the
    group ends, so the marker is the only place that knows about a test while it
    is still running -- the ledger learns of it only afterwards. The marker also
    survives a kill on purpose (that is how an interrupted run is detected), so a
    marker whose process is gone is reported as stale rather than as running.
    """
    root, _ = paths(line)
    out = []
    for d in sorted(glob.glob(f"{root}/runners/r*"),
                    key=lambda p: int(re.sub(r"\D", "", os.path.basename(p)) or 0)):
        f = f"{d}/.unit-in-progress"
        if not os.path.isfile(f):
            continue
        raw = open(f, errors="replace").read().rstrip("\n")
        parts = raw.split("\t")
        if len(parts) >= 3:
            started, pid, name = parts[0], parts[1], parts[2]
        else:
            # Marker from a gcs-run-unit that did not record its pid yet.
            started, pid = raw[:19], ""
            # Old marker: the raw argument list. Shorten the paths to the test
            # names, so it reads like the ctest name it stands for.
            args = raw[19:].split()
            names = [os.path.basename(a) for a in args if "/" in a]
            name = "?" 
            if names:
                name = names[0] + ("+group" if len(names) > 1 else "")
        live = None                      # None = cannot tell, no pid recorded
        if pid.isdigit():
            live = os.path.exists(f"/proc/{pid}")
        try:
            secs = int(time.time() - time.mktime(time.strptime(started, "%Y-%m-%d %H:%M:%S")))
        except ValueError:
            secs = -1
        out.append((os.path.basename(d), started, secs, name or "?", live))
    return out


def rel_key(path):
    """Line independent key -- the same function gcs-testscan builds the ctest
    names from, kept here so units.tsv can be read without importing it."""
    return re.sub("^" + re.escape(CLION_ROOT) +
                  r"/(?:[^/]+-features/[^/]+|[^/]+)/", "", path, count=1)


def plan(line):
    """(planned duration per ctest name, number of slots) of the current run.

    Read from units.tsv and manifest.txt, which gcs-testscan writes next to the
    runner lists in the same moment it splits the run. They therefore describe
    exactly the schedule the running ctest is working through -- no rescan, and
    no second duration model that could drift away from the one that did the
    planning. Both missing means an ETA cannot be given, not that it is zero.
    """
    root, _ = paths(line)
    d = f"{root}/runners/lists"
    over = int(os.environ.get("GCS_TS_OVERHEAD", "48"))
    slots = 0
    if os.path.isfile(f"{d}/manifest.txt"):
        for l in open(f"{d}/manifest.txt", errors="replace"):
            k, _, v = l.partition(" ")
            v = v.strip()
            if k == "overhead" and v.split("s")[0].isdigit():
                over = int(v.split("s")[0])
            elif k == "runners" and v.isdigit():
                slots = int(v)
    dur = {}
    if os.path.isfile(f"{d}/units.tsv"):
        for l in open(f"{d}/units.tsv", errors="replace"):
            p = l.rstrip("\n").split("\t")
            # The net duration is what was measured for the test body; what a
            # slot is occupied for is that plus one invocation's setup.
            if len(p) >= 3 and p[2].isdigit():
                dur[rel_key(p[0]).replace("/", ".") + f".{p[1]}"] = int(p[2]) + over
    return dur, slots


def eta(line, never, dur, slots):
    """Seconds until the parallel phase is through, None if unknown.

    Two bounds, the larger one wins: the work still open divided by the slots,
    and the longest single unit still outstanding. Twenty-four slots whose last
    remaining unit runs 40 minutes need those 40 minutes, not the 100 seconds
    the division suggests -- that tail is exactly what the LPT split tries to
    keep short, and ignoring it reports an end that passes while the last runner
    is still working.

    A unit that is already running counts with what is left of it, taken from
    the start time in its marker. So a unit that overruns its estimate pushes
    the end out instead of silently dropping to zero.

    What this does not cover is phase 2 of gcs-testrun: how long the serial
    rerun takes depends on how many failures phase 1 ends up with, and that is
    not knowable while phase 1 runs.
    """
    known = sorted(dur.values())
    if not known:
        return None
    fallback = known[len(known) // 2]
    started = {name: secs for _, _, secs, name, live in running(line)
               if live is not False and secs >= 0}
    rest = []
    for n in never:
        d = dur.get(n, fallback)
        if n in started:
            # Never zero: a unit whose process is alive still has its teardown
            # ahead of it, however far past its estimate it is.
            d = max(d - started[n], 15)
        rest.append(d)
    if not rest:
        return 0
    return int(max(sum(rest) / max(slots or len(started) or 1, 1), max(rest)))


def write_pending(line, state):
    """Keep <line>/runners/pending.txt current.

    So that an IDE run configuration can simply point at it with
    --tests-from-file and always run what is actually still open, without a
    preparation step the IDE would have to be taught.
    """
    root, _ = paths(line)
    names = registered(line)
    never = [n for n in names if n not in state]
    failed = [n for n in names if state.get(n, ("",))[0] == "fail"]
    f = f"{root}/runners/pending.txt"
    tmp = f + ".tmp"
    with open(tmp, "w") as fh:
        fh.write("\n".join(never + failed) + ("\n" if never or failed else ""))
    os.replace(tmp, f)


def main():
    if len(sys.argv) < 3:
        sys.exit(__doc__)
    line, cmd = sys.argv[1], sys.argv[2]

    if cmd == "record":
        record(line, sys.argv[3], sys.argv[4],
               sys.argv[5] if len(sys.argv) > 5 else "0",
               sys.argv[6] if len(sys.argv) > 6 else "")
        return

    if cmd == "reset":
        _, f = paths(line)
        if os.path.isfile(f):
            os.remove(f)
        print(f"  ledger cleared ({f})")
        return

    cur, state = load(line)
    if not cur:
        sys.exit(f"  no installed binaries under {CLION_ROOT}/{line}/inst")

    all_names = registered(line)
    passed = [n for n in all_names if state.get(n, ("",))[0] == "ok"]
    failed = [n for n in all_names if state.get(n, ("",))[0] == "fail"]
    never = [n for n in all_names if n not in state]
    # Recorded but no longer registered -- a checkout removed or renamed them.
    gone = [n for n in state if n not in all_names]

    write_pending(line, state)

    if cmd == "running":
        rows = running(line)
        if not rows:
            print("  no unit in progress")
        for slot, started, secs, name, live in rows:
            mark = f"{secs//60:3d}:{secs%60:02d}" if secs >= 0 else "    ?"
            note = {True: "", False: "(stale marker, no process)  ",
                    None: "(no pid in marker)  "}[live]
            print(f"  {slot:<4} {mark}  {note}{name}")
        return
    if cmd == "pending":
        # Everything that has not passed under this build: never run first,
        # then the failures, so a run works through the unknown before
        # repeating what is already known to be broken.
        print("\n".join(never + failed))
    elif cmd == "passed":
        # With when and how long, because that is what one wants to know about a
        # test that is done: the names alone are already in the summary count.
        for n in passed:
            r, w, sec, slot = state[n]
            print(f"{sec:>6}s  {w}  {slot or '-':<4} {n}")
    elif cmd == "failed":
        print("\n".join(failed))
    elif cmd == "summary":
        tot = len(all_names)
        print(f"  line {line}, build {cur}")
        print(f"  {'passed':<12} {len(passed):5d}")
        print(f"  {'failed':<12} {len(failed):5d}")
        print(f"  {'not yet run':<12} {len(never):5d}")
        print(f"  {'registered':<12} {tot:5d}")
        if tot:
            done = len(passed) + len(failed)
            print(f"  progress     {100 * done / tot:5.1f}%")
        run = [r for r in running(line) if r[4] is not False]
        if run:
            print(f"  {'in progress':<12} {len(run):5d}")
        d, slots = plan(line)
        rem = eta(line, never, d, slots)
        if rem:
            guessed = sum(1 for n in never if n not in d)
            note = f", {guessed} without a planned duration" if guessed else ""
            print(f"  {'eta':<12} {time.strftime('%H:%M', time.localtime(time.time() + rem)):>5}"
                  f"  in {rem // 3600}h{rem // 60 % 60:02d}m"
                  f"  ({slots or len(run)} slots{note}, parallel phase only)")
        if gone:
            print(f"  {len(gone)} recorded test(s) are no longer registered")
        if failed:
            print("\n  failed:")
            for n in failed:
                r, w, s, slot = state[n]
                print(f"    {s:>6}s  {w}  {slot or '-':<4} {n}")
    else:
        sys.exit(f"unknown command: {cmd}")


if __name__ == "__main__":
    main()
