#!/usr/bin/env bash
#
# gcs-feature-workspace — materialize one shared multi-repo view per feature.
#
# For a GCS release line (91x, 92x, ...) this creates ONE directory containing a
# git worktree for every repo in that line, all on the SAME feature branch
# (gcs-<line>/<feature>). Everything a cross-repo feature touches then lives in a
# single tree -> one build, one integration test, no cherry-picking. Teardown
# removes all worktrees + branches deterministically (hermes kanban gc never
# reaps worktrees, so teardown must live here), plus the cluster tree the
# workspace owns under /usr/local/testsuite/<port>.
#
# It is NOT a new git feature: just a thin orchestration wrapper around
# `git worktree add/remove/prune` across N repos with a unified branch name.
#
# Usage:
#   gcs-feature-workspace create   <line> <feature>
#   gcs-feature-workspace ts-init  <line> <feature> [port] [--force]
#   gcs-feature-workspace ide-init <line> <feature> [--force]
#   gcs-feature-workspace teardown <line> <feature> [--force] [--ignore-running]
#   gcs-feature-workspace list     [<line>]
#   gcs-feature-workspace path     <line> <feature>
#   gcs-feature-workspace repos    <line>
#
# Nothing is hardcoded per line: repos are DISCOVERED by scanning
# ${GCS_CLION_ROOT:-~/Clion}/<line>/* for git repos, base branch is taken
# per-repo from its current HEAD. Add a 92x line and it works with no edit.
#
# Optional override: a `.gcs-line` file in the line root lists repo dir names
# (one per line, '#' comments allowed) to restrict/order the repo set.
#
# ts-init makes a workspace runnable as its OWN testsuite cluster: it creates the
# non-repo siblings (config/ inst/ pkg/ html/ results/), copies the line's TS
# config to defaults-<line>-<feature>.sav with every path repointed at the
# workspace and every port moved to a free port pair, and writes a pipeline
# script named <line>-<feature> next to it. Ports are NOT invented: the lowest
# free even port from <user>,portlist in the testsuite user configuration is
# used, because that file is what vends the per-user/port gid_range. Register
# more ports there (testsuite menu -> user config) to get more parallel
# clusters. Idempotent: existing files are kept unless --force is passed.
#
# ide-init copies the line's CLion project (.idea/) into the workspace and
# repoints every absolute <line-root> path inside it (e.g. CMAKE_INSTALL_PREFIX)
# at the workspace, so a feature build never writes into the line's own inst/.
# Opening it with the right env (so debug runs of sge_qmaster/sge_execd, which
# just inherit the parent env via PASS_PARENT_ENVS_2, see the feature's own
# port/SGE_ROOT) is handled by the pipeline script's own `clion` action
# (<line>-<feature> clion), not by a separate launcher here. Idempotent like
# ide-init: existing .idea is left alone unless --force.
#
# teardown removes the workspace's cluster tree (/usr/local/testsuite/<port>:
# the CMake build directory and the cluster spool) as soon as every worktree
# came out cleanly -- it is created outside the workspace, so nothing else
# would ever reap it, and a surviving build/CMakeCache.txt breaks the next
# workspace that pick_port hands the freed port to. Skipped, with the path
# named, while the cluster is still listening or another config claims the
# port. --force additionally discards dirty worktrees, unmerged branches AND
# the whole workspace directory including config/, inst/ and results/.

set -euo pipefail

CLION_ROOT="${GCS_CLION_ROOT:-$HOME/Clion}"

# Everything derived from this lands in symlinks, generated wrappers and .sav
# files that OTHER hosts read: the cluster hosts mount the home as /home/<user>
# and have no /export/home at all, which is what $HOME expands to on the server.
# A path written in the server's spelling is a dangling link everywhere else --
# that is how <line>-<feature> on PATH came to resolve only on server-00.
# /home is the spelling that holds on every host, and it is what the .sav files
# have always carried; fold onto it once, here, rather than at each use.
case "$CLION_ROOT" in /export/home/*) CLION_ROOT="/home${CLION_ROOT#/export/home}" ;; esac
# Follow symlinks: these tools are put on PATH as links, and they call each
# other via SCRIPT_DIR -- which has to be the checkout, not the link farm.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# The .sav files and CLION_ROOT do not agree on how the home is spelled: a
# configuration says /home/<user>/..., CLION_ROOT is built from $HOME and on the
# server that expands to /export/home/<user>/... . Anything that compares or
# substitutes whole paths has to fold them onto one spelling first, or it
# silently matches nothing.
home_form() {
  case "$1" in
    /export/home/*) printf '%s' "/home${1#/export/home}" ;;
    *)              printf '%s' "$1" ;;
  esac
}

# Where a tree, and where a leaf of it, belongs in this lab segment. gcs-segment
# is the single source of truth for that -- the same helper gcs-pipeline,
# gcs-runners and the python tools ask. Its absence degrades to the path itself,
# which is exactly segment A's own answer.
seg_map() {
  local d
  d="$("$SCRIPT_DIR/gcs-segment" map "$1" 2>/dev/null)" || d=""
  [ -n "$d" ] || d="$1"
  printf '%s' "$d"
}
seg_leaf() {
  local d
  d="$("$SCRIPT_DIR/gcs-segment" "$1" "$2" 2>/dev/null)" || d=""
  [ -n "$d" ] || d="$2/$1"
  printf '%s' "$d"
}

# The sed -E expressions that repoint every absolute path of <from> at <to>, in
# every spelling a generated file can carry. One argument per line, for mapfile.
#
# With the $HOME spelling alone this matched NOTHING on segment B. A .sav says
# /home/<user>/... for the source trees and /scratch/... for product_root and
# results_dir; a CLion project says /home/<user>/... too -- while CLION_ROOT
# expands to /export/home/<user>/... . A workspace therefore inherited the
# line's source_dir, product_root and results_dir unchanged and would have
# installed over the line's own cluster.
#
# One expression per spelling would be wrong rather than merely redundant:
# /export/home/X contains /home/X, so a second expression rewrites what the
# first produced and yields .../92x-features/f-features/f. The optional
# (/export) group takes both home spellings in ONE substitution; /scratch
# overlaps with neither and gets an expression of its own.
repoint_args() {
  local from="$1" to="$2" h_f h_t s_f s_t
  h_f="$(home_form "$from")"; h_t="$(home_form "$to")"
  s_f="$(seg_map "$h_f")";    s_t="$(seg_map "$h_t")"
  printf '%s\n' "-e" "s|(/export)?$h_f|\\1$h_t|g"
  if [ "$s_f" != "$h_f" ]; then printf '%s\n' "-e" "s|$s_f|$s_t|g"; fi
}

die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'warn:  %s\n' "$*" >&2; }
info() { printf '%s\n' "$*" >&2; }

usage() {
  sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0" >&2
  exit "${1:-0}"
}

# --- validation helpers ------------------------------------------------------

valid_name() {
  # feature / line names: no empty, no slash-navigation, no leading dash
  case "$1" in
    ""|-*|*..*) return 1 ;;
    */*)        [ "$2" = "allow-slash" ] || return 1 ;;
  esac
  return 0
}

line_root() {
  local line="$1"
  valid_name "$line" || die "invalid line name: '$line'"
  printf '%s/%s' "$CLION_ROOT" "$line"
}

feature_root() {
  local line="$1" feature="$2"
  valid_name "$feature" || die "invalid feature name: '$feature'"
  printf '%s/%s-features/%s' "$CLION_ROOT" "$line" "$feature"
}

branch_name() {
  printf 'gcs-%s/%s' "$1" "$2"
}

# Release version a line name stands for: 90x -> 9.0.x, 91x -> 9.1.x, ...
# Used for the CLion project name so open windows are tellable apart. Falls
# back to the raw line name for anything that is not the <major><minor>x form.
line_version() {
  case "$1" in
    [0-9][0-9]x) printf '%s.%s.x' "$(printf '%s' "$1" | cut -c1)" "$(printf '%s' "$1" | cut -c2)" ;;
    *)           printf '%s' "$1" ;;
  esac
}

# Discover repos of a line. Honors an optional .gcs-line manifest.
# Prints one absolute repo path per line.
discover_repos() {
  local line="$1" lroot d name
  lroot="$(line_root "$line")"
  [ -d "$lroot" ] || die "line root does not exist: $lroot"

  if [ -f "$lroot/.gcs-line" ]; then
    while IFS= read -r name; do
      name="${name%%#*}"; name="${name#"${name%%[![:space:]]*}"}"; name="${name%"${name##*[![:space:]]}"}"
      [ -n "$name" ] || continue
      d="$lroot/$name"
      [ -e "$d/.git" ] || { warn "manifest repo missing or not a git repo: $name"; continue; }
      printf '%s\n' "$d"
    done < "$lroot/.gcs-line"
    return
  fi

  for d in "$lroot"/*/; do
    d="${d%/}"
    [ -e "$d/.git" ] || continue          # only real git repos (skip config/results/...)
    printf '%s\n' "$d"
  done
}

# --- commands ----------------------------------------------------------------

cmd_repos() {
  local line="${1:?line required}"
  discover_repos "$line"
}

cmd_create() {
  local line="${1:?line required}" feature="${2:?feature required}"
  local froot branch src target created=0 skipped=0 failed=0
  froot="$(feature_root "$line" "$feature")"
  branch="$(branch_name "$line" "$feature")"

  local repos=()
  while IFS= read -r src; do repos+=("$src"); done < <(discover_repos "$line")
  [ "${#repos[@]}" -gt 0 ] || die "no git repos found in $(line_root "$line")"

  mkdir -p "$froot"
  info "feature workspace: $froot"
  info "branch (per repo): $branch"
  info "repos: ${#repos[@]}"

  for src in "${repos[@]}"; do
    target="$froot/$(basename "$src")"
    if [ -e "$target/.git" ]; then
      info "  = $(basename "$src")  (worktree exists, skip)"
      skipped=$((skipped+1)); continue
    fi
    # Attach existing feature branch if present (resume), else branch from HEAD.
    if git -C "$src" show-ref --verify --quiet "refs/heads/$branch"; then
      if git -C "$src" worktree add "$target" "$branch" >/dev/null 2>&1; then
        info "  + $(basename "$src")  (attached existing branch)"; created=$((created+1))
      else
        warn "  ! $(basename "$src")  (attach failed)"; failed=$((failed+1))
      fi
    else
      if git -C "$src" worktree add "$target" -b "$branch" >/dev/null 2>&1; then
        info "  + $(basename "$src")  (new branch from $(git -C "$src" rev-parse --abbrev-ref HEAD))"; created=$((created+1))
      else
        warn "  ! $(basename "$src")  (worktree add failed)"; failed=$((failed+1))
      fi
    fi
  done

  info "created=$created skipped=$skipped failed=$failed"
  [ "$failed" -eq 0 ] || die "some worktrees failed; workspace incomplete"
  printf '%s\n' "$froot"     # stdout = path, for scripting
}

# --- testsuite scaffolding ---------------------------------------------------

# Print the value of a key in a testsuite .sav config (empty if absent).
# A .sav holds the previous generation as an "<obj>.old" block *before* the
# current one, so the LAST occurrence is the authoritative value.
read_sav_value() {
  [ -f "$1" ] || return 0
  awk -v key=":$2:" '
    $0 == key { if ((getline v) > 0) { sub(/^:/,"",v); sub(/:$/,"",v); last = v } }
    END { if (last != "") print last }' "$1"
}

read_commd_port() { read_sav_value "$1" commd_port; }

# The testsuite user configuration is the port registry: a commd_port only
# works if it is in <user>,portlist there, because that is what vends the
# per-user/port gid_range block. Ports must be even (execd = commd_port + 1).
user_config_file() {
  local cfg="$1" f
  f="$(read_sav_value "$cfg" user_config_file)"
  [ -n "$f" ] || f="$(read_sav_value "$cfg" user_config_file,default)"
  printf '%s\n' "$f"
}

# Window the workspaces draw from. Without one this function walked the whole
# portlist and, because of the "tac" below, started at its very end -- which is
# where ports registered for something else land, since the list only ever grows
# by appending. A workspace would therefore have taken the newest runner port of
# a line before that line had a chance to init on it, and with nothing but the
# reverse order to stop it, the release-line ports 8000..8008 were reachable too.
#
# The map is what the ports actually are, not a preference:
#
#   8000..8008   release lines
#   8010..8098   feature workspaces (this window)
#   8100..8198   runners            (see line_port_window in gcs-runners)
#
# Swapped on 2026-08-27: the runner fleet grew to 48 and only 45 ports fit below
# 8100, so it took the window above 8100 and the workspaces moved down into what
# it vacated -- they are few, and 32 registered ports here are ample. The 91x
# runner ports (8200..8262) went with that line's fleet; 8200 up is free.
#
# The two workspaces created before the swap keep their ports 8106/8108 and are
# therefore ABOVE this window. Nothing breaks: this window governs which port a
# NEW workspace is handed, while used_ports() in gcs-runners reads every
# workspace .sav and keeps those two out of the fleet either way. Their trees
# under /usr/local/testsuite/<port> move only when the workspace is rebuilt.
#
# GCS_WORKSPACE_PORT_MIN/MAX override for a one-off. Running out of ports here
# is meant to end in the die() of pick_port -- register another even port in
# this window via the testsuite menu, never widen the window to borrow one that
# belongs to a line.
WORKSPACE_PORT_MIN="${GCS_WORKSPACE_PORT_MIN:-8010}"
WORKSPACE_PORT_MAX="${GCS_WORKSPACE_PORT_MAX:-8100}"

registered_ports() {
  local cfg="$1" ucf p
  ucf="$(user_config_file "$cfg")"
  [ -n "$ucf" ] && [ -f "$ucf" ] || die "testsuite user config not readable: ${ucf:-<unset>}"
  # Reverse registration order: the portlist grows by appending, so the newest
  # entries are the ones added for extra clusters -- hand those out first and
  # leave the long-established low ports to their existing suites.
  for p in $(read_sav_value "$ucf" "$USER,portlist" | tr ' ' '\n' | tac); do
    case "$p" in *[!0-9]*|"") continue ;; esac
    [ "$p" -ge "$WORKSPACE_PORT_MIN" ] || continue
    [ "$p" -lt "$WORKSPACE_PORT_MAX" ] || continue
    [ $((p % 2)) -eq 0 ] || continue       # odd port would collide with its own execd
    printf '%s\n' "$p"
  done
}

# Every port we must not hand out twice: any line config (including variants
# like defaults-91x.mpi.sav), other feature workspaces, and anything listening.
used_ports() {
  local line="$1" f
  for f in "$CLION_ROOT"/*/config/defaults-*.sav \
           "$CLION_ROOT"/*-features/*/config/defaults-*.sav; do
    [ -f "$f" ] || continue
    read_commd_port "$f"
  done
  ss -ltnH 2>/dev/null | awk '{print $4}' | sed 's/.*://' | grep -E '^[0-9]+$' || true
}

# Hand out the lowest registered port that nothing else claims. Never invent
# one: an unregistered port has no gid_range and the testsuite would reject it.
pick_port() {
  local line="$1" cfg="$2" p used regd
  used=" $(used_ports "$line" | sort -un | tr '\n' ' ') "
  regd="$(registered_ports "$cfg")"
  [ -n "$regd" ] || die "no usable ports in $USER,portlist of $(user_config_file "$cfg")"
  for p in $regd; do
    case "$used" in *" $p "*|*" $((p+1)) "*) continue ;; esac
    printf '%s\n' "$p"; return 0
  done
  die "all registered ports in [$WORKSPACE_PORT_MIN,$WORKSPACE_PORT_MAX) are taken ($(printf '%s' "$regd" | tr '\n' ' '));
       add another even port in that window to $USER,portlist in $(user_config_file "$cfg")
       via the testsuite menu (user config) — it vends the gid_range itself"
}

# Directory that holds the line wrapper as it is reachable on PATH.
#
# Only one hop, deliberately: since the tools are installed as symlinks
# themselves, "readlink -f" resolves right through the link farm into the
# checkout -- and a feature wrapper dropped there is neither on PATH nor
# something that belongs in version control.
line_bindir() {
  local lroot="$1" line="$2" p
  p="$lroot/config/$line"
  p="$(readlink "$p" 2>/dev/null || printf '%s' "$p")"
  case "$p" in /*) : ;; *) p="$lroot/config/$p" ;; esac
  dirname "$p"
}

# Substring-match a port against the " 8100 8102 ... " registration string.
# Guards explicitly against an empty port: `*" $p "*` with p="" would
# otherwise match the trailing double space in $regd and look "registered".
port_registered() {
  local p="$1" regd="$2"
  [ -n "$p" ] || return 1
  case "$regd" in *" $p "*) return 0 ;; *) return 1 ;; esac
}

# Per-port cluster tree: <port>/build is where the pipeline script points CMake
# (gcs-pipeline: SGE_BUILD), <port>/execd and <port>/testsuite are the spool.
# It lives OUTSIDE the workspace, which is why teardown has to remove it
# explicitly -- see remove_cluster_tree() for what happens when it does not.
cluster_tree() { printf '/usr/local/testsuite/%s\n' "$1"; }

# Every host the testsuite could have created a cluster tree on.
#
# The tree is made wherever the suite does something for the cluster: the
# compile hosts build in <port>/build, the execd hosts spool in <port>/execd,
# and the host driving the run keeps <port>/testsuite. Removing only the local
# one left more than 8 G of build directories per torn-down workspace on hosts
# nobody looks at -- and left exactly the stale CMakeCache.txt that
# remove_cluster_tree exists to prevent.
#
# The list comes from the testsuite host configuration, because that is the
# complete set the suite can address; a host that never had a tree simply has
# nothing to remove. Read from the LINE's config, not the workspace's, so this
# still works when --force has already taken the workspace config away.
cluster_hosts() {
  local line="$1" hcf
  hcf="$(read_sav_value "$(line_root "$line")/config/defaults-$line.sav" host_config_file)"
  [ -n "$hcf" ] && [ -f "$hcf" ] || return 0
  sed -n 's/^:\([A-Za-z0-9._-]\{1,\}\),arch\(,[0-9]\{1,\}\)\{0,1\}:$/\1/p' "$hcf" | sort -u
}

# Is the cluster still up? Same source as used_ports().
port_listening() {
  [ -n "$1" ] || return 1
  ss -ltnH 2>/dev/null | awk '{print $4}' | sed 's/.*://' | grep -qx "$1"
}

# Does any config OUTSIDE this workspace claim the port? Companion configs of
# the workspace itself (defaults-<line>-<feature>.<project>.sav) are skipped by
# path, not by name, so they can never look like a foreign claim.
port_claimed_outside() {
  local port="$1" froot="$2" f
  for f in "$CLION_ROOT"/*/config/defaults-*.sav \
           "$CLION_ROOT"/*-features/*/config/defaults-*.sav; do
    [ -f "$f" ] || continue
    case "$f" in "$froot"/*) continue ;; esac
    [ "$(read_commd_port "$f")" = "$port" ] && return 0
  done
  return 1
}

# Hosts on which this workspace's cluster is still alive.
#
# Two signals, because either alone can lie: the port can be held by a daemon
# whose spool is long gone, and a daemon can be up on a host while the port is
# bound on another. What makes the answer specific to THIS workspace is argv[0]
# under its own inst -- the line's cluster runs from the line's inst and must
# never be mistaken for it.
#
# Asked on every host the suite knows, not only here. Checking the local ss was
# what made a tear-down look safe on 2026-09-01 while the qmaster was running on
# master_host all along: the workspace was removed underneath it and left seven
# daemons behind with deleted binaries.
cluster_running_hosts() {
  local line="$1" port="$2" froot="$3" h me fmap seen=" "
  me="$(hostname -s)"
  fmap="$(seg_map "$(home_form "$froot")")"
  for h in $(cluster_hosts "$line") "$me"; do
    case " $seen " in *" $h "*) continue ;; esac
    seen="$seen $h"
    if [ "$h" = "$me" ]; then
      if port_listening "$port" \
         || ps -eo comm=,args= 2>/dev/null | awk -v p="$fmap/" 'index($2,p)==1' | grep -q .; then
        printf '%s\n' "$h"
      fi
      continue
    fi
    case "$(timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=4 -o StrictHostKeyChecking=no "$h" \
              "if ss -ltnH 2>/dev/null | awk '{print \$4}' | sed 's/.*://' | grep -qx '$port'; then echo yes;
               elif ps -eo comm=,args= 2>/dev/null | awk -v p='$fmap/' 'index(\$2,p)==1' | grep -q .; then echo yes;
               else echo no; fi" 2>/dev/null)" in
      yes) printf '%s\n' "$h" ;;
    esac
  done
}

# Remove the cluster tree of a torn-down workspace.
#
# Without this the tree outlives the workspace, and since pick_port hands a
# freed port straight to the next feature, that feature inherits <port>/build
# with a CMakeCache.txt whose CMAKE_HOME_DIRECTORY still names the deleted
# source tree -- every build then fails with "does not match the source
# directory" until it is removed by hand.
remove_cluster_tree() {
  local port="$1" froot="$2" line="$3" feature="$4" tree seen=" "

  if [ -z "$port" ]; then
    warn "no commd_port recorded (no ts-init config?) — cluster tree, if any, left behind"
    return 0
  fi
  case "$port" in
    *[!0-9]*) warn "recorded commd_port '$port' is not numeric — leaving the cluster tree alone"; return 0 ;;
  esac

  tree="$(cluster_tree "$port")"

  # This one is global: a port claimed by another configuration must not have
  # its tree taken away on ANY host, so it is decided before the loop.
  if port_claimed_outside "$port" "$froot"; then
    warn "port $port is configured outside this workspace too — leaving $tree everywhere"
    return 0
  fi

  local h me gone=0 kept_h=0
  me="$(hostname -s)"
  for h in $(cluster_hosts "$line") "$me"; do
    case " $seen " in *" $h "*) continue ;; esac
    seen="$seen $h"

    if [ "$h" = "$me" ]; then
      [ -d "$tree" ] || continue
      if port_listening "$port"; then
        warn "  $h: cluster still listening on $port — leaving $tree"; kept_h=$((kept_h+1)); continue
      fi
      if rm -rf "$tree"; then info "  $h: removed $tree"; gone=$((gone+1))
      else warn "  $h: could not remove $tree"; kept_h=$((kept_h+1)); fi
      continue
    fi

    # One round trip per host, decision and removal together: asking first and
    # removing afterwards would be two chances for the state to change in
    # between. A host that cannot be reached is reported, not silently skipped.
    case "$(timeout 25 ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no "$h" \
              "if ss -ltnH 2>/dev/null | awk '{print \$4}' | sed 's/.*://' | grep -qx '$port'; then echo listening;
               elif [ -d '$tree' ]; then rm -rf '$tree' && echo removed || echo failed;
               else echo absent; fi" 2>/dev/null)" in
      removed)   info "  $h: removed $tree"; gone=$((gone+1)) ;;
      listening) warn "  $h: cluster still listening on $port — leaving $tree"; kept_h=$((kept_h+1)) ;;
      failed)    warn "  $h: could not remove $tree"; kept_h=$((kept_h+1)) ;;
      absent)    : ;;
      *)         warn "  $h: not reachable — $tree, if any, left behind"; kept_h=$((kept_h+1)) ;;
    esac
  done

  if [ "$kept_h" -gt 0 ]; then
    warn "cluster tree of port $port: $gone removed, $kept_h left"
    warn "  a surviving <port>/build breaks the next workspace that is handed this port"
  elif [ "$gone" -gt 0 ]; then
    info "cluster tree of port $port removed on $gone host(s)"
  fi
}

cmd_ts_init() {
  local line="${1:?line required}" feature="${2:?feature required}"; shift 2 || true
  local port="" force=0 a
  for a in "$@"; do
    case "$a" in
      --force)         force=1 ;;
      [0-9][0-9][0-9]*) port="$a" ;;
      *)               die "ts-init: unexpected argument '$a'" ;;
    esac
  done

  local froot lroot pipe src_cfg dst_cfg dst_script canon base_port
  froot="$(feature_root "$line" "$feature")"
  lroot="$(line_root "$line")"
  [ -d "$froot" ] || die "no feature workspace: $froot (run 'create' first)"

  pipe="$line-$feature"
  src_cfg="$lroot/config/defaults-$line.sav"
  dst_cfg="$froot/config/defaults-$pipe.sav"
  dst_script="$froot/config/$pipe"
  [ -f "$src_cfg" ] || die "line TS config not found: $src_cfg"

  canon="$(readlink -f "$lroot/config/$line" 2>/dev/null || true)"
  [ -n "$canon" ] && [ -x "$canon" ] || die "line pipeline script missing: $lroot/config/$line"
  # readlink -f canonicalises, and on the server that turns /home/<user> back
  # into /export/home/<user>. The value is written into the generated wrapper as
  # CS_TOOL_DIR and as the path it dot-sources, so it has to hold on every host
  # that may run the wrapper -- not only on the one that generated it.
  canon="$(home_form "$canon")"

  base_port="$(read_commd_port "$src_cfg")"
  [ -n "$base_port" ] || die "no commd_port in $src_cfg"

  # Reuse the port already assigned to this workspace so re-runs stay stable --
  # but only while it is still registered; a de-registered port gets replaced.
  local given_port="$port" regd
  regd=" $(registered_ports "$src_cfg" | tr '\n' ' ') "
  if [ -z "$port" ]; then
    port="$(read_commd_port "$dst_cfg")"
    if ! port_registered "$port" "$regd"; then
      [ -n "$port" ] && warn "recorded port $port is no longer registered, reassigning"
      port="$(pick_port "$line" "$src_cfg")"
    fi
  fi

  # Whatever the source, the port must be registered in the TS user config.
  port_registered "$port" "$regd" || die "port $port is not in $USER,portlist of $(user_config_file "$src_cfg");
     register it there (even port) via the testsuite menu, then re-run"
  case " $(used_ports "$line" | sort -un | tr '\n' ' ') " in
    *" $port "*)
      [ "$port" = "$(read_commd_port "$dst_cfg")" ] && [ -z "$given_port" ] \
        || warn "port $port already in use elsewhere" ;;
  esac

  # inst/ and results/ go where the segment puts them: on B that is the /scratch
  # export, which is where gcs-pipeline's CS_INST installs to and what
  # results_dir in the generated .sav will say. Creating them in the tree left an
  # empty, unused pair behind -- and made teardown believe it had removed them.
  mkdir -p "$froot/config" "$froot/pkg" "$froot/html" \
           "$(seg_leaf inst "$froot")" "$(seg_leaf results "$froot")"

  if [ -f "$dst_cfg" ] && [ "$force" -eq 0 ]; then
    info "  = config/$(basename "$dst_cfg")  (exists, skip; --force to regenerate)"
  else
    # Repoint every absolute line path at the workspace and move the port pair.
    # See repoint_args() for why one substitution per spelling is not enough --
    # and why it must not be one -e per spelling either.
    local -a rp=()
    mapfile -t rp < <(repoint_args "$lroot" "$froot")
    sed -E "${rp[@]}" \
        -e "s|^:p$base_port:\$|:p$port:|" \
        -e "s|^:$base_port:\$|:$port:|" \
        "$src_cfg" > "$dst_cfg"
    info "  + config/$(basename "$dst_cfg")  (from defaults-$line.sav, port $base_port -> $port)"
  fi

  # Companion checktree configs (defaults-<line>.<project>.sav, e.g. .mpi.sav)
  # are looked up by inserting the project name before the .sav extension of
  # whatever main config file is in use -- see get_additional_config_file_path()
  # in testsuite/src/tcl_files/file_procedures.tcl. They carry no line-specific
  # paths/ports, so a straight copy under the feature's config file name is enough.
  local addcfg dst_addcfg proj
  for addcfg in "$lroot"/config/defaults-"$line".*.sav; do
    [ -f "$addcfg" ] || continue
    proj="$(basename "$addcfg")"
    proj="${proj#defaults-$line.}"
    proj="${proj%.sav}"
    dst_addcfg="$froot/config/defaults-$pipe.$proj.sav"
    if [ -f "$dst_addcfg" ] && [ "$force" -eq 0 ]; then
      info "  = config/$(basename "$dst_addcfg")  (exists, skip; --force to regenerate)"
    else
      cp "$addcfg" "$dst_addcfg"
      info "  + config/$(basename "$dst_addcfg")  (from $(basename "$addcfg"), copied as-is)"
    fi
  done

  if [ -f "$dst_script" ] && [ "$force" -eq 0 ]; then
    info "  = config/$pipe  (exists, skip; --force to regenerate)"
  else
    cat > "$dst_script" <<EOF
#!/bin/sh
# Generated by gcs-feature-workspace ts-init — feature pipeline for '$feature'.
# Thin env wrapper: all logic stays in the shared line script, so fixes there
# apply here too. Regenerate with: gcs-feature-workspace ts-init $line $feature --force
CS_PIPELINE=$pipe
CS_HOME=$froot
CS_MASTER_PORT=$port
CS_WRAPPER_ACTIVE=1
# Where the tools live. Passed in rather than guessed: this wrapper runs under
# /bin/sh, so the sourced script only sees \$0 -- this file, not the tool
# directory -- and guessing via PATH fails under an IDE.
CS_TOOL_DIR=$(dirname "$canon")
export CS_PIPELINE CS_HOME CS_MASTER_PORT CS_WRAPPER_ACTIVE CS_TOOL_DIR
# dot-source (not exec) so ". $pipe" also works to load env into the
# current shell, matching the original script's no-action sourcing use case.
# CS_WRAPPER_ACTIVE tells the shared script these values are authoritative for
# this call (not stale exports from a previously sourced wrapper) — the shared
# script clears it again once consumed, so it never leaks between invocations.
. $canon "\$@"
EOF
    chmod +x "$dst_script"
    info "  + config/$pipe  (wrapper -> $canon)"
  fi

  # Symlink the wrapper next to the line wrapper, which is on PATH, so it can be
  # run as "$pipe" from anywhere and not only via its full path.
  local bindir link
  bindir="$(line_bindir "$lroot" "$line")"
  link="$bindir/$pipe"
  ln -sf "$dst_script" "$link"
  info "  + $link  (symlink, on PATH)"

  info ""
  info "cluster:  $pipe   qmaster $port / execd $((port + 1))   (cluster_name p$port)"
  info "spool:    /usr/local/testsuite/$port"
  info "run:      $dst_script build | install | ts | test <cat> | shutdown"
  printf '%s\n' "$dst_script"
}

cmd_ide_init() {
  local line="${1:?line required}" feature="${2:?feature required}"; shift 2 || true
  local force=0 a
  for a in "$@"; do
    case "$a" in
      --force) force=1 ;;
      *)       die "ide-init: unexpected argument '$a'" ;;
    esac
  done

  local froot lroot src_idea dst_idea pipe dst_script f
  froot="$(feature_root "$line" "$feature")"
  lroot="$(line_root "$line")"
  [ -d "$froot" ] || die "no feature workspace: $froot (run 'create' first)"
  src_idea="$lroot/.idea"
  dst_idea="$froot/.idea"
  [ -d "$src_idea" ] || die "no CLion project to copy: $src_idea"

  if [ -d "$dst_idea" ] && [ "$force" -eq 0 ]; then
    info "  = .idea  (exists, skip; --force to regenerate)"
  else
    rm -rf "$dst_idea"
    cp -r "$src_idea" "$dst_idea"
    # Backups of the line's project state are not part of the project. cp -r
    # takes the directory as it stands, and that is how a workspace.xml.bak from
    # August turned up inside a workspace created today -- carrying, of all
    # things, the pre-storage-move CMAKE_INSTALL_PREFIX. Dropped after the copy
    # rather than filtered during it, so this stays a plain cp with no rsync
    # dependency; -prune keeps find from descending into what it just removed.
    find "$dst_idea" -name '*.bak*' -prune -exec rm -rf {} +
    # Repoint every absolute line-root path (CMAKE_INSTALL_PREFIX and anything
    # else hardcoded into run/CMake configs) at the feature workspace instead.
    #
    # Recursively: the glob "$dst_idea"/*.xml never reached runConfigurations/,
    # where the generated "pending" configuration carries an absolute
    # --tests-from-file path into the line. Same spelling problem as ts-init, so
    # the same repoint_args().
    local -a rp=()
    mapfile -t rp < <(repoint_args "$lroot" "$froot")
    while IFS= read -r f; do
      sed -E -i "${rp[@]}" "$f"
    done < <(find "$dst_idea" -type f \( -name '*.xml' -o -name '*.iml' \))
    # Name the project "<version> (<feature>)", e.g. "9.2.x (fixes)", so the
    # CLion window says which line and which workspace it belongs to. Lines
    # themselves carry the bare version, e.g. "9.2.x".
    printf '%s (%s)' "$(line_version "$line")" "$feature" > "$dst_idea/.name"
    info "  + .idea  (copied from $line, paths repointed, project name '$(line_version "$line") ($feature)')"
  fi

  pipe="$line-$feature"
  dst_script="$froot/config/$pipe"
  info ""
  if [ -x "$dst_script" ]; then
    info "open with: $dst_script clion"
  else
    info "open with: <pipeline-script> clion  (run ts-init first to create it)"
  fi
}

cmd_teardown() {
  local line="${1:?line required}" feature="${2:?feature required}"; shift 2 || true
  local force=0 ignore_running=0 a
  for a in "$@"; do
    case "$a" in
      --force)          force=1 ;;
      --ignore-running) ignore_running=1 ;;
    esac
  done

  local froot branch src target base d removed=0 kept=0 port fmap
  froot="$(feature_root "$line" "$feature")"
  branch="$(branch_name "$line" "$feature")"

  # Read the cluster port BEFORE anything is removed: --force deletes config/
  # below, and that file is the only record of which port this workspace owns.
  # Deliberately no fallback to the line config -- an empty value there would
  # aim the cluster-tree removal at the line's own cluster.
  port="$(read_commd_port "$froot/config/defaults-$line-$feature.sav")"

  # Nothing is removed while the cluster is still up. remove_cluster_tree checks
  # per host too, but by the time it runs the worktrees and inst are already
  # gone -- and daemons whose binaries have been deleted cannot even be shut
  # down properly afterwards, they can only be killed as root. So the question
  # is asked here, before the first irreversible step.
  if [ -n "$port" ] && [ "$ignore_running" -eq 0 ]; then
    local running
    running="$(cluster_running_hosts "$line" "$port" "$froot" | tr '\n' ' ')"
    if [ -n "${running// /}" ]; then
      die "cluster of $line-$feature is still up on: $running
       shut it down first:  $line-$feature shutdown
       --ignore-running tears down anyway -- only for a cluster that can no
       longer be shut down, and it leaves its daemons running"
    fi
  fi

  # Drop the on-PATH wrapper symlink (config/$line-$feature), if ts-init made one.
  local bindir link
  bindir="$(line_bindir "$(line_root "$line")" "$line")"
  if [ -n "$bindir" ]; then
    link="$bindir/$line-$feature"
    # Both sides canonicalised. Comparing a resolved link against a raw path
    # holds only as long as no component of CLION_ROOT is itself a symlink; the
    # moment one is, the link silently fails the test and stays on PATH as one
    # more dead entry.
    if [ -L "$link" ] \
       && [ "$(readlink -f "$link")" = "$(readlink -f "$froot/config/$line-$feature")" ]; then
      rm -f "$link" && info "removed $link (wrapper symlink)"
    fi
  fi

  # Guard: only ever operate under <line>-features/
  base="$CLION_ROOT/$line-features"
  case "$froot/" in "$base/"*) : ;; *) die "refusing teardown outside $base" ;; esac
  [ -d "$froot" ] || die "no such feature workspace: $froot"

  for d in "$froot"/*/; do
    [ -d "$d" ] || continue
    d="${d%/}"
    src="$(line_root "$line")/$(basename "$d")"
    if [ ! -e "$src/.git" ]; then warn "  ? $(basename "$d") — no source repo, leaving"; continue; fi
    if [ "$force" -eq 1 ]; then
      git -C "$src" worktree remove --force "$d" >/dev/null 2>&1 || warn "  ! remove failed: $(basename "$d")"
    else
      if ! git -C "$src" worktree remove "$d" >/dev/null 2>&1; then
        warn "  ! $(basename "$d") — worktree dirty; use --force to discard"; kept=$((kept+1)); continue
      fi
    fi
    # Delete the feature branch. -d refuses if unmerged; -D only with --force.
    if [ "$force" -eq 1 ]; then
      git -C "$src" branch -D "$branch" >/dev/null 2>&1 || true
    else
      git -C "$src" branch -d "$branch" >/dev/null 2>&1 \
        || warn "  ~ $(basename "$d") — branch '$branch' unmerged, kept (use --force to drop)"
    fi
    git -C "$src" worktree prune >/dev/null 2>&1 || true
    removed=$((removed+1))
  done

  # Only once the teardown actually went through: a half torn-down workspace
  # keeps its cluster, so it keeps its build and spool too.
  [ "$kept" -eq 0 ] && remove_cluster_tree "$port" "$froot" "$line" "$feature"

  if [ "$kept" -gt 0 ]; then
    warn "$kept worktree(s) kept (dirty); workspace left: $froot"
  elif [ "$force" -eq 1 ]; then
    # --force takes the non-repo siblings too (config/ inst/ pkg/ html/ results/,
    # i.e. the ts-init scaffolding and any test results).
    rm -rf "$froot" && info "removed $froot (incl. config/inst/results)"
    # And the segment side. On B inst/ and results/ are on the /scratch export,
    # so removing the tree copy alone left the big half of the workspace behind.
    # Guarded by shape, not by trust: this is an rm -rf on a computed path.
    fmap="$(seg_map "$(home_form "$froot")")"
    if [ "$fmap" != "$(home_form "$froot")" ] && [ -d "$fmap" ]; then
      case "$fmap" in
        */"$line-features/$feature")
          rm -rf "$fmap" 2>/dev/null
          # The testsuite installs as root, so inst/ is full of root-owned files
          # -- utilbin/<arch>/testsuidroot is even setuid root -- and
          # /export/scratch/<user>/Clion is the export that carries
          # no_root_squash, so they really do belong to root. An unprivileged rm
          # walks the tree, deletes what it may and leaves the rest: measured
          # 1.4 G and 621 files on the first tear-down that got this far.
          # Escalate only for what survived, and only for a path that still has
          # the <line>-features/<feature> shape.
          if [ -d "$fmap" ]; then
            "$SCRIPT_DIR/as-root" "$(hostname -s)" "rm -rf '$fmap'" >/dev/null 2>&1 || true
          fi
          if [ -d "$fmap" ]; then
            warn "left $fmap -- not removable, not even as root"
          else
            info "removed $fmap (inst/results on the export)"
          fi ;;
        *)
          warn "left $fmap -- not shaped like <line>-features/<feature>" ;;
      esac
    fi
  else
    rmdir "$froot" 2>/dev/null && info "removed empty $froot" \
      || warn "workspace dir not empty (ts-init scaffolding?), left: $froot — --force removes it"
  fi
  info "teardown: removed=$removed kept=$kept"
}

cmd_list() {
  local line="${1:-}" base d f
  if [ -n "$line" ]; then
    base="$CLION_ROOT/$line-features"
    [ -d "$base" ] || { info "(no features for line $line)"; return; }
    for f in "$base"/*/; do [ -d "$f" ] && printf '%s\n' "${f%/}"; done
    return
  fi
  for d in "$CLION_ROOT"/*-features/; do
    [ -d "$d" ] || continue
    for f in "$d"*/; do [ -d "$f" ] && printf '%s\n' "${f%/}"; done
  done
}

cmd_path() {
  local line="${1:?line required}" feature="${2:?feature required}"
  printf '%s\n' "$(feature_root "$line" "$feature")"
}

# --- dispatch ----------------------------------------------------------------

[ $# -ge 1 ] || usage 1
sub="$1"; shift || true
case "$sub" in
  create)   cmd_create   "$@" ;;
  ts-init)  cmd_ts_init  "$@" ;;
  ide-init) cmd_ide_init "$@" ;;
  teardown) cmd_teardown "$@" ;;
  list)     cmd_list     "$@" ;;
  path)     cmd_path     "$@" ;;
  repos)    cmd_repos    "$@" ;;
  -h|--help|help) usage 0 ;;
  *) die "unknown command: '$sub' (try: create|ts-init|ide-init|teardown|list|path|repos|help)" ;;
esac
