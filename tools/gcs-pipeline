#!/bin/sh

# arguments
action=$1
test_unit=$2
level=$3

# helpers
usage() {
   cat >&2 <<EOF
usage: $0 <action> [test_unit] [level]

actions:
   all       run full pipeline: git, build, install, test, shutdown (needs test_unit)
   git       git pull all source/test repos
   build     build and package via testsuite
   install   install cluster via testsuite (wipes and recreates the cell)
   start     start an already installed cluster (no reinstall, no data loss)
   shutdown  shut down cluster via testsuite
   ts        start interactive testsuite
   test      run all tests in a category    (needs test_unit)
   check     run a specific test            (needs test_unit, level)
   dump      dump the test list
   fullrun   run the COMPLETE testsuite: every category, every test, up to
             the given runlevel (needs runlevel) -- this is check.exp's own
             "all <runlevel>" mode, not the category-tag-filtered "test"
             action. Long-running; meant for nightly/CI, not the dev loop.
   clion     open this workspace's CLion project (with matching env)
   reset     mark all tests as not-completed again (moves completed/failed/
             unsupported result markers back into *.uncompleted, does not
             delete anything)
   runners   manage the parallel test clusters of this line; forwards to
             gcs-runners (init | install [-p] | status | teardown)
   testrun   full two-phase test run: parallel over N runners, then the
             failures serially; forwards to gcs-testrun
   help      show this message

See testsuite/tools/doc/gcs-pipeline.md for the full picture, in particular
for the parallel test setup.
EOF
   exit 2
}

# "reset the TS" without deleting results: for every host-prefixed result
# directory under $CS_HOME/results (h047.completed, v01701.failed, ...),
# move its .res.<level> marker files into the matching *.uncompleted dir
# instead of rm'ing them, so completed/failed/unsupported test history
# stays around for inspection but the TS treats every test as not-yet-run.
reset_results() {
   results_dir="$CS_HOME/results"
   [ -d "$results_dir" ] || { printf 'no results dir at %s, nothing to reset\n' "$results_dir" >&2; return 0; }
   moved=0
   for d in "$results_dir"/*.completed "$results_dir"/*.failed "$results_dir"/*.unsupported; do
      [ -d "$d" ] || continue
      host=$(basename "$d" | sed -E 's/\.(completed|failed|unsupported)$//')
      target="$results_dir/$host.uncompleted"
      mkdir -p "$target"
      for f in "$d"/*; do
         [ -e "$f" ] || continue
         mv -f "$f" "$target/" && moved=$((moved + 1))
      done
   done
   printf 'reset: moved %d result marker(s) into *.uncompleted under %s\n' "$moved" "$results_dir"
}

# Read a key from a testsuite .sav file. A .sav carries the previous generation
# as an "<obj>.old" block before the current one, so the LAST occurrence wins.
read_sav_value() {
   [ -f "$1" ] || return 0
   awk -v key=":$2:" '
      $0 == key { if ((getline v) > 0) { sub(/^:/,"",v); sub(/:$/,"",v); last = v } }
      END { if (last != "") print last }' "$1"
}

get_branch() {
   if [ -e "$1" ]; then
      (cd "$1" && git rev-parse --abbrev-ref HEAD 2>/dev/null) || echo "unknown"
   else
      echo "unknown"
   fi
}

run_check() {
   header=$1
   shift
   printf '\n\n%s\n\n' "$header"
   cd "$SGE_TEST/src" || exit 1
   expect check.exp $args "$@"
   exit $?
}

# run the interactive TS inside a tmux session named after CS_PIPELINE, so
# it shows up in `tmux list-sessions` as e.g. "91x" or "91x-ts-dev" instead
# of an anonymous numeric session. If we're already inside tmux, just run
# directly (no nesting). If a session with that name is already running,
# attach to it instead of starting a second one.
run_check_tmux() {
   # "=name" forces an exact match. Without it tmux resolves -t by exact name,
   # then *prefix*, then fnmatch, then case-insensitively - so `92x ts` would
   # find and attach to a running "92x-fixes" session, silently dropping the
   # user into the feature workspace's TS instead of the line's own.
   session="=$CS_PIPELINE"
   if [ -n "$TMUX" ]; then
      run_check "$@"
   elif tmux has-session -t "$session" 2>/dev/null; then
      printf 'attaching to existing tmux session %s\n' "$CS_PIPELINE"
      exec tmux attach-session -t "$session"
   else
      printf 'starting tmux session %s\n' "$CS_PIPELINE"
      exec tmux new-session -s "$CS_PIPELINE" "$0" ts
   fi
}

# validate action up-front (short-circuits help / unknown before expensive derivation)
case $action in
   help|--help|-h) usage ;;
   all|git|ts|build|install|start|shutdown|test|check|dump|fullrun|clion|reset|runners|testrun|"") ;;
   *)
      printf 'unknown action: %s\n\n' "$action" >&2
      usage
      ;;
esac

# global parameter. Feature-workspace wrappers export CS_PIPELINE/CS_HOME/
# CS_MASTER_PORT plus CS_WRAPPER_ACTIVE=1 right before dot-sourcing this file —
# that sentinel means "trust these, they were just set for this call". Without
# it we always fall back to the line defaults, even if those vars are still
# exported in the shell from an earlier wrapper source (otherwise sourcing
# this script directly after ". 91x-ts-dev" would stay stuck in ts-dev).
CLION_ROOT=${GCS_CLION_ROOT:-$HOME/Clion}

# Directory this script lives in. The helpers it calls (get_pwd.sh, gcs-runners,
# gcs-testrun) sit next to it, so nothing has to be hard-coded to one user's
# home.
#
# A wrapper that sources this file passes CS_TOOL_DIR in -- it knows the
# absolute path it is sourcing. Only when invoked directly do we have to work it
# out, and then $0 is the line link and points here.
#
# Do not fall back to PATH: an IDE inherits the desktop session environment, not
# an interactive shell, so the tool directory is usually not on it. That failure
# is silent and shows up much later as "cmd '/get_pwd.sh' is not executable".
if [ -z "${CS_TOOL_DIR:-}" ]; then
   _d=$(dirname "${BASH_SOURCE:-$0}")
   [ -x "$_d/get_pwd.sh" ] && CS_TOOL_DIR=$(cd "$_d" && pwd)
   unset _d
fi
if [ -z "${CS_TOOL_DIR:-}" ] || [ ! -x "$CS_TOOL_DIR/get_pwd.sh" ]; then
   printf 'cannot locate the tool directory (no get_pwd.sh found)\n' >&2
   printf 'set CS_TOOL_DIR, or regenerate the wrappers: gcs-runners <line> init\n' >&2
   exit 2
fi

if [ "$CS_WRAPPER_ACTIVE" = "1" ]; then
   CS_PIPELINE=${CS_PIPELINE:-92x}
   CS_HOME=${CS_HOME:-$CLION_ROOT/$CS_PIPELINE}
   CS_MASTER_PORT=${CS_MASTER_PORT:-8002}
else
   # Without a wrapper the invocation name determines the line: 90x, 91x and
   # 92x are symlinks to this file. BASH_SOURCE so that ". 92x" works too --
   # when sourcing, $0 stays the shell itself.
   CS_PIPELINE=$(basename "${BASH_SOURCE:-$0}")
   CS_HOME=$CLION_ROOT/$CS_PIPELINE
   # The port comes from the line configuration rather than a table in this
   # script: it is recorded there anyway, and two sources for the same value
   # drift apart sooner or later.
   CS_MASTER_PORT=$(awk -F: '/^:commd_port:$/{getline; v=$2} END{print v}' \
                    "$CS_HOME/config/defaults-$CS_PIPELINE.sav" 2>/dev/null)
   if [ ! -f "$CS_HOME/config/defaults-$CS_PIPELINE.sav" ] || [ -z "$CS_MASTER_PORT" ]; then
      printf 'no line configuration for "%s" (%s)\n' \
             "$CS_PIPELINE" "$CS_HOME/config/defaults-$CS_PIPELINE.sav" >&2
      printf 'call this via one of the line links, e.g. 92x, not by its own name\n' >&2
      exit 2
   fi
fi
export CS_PIPELINE CS_HOME CS_MASTER_PORT
unset CS_WRAPPER_ACTIVE

# scrub a foreign cluster environment out of what we inherited. A tmux server
# keeps the environment of the shell that started it in its *global* env, so
# every session it later spawns (including the one `ts` creates) starts with
# PATH/LD_LIBRARY_PATH/MANPATH pointing into whatever workspace's inst/ was
# active back then, plus that cluster's SGE_CELL/SGE_CLUSTER_NAME/ports.
# Sourcing our own settings.sh further down would repair this — but only when
# this line actually has an installed cluster. With an empty inst/ that source
# is skipped and the foreign values survive, so the TS runs our config while
# every qconf/qstat/qsub resolves to the other line's binaries and port.
strip_foreign_inst() {
   _out=""
   _oifs=$IFS
   IFS=:
   for _p in $1; do
      [ -n "$_p" ] || continue
      case $_p in
         "$CS_HOME"/*) ;;              # our own line — keep
         */inst|*/inst/*) continue ;;  # another workspace's install — drop
      esac
      _out="${_out:+$_out:}$_p"
   done
   IFS=$_oifs
   printf '%s' "$_out"
}
PATH=$(strip_foreign_inst "$PATH")
LD_LIBRARY_PATH=$(strip_foreign_inst "$LD_LIBRARY_PATH")
MANPATH=$(strip_foreign_inst "$MANPATH")
export PATH LD_LIBRARY_PATH MANPATH
# these only ever come from some settings.sh; ours is sourced below if it
# exists, so anything still set here belongs to a foreign cluster
case $SGE_ROOT in
   "$CS_HOME"/*) ;;
   *) unset SGE_CELL SGE_CLUSTER_NAME ;;
esac

# default values
SGE_SOURCE="$CS_HOME/clusterscheduler"
SGE_EXT="$CS_HOME/gcs-extensions"
SGE_QGPU="$CS_HOME/qgpu"
SGE_TEST="$CS_HOME/testsuite"
SGE_EXT_TEST="$CS_HOME/ocs-testsuite"
SGE_PKG="$CS_HOME/pkg"
export SGE_ROOT="$CS_HOME/inst"
SGE_BUILD="/usr/local/testsuite/$CS_MASTER_PORT/build"
SGE_QMASTER_PORT=$CS_MASTER_PORT
SGE_EXECD_PORT=$((SGE_QMASTER_PORT + 1))
# export unconditionally: without this they are only exported when an inherited
# (i.e. foreign) value happened to be in the environment already
export SGE_QMASTER_PORT SGE_EXECD_PORT
SGE_VERSION="unknown"
SGE_ACT_QMASTER="unknown"
SGE_PKG_FILES=0
SGE_DRMAA_JAVA="$CS_HOME/drmaa-java"
SGE_ARCH=""
# The display the tests should use is a property of the user, not of this
# script: the testsuite user configuration carries it in "<user>,envlist" and
# the testsuite hands it to the tests from there. Read it from the same place
# instead of pinning one developer's workstation into the tooling. If it is not
# configured, leave whatever the environment already has.
_user_conf=$(read_sav_value "$CS_HOME/config/defaults-$CS_PIPELINE.sav" user_config_file)
_env_list=$(read_sav_value "$_user_conf" "$(id -un),envlist")
case $_env_list in
   *DISPLAY=*)
      DISPLAY=${_env_list#*DISPLAY=}
      DISPLAY=${DISPLAY%% *}
      export DISPLAY
      ;;
esac
unset _user_conf _env_list
CLION_LAUNCHER="${GCS_CLION_LAUNCHER:-$HOME/.local/share/JetBrains/Toolbox/apps/clion/bin/clion}"

# derived values
if [ -e "$SGE_ROOT/default/common/settings.sh" ]; then
   . "$SGE_ROOT/default/common/settings.sh"
fi
if [ -e "$SGE_ROOT/util/dl.sh" ]; then
   . "$SGE_ROOT/util/dl.sh"
fi
if [ -e "$SGE_SOURCE" ]; then
   SGE_ARCH=$("$SGE_SOURCE/source/dist/util/arch")
fi
SGE_SOURCE_BRANCH=$(get_branch "$SGE_SOURCE")
SGE_EXT_BRANCH=$(get_branch "$SGE_EXT")
SGE_EXT_TEST_BRANCH=$(get_branch "$SGE_EXT_TEST")
SGE_QGPU_BRANCH=$(get_branch "$SGE_QGPU")
SGE_TEST_BRANCH=$(get_branch "$SGE_TEST")
if [ -n "$SGE_ARCH" ] && [ -e "$SGE_ROOT/bin/$SGE_ARCH/qstat" ]; then
   SGE_VERSION=$("$SGE_ROOT/bin/$SGE_ARCH/qstat" -help | head -1)
fi
if [ -e "$SGE_ROOT/default/common/act_qmaster" ]; then
   SGE_ACT_QMASTER=$(head -1 "$SGE_ROOT/default/common/act_qmaster")
fi
if [ -e "$SGE_PKG" ]; then
   SGE_PKG_FILES=$(find "$SGE_PKG" -mindepth 1 -maxdepth 1 | wc -l)
fi
CMAKE_BUILD_ID=$(date +%d%m%y-%H%M)

# show values
echo "SGE_SOURCE       = $SGE_SOURCE ($SGE_SOURCE_BRANCH)"
echo "SGE_TEST         = $SGE_TEST        ($SGE_TEST_BRANCH)"
echo "SGE_EXT          = $SGE_EXT   ($SGE_EXT_BRANCH)"
echo "SGE_EXT_TEST     = $SGE_EXT_TEST    ($SGE_EXT_TEST_BRANCH)"
echo "SGE_QGPU         = $SGE_QGPU             ($SGE_QGPU_BRANCH)"
echo "SGE_PKG          = $SGE_PKG              ($SGE_PKG_FILES files)"
echo "SGE_ROOT         = $SGE_ROOT             ($SGE_VERSION; $SGE_ACT_QMASTER)"
echo "SGE_BUILD        = $SGE_BUILD"
echo "SGE_QMASTER_PORT = $SGE_QMASTER_PORT"
echo "SGE_EXECD_PORT   = $SGE_EXECD_PORT"
echo "CMAKE_BUILD_ID   = $CMAKE_BUILD_ID"

# global TS parameter
args=""
args="$args file $CS_HOME/config/defaults-${CS_PIPELINE}.sav"
#args="$args compile_clean"
# How much the testsuite itself produces. FINE is a readable default; FINER and
# FINEST add the internals of the remote procedures and are what you want when a
# test fails for reasons that are not in its own output. Beyond ctest's -V, which
# only decides how much of it is passed through.
args="$args output_level ${CS_OUTPUT_LEVEL:-FINE}"
#args="$args coverage lcov"
#args="$args coverage_dir /root_access/ebablick/coverage/build"
args="$args disable_washing_machine"
args="$args install_mode automatic"
args="$args html_dir $CS_HOME/html"
args="$args no_local_qmaster_spool"
# Debug is what the development loop wants: -O0 keeps the binaries readable in a
# debugger and the build fast. It also means the local build cannot see the
# warnings gcc only raises after inlining (-Wstringop-truncation and friends), so
# the nightly is the first to hit them. Set CS_BUILD_TYPE=Release to close that
# gap without changing what everyone else gets by default.
args="$args cmake_build_type ${CS_BUILD_TYPE:-Debug}"
args="$args cmake_build_id $CMAKE_BUILD_ID"
# The 3rdparty tools are only built when the build directory had to be created
# (compile.tcl:1328), but their install path carries CMAKE_BUILD_TYPE -- so a
# switch between Debug and Release finds an empty or stale tree and fails on a
# missing hwloc.h. Forcing the rebuild is what CS_CLEAN_3RDPARTY=1 is for.
if [ "${CS_CLEAN_3RDPARTY:-0}" = "1" ]; then
   args="$args compile_clean_3rdparty"
fi
args="$args get_pw_command ${GCS_PW_COMMAND:-$CS_TOOL_DIR/get_pwd.sh}"
# Keep the message translations between invocations. Off unless asked for: it is
# a measurable saving (15 s of a 46 s invocation, measured 2026-08-03) but it
# changes where the translations come from, and someone running a single check by
# hand should get exactly what they got yesterday.
[ "${GCS_L10N_CACHE:-0}" = "1" ] && args="$args l10n_cache"
# CS-984: verify after every test that its cleanup restored the cluster.
# fail (default) / report (log the leftovers only) / off.
#
# On by default, and failing rather than reporting: a check that leaves the
# cluster dirty is not a cosmetic finding, it is the next check on this cluster
# that pays for it. Interactively that costs nothing beyond the check itself -
# the automatic reinstall after a failure hangs on CS_SELF_HEAL, which only the
# runners set.
#
# Needs a 9.2 or newer product - the check reads the cluster with "qconf -S<obj>".
# On 9.0 and 9.1 the capability probe (ge_has_feature "bulk-object-export") comes
# back empty and the check does nothing, so this stays harmless for older lines
# that share this script.
#
#   GCS_CLEANUP_CHECK=off 92x check <path> <level>     to switch it off again
#
# Only pass it to a testsuite that knows the parameter. The check itself is
# harmless on 9.0/9.1 -- the capability probe comes back empty there -- but the
# 9.1 testsuite predates CS-984 and rejects the unknown parameter outright
# ("unexpected command line parameter"), which killed every 91x invocation of
# this script before the build even started.
if grep -q cleanup_check "$SGE_TEST/src/check.exp" 2>/dev/null; then
   args="$args cleanup_check ${GCS_CLEANUP_CHECK:-fail}"
fi
# Scale the wait timeouts inside the tests. The values they pass assume the
# testsuite has the hosts to itself; with several runners on one host set the
# same work takes 1.6 to 2.4 times longer and the waits report timeouts where
# nothing is wrong (CS-2481). gcs-run-unit sets this for parallel runs; unset it
# stays 1, so an interactive run is unchanged.
if [ -n "${CS_TIMEOUT_FACTOR:-}" ]; then
   args="$args timeout_factor $CS_TIMEOUT_FACTOR"
fi

# An X display for the checks that need one.
#
# "display <host>:<n>" makes check.exp point CHECK_DISPLAY_OUTPUT at an EXISTING
# display. It does not start anything -- the display has to be up and reachable
# already, for the test user AND root, from the master host AND every execution
# host (qrsh X11 forwarding needs all of them).
#
# Why a display is set at all: without one CHECK_DISPLAY_OUTPUT stays
# "undefined" and nothing says so. The X11 dependent checks then fail deep
# inside their own logic with messages that never mention X -- measured
# 2026-08-07, of 13 "real defects" in a 28 runner full run, 8 were nothing but
# the missing display (qrsh_ijs_x11_cookie_ordering, display_test,
# advance_reservation, qmod/reschedule, job_environment_basic,
# pe/allocation_rule and two issuezilla checks) and cost an evening of triage.
#
# A POOL of long-lived displays, not one per runner and not one for all.
#
# One per runner does not work: an X server drops its own local host from the
# access list within seconds, repeatedly, and once gone the display cannot be
# repaired (a local client needs a cookie or host access - both gone - and a
# remote client is refused outright). Measured 2026-08-07: 26 of 28 displays lost
# it, and mid-run loss turned a full run into 85 aborts and 2550 "not usable yet"
# waits.
#
# The pool avoids that not by being smaller but by how gcs-displays builds it:
# access control is turned OFF rather than nine hosts being granted, so there is
# no grant left to drop; the displays are started sequentially, so the concurrent
# "xauth add" that clobbered ~/.Xauthority cannot happen; and they are long-lived,
# so no run pays the startup race at all. See tools/gcs-displays.
#
# Runners are grouped: r1..r6 share the first display, r7..r12 the second, and so
# on. GCS_RUNNERS_PER_DISPLAY and GCS_DISPLAY_BASE must match what gcs-displays
# was started with - the arithmetic below is the same in both.
#
# The ratio went from 4 to 6 on 2026-08-27, when the fleet grew from 32 to 48:
# both numbers land on the same 8 displays, and 8 is where the pool has run
# reliably. Growing the POOL instead is the move that has caused trouble before
# (see the header of gcs-displays), so the ratio is what absorbs a bigger fleet.
#
# Sharing itself is cheap: a 28 runner full run on a SINGLE display passed all
# 244 entries with zero display errors, including qrsh_ijs_x11_cookie_ordering.
# The pool is headroom for the X11 forwarding checks, not a fix for a measured
# contention problem.
#
# GCS_DISPLAY overrides the computed display; set it empty to pass none at all.
_disp_base=${GCS_DISPLAY_BASE:-51}
_disp_per=${GCS_RUNNERS_PER_DISPLAY:-6}
case $CS_PIPELINE in
   *-r[0-9]|*-r[0-9][0-9])
      if [ -z "${GCS_DISPLAY+set}" ]; then
         _r_idx=$(printf '%s\n' "$CS_PIPELINE" | sed -n 's/.*-r\([0-9][0-9]*\)$/\1/p')
         [ -n "$_r_idx" ] || _r_idx=1
         _r_host=$(read_sav_value "$CS_HOME/config/defaults-${CS_PIPELINE}.sav" master_host)
         [ -n "$_r_host" ] || _r_host=$(hostname -s)
         GCS_DISPLAY="$_r_host:$(( _disp_base + (_r_idx - 1) / _disp_per ))"
      fi

      if [ -n "$GCS_DISPLAY" ]; then
         # Fail FAST and loudly. Without this the run starts anyway and every
         # X11 dependent check fails one by one, which is how a missing display
         # cost an evening of triage on 2026-08-06: 8 of 13 "real defects" of
         # that full run were nothing but the display not being there.
         if xdpyinfo -display "$GCS_DISPLAY" >/dev/null 2>&1; then
            echo "X DISPLAY         = $GCS_DISPLAY (shared by $_disp_per runners)"
         else
            echo "X DISPLAY         = $GCS_DISPLAY -- NOT REACHABLE" >&2
            echo "  start the pool first:  gcs-displays start" >&2
            exit 1
         fi
         args="$args display $GCS_DISPLAY"
      fi
      ;;
esac

case $action in
   all)
      [ -n "$test_unit" ] || { printf 'all: test_unit is required\n\n' >&2; usage; }
      printf '\n\nTRIGGER BUILD PIPELINE OCS-MASTER-NIGHTLY\n\n'
      for step in git build install; do
         $0 $step || exit $?
      done
      $0 test "$test_unit" || exit $?
      $0 shutdown || exit $?
      ;;

   git)
      for d in "$SGE_SOURCE" "$SGE_DRMAA_JAVA" "$SGE_TEST" "$SGE_EXT" "$SGE_EXT_TEST"; do
         printf '\n\nGIT PULL OF %s\n\n' "$d"
         cd "$d" || exit 1
         git pull || exit $?
      done
      ;;

   ts)       run_check_tmux "STARTING INTERACTIVE TS" ;;
   build)    run_check "STARTING BUILD AND PACKAGE CREATION WITH TS" compile ;;
   install)  run_check "STARTING INSTALLATION OF CLUSTER WITH TS" install ;;
   # Counterpart to shutdown: starts an existing installation without throwing
   # the cell away. Needed when a test shuts the qmaster down in an orderly
   # fashion and fails to bring it back (bugs/jira/3306 for instance) -- an
   # install would be needlessly destructive there.
   start)    run_check "STARTING ALREADY INSTALLED CLUSTER" start ;;
   shutdown) run_check "STARTING SHUTDOWN OF CLUSTER WITH TS" kill ;;
   dump)     run_check "STARTING DUMP OF TEST LIST" dump_test_list ;;

   clion)
      printf '\n\nSTARTING CLION FOR %s (%s)\n\n' "$CS_HOME" "$CS_PIPELINE"
      nohup "$CLION_LAUNCHER" "$CS_HOME" >/dev/null 2>&1 &
      disown 2>/dev/null || true
      ;;

   test)
      [ -n "$test_unit" ] || { printf 'test: test_unit is required\n\n' >&2; usage; }
      run_check "STARTING ALL TS TESTS OF PRODUCT CATEGORY" category "$test_unit" all 1000
      ;;

   check)
      [ -n "$test_unit" ] && [ -n "$level" ] || { printf 'check: test_unit and level are required\n\n' >&2; usage; }
      # CS_SELF_HEAL=1 enables the same self healing that gcs-ci-cd uses in its
      # check branch: when a test fails, the cluster is reinstalled fresh
      # (installer_reinstall_fresh_cluster, check.exp:4157) before the next test
      # gets that slot. A test that wrecks the qmaster then no longer takes the
      # whole runner down with it.
      # Deliberately not the default: interactively, an automatic reinstall
      # after every failure would be surprising and expensive.
      if [ "${CS_SELF_HEAL:-0}" = "1" ]; then
         args="$args re_init_on_tcl_error"
      fi
      # A check whose directory also contains checks below it would otherwise
      # run those too (get_tests_from_checktree descends). Interactively that is
      # the point -- "check <dir> <level>" is how a whole subtree is run. Under a
      # scheduler it is wrong: gcs-testscan registers every check as its own
      # entry, so the children already have theirs, and descending would run them
      # twice and drag in what VERIFIED/JENKINS_DISABLED had excluded (CS-2520).
      # Set by gcs-run-unit, never by hand.
      if [ "${CS_NO_DESCEND:-0}" = "1" ]; then
         args="$args no_descend"
      fi
      # More than one (test_unit, level) pair may follow: check.exp runs them in
      # one invocation, which pays startup and the ssh sessions once instead of
      # once per test -- about 25 s per additional test, measured 2026-08-03.
      # Everything from the fourth argument on is forwarded unchanged, so
      # "check a 0 b 0 c 0" becomes one bundled run.
      # What follows the first pair are further "check <unit> <level>" triples,
      # keyword and all. Collected into a plain string, not an array: this file
      # is dot-sourced by the runner wrappers, which run under /bin/sh.
      shift 3 2>/dev/null || shift $#
      _more=""
      while [ $# -ge 3 ] && [ "$1" = "check" ]; do
         _more="$_more check $2 $3"
         shift 3
      done
      run_check "STARTING SPECIFIC TEST" check "$test_unit" $level $_more
      ;;

   fullrun)
      [ -n "$test_unit" ] || { printf 'fullrun: runlevel is required\n\n' >&2; usage; }
      run_check "STARTING FULL TS RUN (ALL CATEGORIES, ALL TESTS, LEVEL $test_unit)" all "$test_unit"
      ;;

   reset)
      printf '\n\nRESETTING TEST RESULTS TO NOT-COMPLETED (%s)\n\n' "$CS_HOME"
      reset_results
      ;;

   # Parallel test clusters. Both actions only forward -- the logic lives in
   # line-independent tools so that 90x/91x/92x share it instead of maintaining
   # it three times.
   #
   # The scope check is necessary because the feature wrappers (92x-fixes and
   # relatives) dot-source this script: without it, "92x-fixes runners init"
   # would create runners underneath the workspace. Runners belong to the line
   # though -- a workspace is short lived and aimed at a small slice of the
   # tests, so a runner set per workspace would cost ports, disk and host load
   # without addressing the bottleneck.
   runners|testrun)
      line_root="${GCS_CLION_ROOT:-$HOME/Clion}/$CS_PIPELINE"
      if [ "$CS_HOME" != "$line_root" ]; then
         # For a feature wrapper CS_PIPELINE is "<line>-<feature>", so the
         # derived line_root does not exist at all. Point at the actual line
         # instead of naming it.
         printf '%s: only for a release line, not for "%s"\n' "$action" "$CS_PIPELINE" >&2
         printf '  use the line instead:  %s %s ...\n' "${CS_PIPELINE%%-*}" "$action" >&2
         exit 2
      fi
      tool="$CS_TOOL_DIR/gcs-$action"
      [ -x "$tool" ] || { printf '%s: helper not found: %s\n' "$action" "$tool" >&2; exit 2; }
      shift
      exec "$tool" "$CS_PIPELINE" "$@"
      ;;

   "")
      # no action: switch to source directory (useful when sourcing)
      cd "$SGE_SOURCE"
      ;;
esac
