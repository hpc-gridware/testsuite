#!/usr/bin/env bash
#
# gcs-run-unit -- run one test group on the assigned runner.
#
#   gcs-run-unit <line> <path> <level> [<path> <level> ...]
#
# The execution unit of the whole setup. It knows no scheduler: which cluster is
# responsible is taken from the environment, from a different variable depending
# on the scheduler:
#
#   ctest    CTEST_RESOURCE_GROUP_0_TS_CLUSTER = "id:3,slots:1"
#   GCS      SGE_HGR_ts_cluster                = "3"
#   manual   TS_SLOT                           = "3"
#
# The same unit therefore runs under ctest locally, as an array task in the lab
# and by hand in an emergency -- the scheduler is interchangeable, the unit is
# not.
#
# Several (path, level) pairs are passed on to check.exp as one invocation, so
# startup, the enhanced setup and the ssh sessions are paid once for all of
# them. Two different things arrive that way:
#
#   a group    tests that depend on each other via check_needs and therefore
#              HAVE to run on the same cluster, because validate_needs
#              (check.exp:3227) looks for the dependency's result file in
#              results/, which is separate per runner
#   a bundle   short groups that gcs-testscan merged only to save invocations;
#              nothing ties them together beyond the cluster they land on
#
# Both are one ctest entry, and --name carries its name -- for a bundle that is
# "<first unit>+group". The entry can only be green or red as a whole, so
# check.exp prints "### check-result ok|failed <path> <level>" per check and
# this script records each test in the ledger under the name it would have had
# on its own. That is what lets gcs-testrun repeat the one test that failed
# instead of the bundle it travelled in.
#
# Exit status: 0 only if every unit returned 0.

set -uo pipefail

# Follow symlinks: these tools are put on PATH as links, and they call each
# other via SCRIPT_DIR -- which has to be the checkout, not the link farm.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

die() { printf 'gcs-run-unit: %s\n' "$*" >&2; exit 2; }

# Where the runner fleet of a line is stored. A segment question, not a constant:
# on B the fleet is on the /scratch export, on A it is in the tree. gcs-segment
# is the single source of truth; its absence degrades to A's answer.
runners_dir() {
  local root d
  root="${GCS_CLION_ROOT:-$HOME/Clion}/$1"
  d="$("$SCRIPT_DIR/gcs-segment" runners "$root" 2>/dev/null)" || d=""
  [ -n "$d" ] || d="$root/runners"
  printf '%s' "$d"
}

# --- the cluster does not live here ------------------------------------------
#
# The health check below used to ask the LOCAL host whether a cluster answers.
# On segment A that was invisible: the TS driver was also the master_host, so
# "local" and "the cluster" were the same machine. On B the driver is server-00,
# which belongs to no cluster at all -- it appears in no role of the .sav,
# neither as submit_only_host nor as admin_only_host.
#
# The consequence was not a wrong answer but a destructive one. Every slot looked
# dead, ensure_alive() escalated to "start" and then to "install", and on
# 2026-09-01 that reinstalled sixteen HEALTHY clusters in a row; the run ended
# with zero tests executed. gcs-runners had the same bug in its health probe and
# was fixed the same way -- see cluster_sh() there.
#
# master_host is an admin host by construction, so it is the right place to ask.
# If it is the local machine -- the A case -- nothing changes and no ssh happens.
line_root() { printf '%s/%s' "${GCS_CLION_ROOT:-$HOME/Clion}" "$1"; }

# The .sav files are the testsuite's own format: a key line ":name:" followed by
# a value line ":value:". Last occurrence wins, which is what the TS itself does.
read_sav_value() {
  [ -f "$1" ] || return 0
  awk -v key=":$2:" '
    $0 == key { if ((getline v) > 0) { sub(/^:/,"",v); sub(/:$/,"",v); last = v } }
    END { if (last != "") print last }' "$1"
}

_mh_line=""
_mh_val=""
master_host() {
  if [ "$1" != "$_mh_line" ]; then
    _mh_val="$(read_sav_value "$(line_root "$1")/config/defaults-$1.sav" master_host)"
    # No .sav, no master_host: fall back to the old behaviour rather than to
    # nothing. On A that is the correct answer anyway.
    [ -n "$_mh_val" ] || _mh_val="$(hostname -s)"
    _mh_line="$1"
  fi
  printf '%s' "$_mh_val"
}

on_master() {
  local mh="$1" cmd="$2"
  if [ "$mh" = "$(hostname -s)" ]; then
    sh -c "$cmd"
  else
    timeout 60 ssh -o BatchMode=yes -o ConnectTimeout=5 \
              -o StrictHostKeyChecking=accept-new "$mh" "$cmd"
  fi
}

# --help prints the header comment above rather than a second copy of it.
case "${1:-}" in
   -h|--help|help)
      awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' \
          "$(readlink -f "${BASH_SOURCE[0]}")"
      exit 0 ;;
esac

[ $# -ge 3 ] || die "usage: gcs-run-unit [--name <ctest-name>] <line> <path> <level> [<path> <level> ...]
       further pairs run in the SAME testsuite invocation, in the order given"

# The ctest name of this test, handed in by the generated definition. ctest
# exposes no variable for it, and without it a result cannot be recorded under
# the name the rest of the tooling uses.
ctest_name=""
if [ "${1:-}" = "--name" ]; then
  ctest_name="$2"; shift 2
fi

line="$1"; shift
[ $(($# % 2)) -eq 0 ] || die "expected path/level pairs, got $# arguments"

# --- determine the slot -------------------------------------------------------
slot=""
if [ -n "${CTEST_RESOURCE_GROUP_0_TS_CLUSTER:-}" ]; then
  # format "id:3,slots:1" -- only the id is of interest here
  slot="${CTEST_RESOURCE_GROUP_0_TS_CLUSTER#*id:}"
  slot="${slot%%,*}"
elif [ -n "${SGE_HGR_ts_cluster:-}" ]; then
  slot="${SGE_HGR_ts_cluster%% *}"
elif [ -n "${TS_SLOT:-}" ]; then
  slot="$TS_SLOT"
fi
[ -n "$slot" ] || die "no slot in the environment (CTEST_RESOURCE_GROUP_0_TS_CLUSTER, SGE_HGR_ts_cluster or TS_SLOT)"

# Locate the runner wrapper. Deliberately NOT next to this script: the tools are
# version controlled, the wrappers are generated per user and must not be. Once
# the tools moved into the repository, looking beside them stopped working.
#
# The authoritative copy is the one gcs-runners writes into the runner
# directory; the symlink it additionally puts on PATH is only for convenience,
# so PATH is the fallback rather than the first choice.
runner="$(runners_dir "$line")/r$slot/config/$line-r$slot"
if [ ! -x "$runner" ]; then
  runner="$(command -v "$line-r$slot" 2>/dev/null || true)"
fi
[ -n "$runner" ] && [ -x "$runner" ] \
  || die "no runner wrapper for slot $slot of line $line  (gcs-runners $line init)"

# --- health check -------------------------------------------------------------
#
# Without it a single test poisons the whole slot: bugs/jira/3306 shuts the
# qmaster down on purpose during setup (shutdown_qmaster, 2s pause against
# socket reuse, startup_qmaster). When that restart fails the cluster is dead --
# and because a dead slot fails in ~30s instead of minutes, it attracts a
# disproportionate share of tests on the next ctest round and fails them all. In
# one observed run, 6 of the first 30 results were such phantom failures.
#
# So check before every group and repair if needed, escalating by depth of
# intervention: start first (the cell survives), then reinstall.

# The runner's own .sav sits next to its wrapper and carries both values the
# probe needs. The wrapper stays as the fallback for the port, so a fleet built
# before this change still works.
sav="$(dirname "$runner")/defaults-$(basename "$runner").sav"
port="$(read_sav_value "$sav" commd_port)"
[ -n "$port" ] || port="$(awk -F= '/^CS_MASTER_PORT=/{print $2}' "$runner")"
sge_root="$(read_sav_value "$sav" product_root)"
mh="$(master_host "$line")"

# qstat by absolute path instead of by dot-sourcing the wrapper. Sourcing would
# run gcs-pipeline on the far side -- a lot of machinery for one query -- and the
# two traps it needs there ('set --' against inherited positional parameters,
# 'set +u' against the plain-sh line script reading $1) do not survive the trip
# through ssh. The bin directory is named after the architecture; globbing it
# avoids $root/util/arch, which costs 187ms and would be paid once per test unit.
qstat_bin=""
if [ -n "$sge_root" ]; then
  for _q in "$sge_root"/bin/*/qstat; do
    [ -x "$_q" ] && { qstat_bin="$_q"; break; }
  done
fi

alive() {
  # Two stages, cheapest first. Both run ON master_host now: the port belongs to
  # the qmaster, and the qmaster is there, not here. Asking the local ss was the
  # bug -- on B it reported "nothing listening" for every healthy cluster.
  [ -n "$port" ] || return 1
  on_master "$mh" \
    "ss -ltnH 2>/dev/null | awk '{print \$4}' | sed 's/.*://' | grep -qx '$port'" \
    >/dev/null 2>&1 || return 1

  # Nothing installed to query with: the listening port is then all we know, and
  # the case this check exists for -- a qmaster gone after a test restarted it --
  # is already covered by stage one. Reporting "alive" is the safe direction: a
  # false "dead" costs a reinstall of a healthy cluster, a false "alive" costs
  # one failed test.
  [ -n "$qstat_bin" ] || return 0

  on_master "$mh" \
    "SGE_ROOT='$sge_root' SGE_CELL=default SGE_QMASTER_PORT='$port' SGE_EXECD_PORT='$((port + 1))' timeout 45 '$qstat_bin' -f" \
    >/dev/null 2>&1
}

ensure_alive() {
  alive && return 0
  printf '### slot %s: cluster does not respond -- trying start\n' "$slot"
  "$runner" start >/dev/null 2>&1
  alive && { printf '### slot %s: back up (start)\n' "$slot"; return 0; }

  printf '### slot %s: start was not enough -- reinstalling\n' "$slot"
  "$runner" install >/dev/null 2>&1
  alive && { printf '### slot %s: back up (install)\n' "$slot"; return 0; }

  printf '### slot %s: NOT REPAIRABLE -- unit will not be run\n' "$slot"
  return 1
}

# --- interrupted-run marker ---------------------------------------------------
#
# check.exp has no signal handling: no trap for SIGINT or SIGTERM. When ctest is
# stopped -- by Ctrl-C, by the IDE's stop button, or by a test timeout -- the
# test process dies on the spot and its cleanup function never runs. The cluster
# then keeps whatever the test had set up: disabled queues, added complexes, a
# modified scheduler configuration, an instrumented qmaster, leftover jobs.
#
# The health check above does not see this. A cluster left in a strange state
# answers qstat perfectly well; only a dead qmaster is caught. The next test on
# that slot would fail for reasons that have nothing to do with it.
#
# So: drop a marker before running, remove it after. A marker still present at
# the next start means the previous run did not get to the end, and the only
# reliable way back is a fresh install.
marker=""
_rdir="$(runners_dir "$line")/r$slot"
[ -d "$_rdir" ] && marker="$_rdir/.unit-in-progress"

if [ -n "$marker" ] && [ -f "$marker" ]; then
  printf '### slot %s: previous run did not finish (%s) -- reinstalling\n' \
         "$slot" "$(head -1 "$marker" 2>/dev/null)"
  "$runner" install >/dev/null 2>&1
  rm -f "$marker"
fi

ensure_alive || exit 3

# Deliberately no trap: a trap on EXIT would also fire when the shell is killed,
# and would then remove the very marker that is supposed to record the kill. The
# marker is cleared on the normal path only, at the end of this script.
# Start time, pid and name, so "gcs-teststate <line> running" can show what a
# slot is working on and tell a live unit from a marker left behind by a kill.
[ -n "$marker" ] && printf '%s\t%s\t%s\t%s\n' \
    "$(date '+%F %T')" "$$" "${ctest_name:-$1}" "$*" > "$marker"

# --- work through the group ---------------------------------------------------
# One invocation for the whole group instead of one per (path, level). Startup,
# the enhanced setup and the ssh sessions to the hosts are paid once -- measured
# on 2026-08-03 over seven tests: 356 s as seven invocations against 201 s as
# one, about 25 s per check that no longer starts its own testsuite.
#
# check.exp prints "### check-result ok|failed <path> <level>" for each check, so
# the outcome of the individual tests survives the bundling: the ledger keeps one
# entry per test even though ctest sees a single unit.
group_start=$(date +%s)
rc=0
_pairs=("$@")
_names=()
while [ $# -ge 2 ]; do
  path="$1"; level="$2"; shift 2
  _names+=("$(basename "$path").$level")
done
set -- "${_pairs[@]}"

if [ ${#_names[@]} -gt 1 ]; then
  name="bundle of ${#_names[@]}: ${_names[*]}"
else
  name="${_names[0]}"
fi
start=$(date +%s)
  # Tee into <runner>/current.log so the output can be followed WHILE the test
  # runs. Under ctest there is otherwise no way to see it: ctest captures a
  # test's output and holds it until the test ends -- its own
  # Testing/Temporary/LastTest.log.tmp* stays at the header line until then.
  # The previous group's log is kept as last.log for a post mortem.
  _log=/dev/null
  if [ -n "$_rdir" ] && [ -d "$_rdir" ]; then
    [ -f "$_rdir/current.log" ] && mv -f "$_rdir/current.log" "$_rdir/last.log"
    _log="$_rdir/current.log"
    printf '### %s  slot %s  started %s\n' "$name" "$slot" "$(date '+%F %T')" > "$_log"
  fi
  # CS_SELF_HEAL makes the testsuite reinstall itself after a failure, so the
  # next test on this slot finds a clean cluster. CS_TIMEOUT_FACTOR stretches the
  # waits inside the tests, because every runner here shares the host set with
  # the others -- see CS-2481 and ts_scale_timeout. The default of 3 covers the
  # 1.6 to 2.4 that were measured, with room to spare; it only postpones the
  # point at which a test gives up, so a real hang still ends in a timeout.
  # pipefail is set, so the pipeline still reports the testsuite's status, not
  # tee's.
  # GCS_L10N_CACHE is passed through rather than set here: a parallel run should
  # not quietly behave differently from the same test started by hand.
  _args=()
  for ((_i = 0; _i < ${#_pairs[@]}; _i += 2)); do
    _args+=(check "${_pairs[$_i]}" "${_pairs[$((_i + 1))]}")
  done
  # CS_NO_DESCEND=1 keeps a check to its own directory. Nine checks in the 92x
  # checktree sit in a directory that also holds further checks; since CS-2520
  # they have ctest entries of their own, and so do their children. Without this
  # the parent's entry would run the children a second time -- qconf.0 would
  # drag in qconf_add_remove_queues.0 (1223 s) -- and would also run what the
  # VERIFIED/JENKINS_DISABLED filter deliberately kept out of the run.
  # CS-984: runners verify after every check that its cleanup function restored
  # the cluster, and a check that did not is a failure. Default fail rather than
  # report, because a leftover is not a cosmetic finding: it is the next check on
  # this slot that pays for it, and the funnel is what tells a real one from an
  # artifact -- a cleanup failure goes through phases 2 and 3 like any other, and
  # only phase 3 decides.
  #
  # Set here and not in the runner wrappers so all three phases get it from one
  # place, and overridable so a run can be put back to "report" without an edit.
  # A check started by hand stays unverified unless asked, like GCS_L10N_CACHE.
  if CS_SELF_HEAL=1 CS_NO_DESCEND=1 CS_TIMEOUT_FACTOR="${CS_TIMEOUT_FACTOR:-3}" \
     GCS_L10N_CACHE="${GCS_L10N_CACHE:-0}" \
     GCS_CLEANUP_CHECK="${GCS_CLEANUP_CHECK:-fail}" \
     "$runner" "${_args[@]}" 2>&1 | tee -a "$_log"; then
    printf '### %s ok (%ss, slot %s)\n' "$name" "$(( $(date +%s) - start ))" "$slot"
  else
    printf '### %s FAILED (%ss, slot %s)\n' "$name" "$(( $(date +%s) - start ))" "$slot"
    rc=1
  fi

# Record the outcome in the ledger that survives across runs and is dropped on a
# rebuild -- see gcs-teststate. ctest's own LastTestsFailed.log is a snapshot of
# the last run that had failures, which is not enough to work through a test run
# over several sessions.
if [ -n "$ctest_name" ] && [ -x "$SCRIPT_DIR/gcs-teststate" ]; then
  _elapsed=$(( $(date +%s) - group_start ))
  "$SCRIPT_DIR/gcs-teststate" "$line" record "$ctest_name" \
      "$([ $rc -eq 0 ] && echo ok || echo fail)" "$_elapsed" \
      "r$slot" >/dev/null 2>&1 || true

  # For a bundle the entry above says only that something in it failed. The
  # per check lines tell which one, so each test also gets its own entry under
  # the name gcs-testscan would have given it on its own. Whoever works through
  # the failures then sees tests, not bundles.
  #
  # The duration is not split up: what was measured is the invocation, and
  # inventing a share per test would put numbers into check_durations.txt that
  # nobody measured. They are recorded with 0 so the scheduler keeps using the
  # value it already has for them.
  if [ ${#_names[@]} -gt 1 ] && [ -f "$_log" ]; then
    while IFS=' ' read -r _res _path _level; do
      [ -n "$_path" ] || continue
      _rel="${_path#$HOME/Clion/$line/}"
      _single="${_rel//\//.}.$_level"
      [ "$_single" = "$ctest_name" ] && continue
      "$SCRIPT_DIR/gcs-teststate" "$line" record "$_single" \
          "$([ "$_res" = ok ] && echo ok || echo fail)" 0 "r$slot" >/dev/null 2>&1 || true
    done < <(grep '^### check-result ' "$_log" | sed 's/^### check-result //')
  fi
fi

# Normal end -- whatever the tests returned, this script got to run its course,
# so the cluster is in whatever state the tests' own cleanup left it.
[ -n "$marker" ] && rm -f "$marker"
exit $rc
