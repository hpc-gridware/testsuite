#!/usr/bin/expect --
# as-root <host> <command...>
#
# Runs a command as root on <host>. Three routes are tried, in this order:
#
#   1. ssh as root with a key   -- nothing on the wire, nothing to go stale
#   2. ssh as the current user, then passwordless sudo
#   3. ssh as root with the password from get_pwd.sh (the GPG wallet)
#
# Route 2 was added because routes 1 and 3 can both be closed at the same time:
# root may refuse key logins while the wallet key is simply gone. That is not a
# hypothetical -- it happened, and the wallet's own error ("cold gpg-agent
# cache?") points at the wrong cause, so a permanent failure reads as a
# transient one. Where sudo is configured without a password it is also the
# better route: no root password exists anywhere in the chain.
#
# The password is never printed and never written to disk.
#
# Meant for the few places where a setup genuinely needs root, for example
# mirroring setuid-root binaries between installations. For everything else the
# rule stands: do not work as root.

if {$argc < 2} {
   puts stderr "usage: as-root <host> <command...>"
   exit 2
}

set host [lindex $argv 0]
set cmd  [join [lrange $argv 1 end] " "]

## @brief Quote a string so a remote shell receives it as one argument
#
# ssh joins its command arguments with spaces and hands the result to the
# remote shell, which parses it again -- so any quoting not carried INSIDE the
# string is lost. Wrapping in single quotes and escaping embedded ones survives
# that second parse. Without it a command carrying quoted paths (the rsync call
# in gcs-runners does) falls apart on the far side.
#
# @param s the string to quote
# @return the string as a single-quoted shell word
proc shell_quote {s} {
   return "'[string map {' '\\''} $s]'"
}

# The password helper sits next to this script. GCS_PW_COMMAND overrides it,
# so a site that obtains the root password differently only has to point at its
# own helper -- the contract is "print the password on stdout, nothing else".
if {[info exists env(GCS_PW_COMMAND)]} {
   set pwfile $env(GCS_PW_COMMAND)
} else {
   set pwfile [file join [file dirname [file normalize [info script]]] get_pwd.sh]
}

# Route 1: if root accepts our key, the wallet is never touched -- no gpg call,
# no password on the wire, and nothing to go stale in an agent cache.
set pw ""
set have_key 0
set use_sudo 0
if {[catch {exec ssh -o BatchMode=yes -o ConnectTimeout=5 -l root $host true}] == 0} {
   set have_key 1
} elseif {[catch {exec ssh -o BatchMode=yes -o ConnectTimeout=5 $host sudo -n true}] == 0} {
   # Route 2. Probed with "sudo -n true" rather than assumed: -n makes sudo
   # fail instead of prompting, so a host that would ask for a password is
   # rejected here and cannot hang the caller later.
   set use_sudo 1
} else {
   # Route 3, the fallback for hosts set up for neither.
   if {![file executable $pwfile]} {
      puts stderr "as-root: no key and no passwordless sudo on $host, and the password helper is not executable: $pwfile"
      exit 3
   }
   if {[catch {set pw [string trim [exec $pwfile]]} err]} {
      puts stderr "as-root: no root access to $host -- key refused, no passwordless sudo, no password available ($err)"
      puts stderr "as-root: if the wallet key is gone this is permanent, not a cold gpg-agent cache; grant passwordless sudo or point GCS_PW_COMMAND at another helper."
      exit 3
   }
}

set timeout -1
log_user 0
if {$use_sudo} {
   spawn ssh -o StrictHostKeyChecking=accept-new $host \
             "sudo -n sh -c [shell_quote $cmd]"
} else {
   spawn ssh -o StrictHostKeyChecking=accept-new -o NumberOfPasswordPrompts=1 \
             root@$host $cmd
}
expect {
   -re "(?i)password:" {
      if {$use_sudo} {
         # "sudo -n true" succeeded a moment ago, so a prompt here is not ours
         # to answer -- answering it blindly would put the root password in
         # front of whatever asked.
         puts stderr "as-root: unexpected password prompt from $host although sudo -n succeeded"
         exit 4
      }
      if {$have_key} {
         puts stderr "as-root: key was refused by $host, falling back to the wallet"
         if {![file executable $pwfile] ||
             [catch {set pw [string trim [exec $pwfile]]}]} {
            puts stderr "as-root: no password available either"
            exit 3
         }
         set have_key 0
      }
      send -- "$pw\r"; exp_continue
   }
   -re "(?i)permission denied" {
      puts stderr "as-root: root access refused on $host"
      exit 4
   }
   eof
}
log_user 1
catch wait result
set rc [lindex $result 3]
puts -nonewline $expect_out(buffer)
exit $rc
