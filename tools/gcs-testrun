#!/usr/bin/env bash
#
# gcs-testrun -- complete test run of one line, in three phases.
#
#   gcs-testrun <line> [N] [-- <further ctest arguments>]
#
#   <line>   92x, 91x, ...          N   runners, default 8
#
# Phase 1 runs in parallel across N runners, phase 2 reruns its failures with
# -j 4, and phase 3 gives whatever is left one cluster at a time. Only phase 3
# decides. The summary sorts the failures into three groups accordingly:
# real defects, artifacts of load (cleared only in phase 3), and artifacts of
# parallel execution (cleared already in phase 2).
#
# Phases 2 and 3 select by test NAME, never by ctest's --rerun-failed. That
# matters since bundling: a bundle is one ctest entry, so --rerun-failed would
# repeat all of its tests because one of them failed. The names come from the
# ledger, which gcs-run-unit fills per test, and they resolve to the entries
# gcs-testscan writes with the label `single`.
#
# Own ctest arguments after `--` restrict the run -- and then the ledger is
# NOT cleared, because 600 tests that were not selected are not "still to do".
# What is already red at that moment is written to failed-before.txt and left
# out of the funnel, so a run of two tests is not blamed for yesterday's
# failures. Without `--` the ledger is cleared and every failure goes through
# all three phases.
#
#   gcs-testrun 92x 32                       the whole line
#   gcs-testrun 92x 32 -- -R 'qrsh'          only what matches, ledger kept
#   gcs-testrun 92x 32 -- -LE single         explicitly without the single entries
#
# The run leaves its files under runners/lists/runs/<timestamp>/: summary.txt,
# the ctest logs of the three phases, manifest.txt and units.tsv (the plan),
# failed-*.log (what each phase repeated) and loadprofile.txt.
#
# Why more than one phase
# -----------------------
# The testsuite's wait helpers use absolute timeouts (30 s for a configuration
# change, 60 s for load values to arrive) and thereby assume implicitly that
# they have the hosts to themselves. Under eight parallel clusters these are
# exceeded without any real defect being present.
#
# Measured on 2026-07-31 against the 92x line: of 21 failures from the parallel
# run, 13 passed serially -- twelve of them two to three times faster. The same
# work, stretched out under load. Only the remaining 8 were real defects.
#
# A single-phase parallel run would therefore report 13 failures that are none.
# A purely serial run would need 18.65 h instead of 3.13 h. The two-phase run
# does not claim that parallel execution yields the same result -- it checks.
#
# The actual fix is CS-2481 (scalable wait timeouts in the testsuite). After
# that, phase 2 becomes unnecessary or at least short.

set -uo pipefail

# Follow symlinks: these tools are put on PATH as links, and they call each
# other via SCRIPT_DIR -- which has to be the checkout, not the link farm.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

die() { printf 'gcs-testrun: %s\n' "$*" >&2; exit 2; }

# --help prints the header comment above: it is the documentation, and a second
# copy of it in a here-document would be the one that goes stale.
usage() {
   awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' \
       "$(readlink -f "${BASH_SOURCE[0]}")"
   exit 0
}
case "${1:-}" in -h|--help|help) usage;; esac

line="${1:?usage: gcs-testrun <line> [N] [-- <ctest-args>]   (--help for details)}"; shift
n=8
[ $# -gt 0 ] && [[ "${1:-}" =~ ^[0-9]+$ ]] && { n="$1"; shift; }
[ "${1:-}" = "--" ] && shift

D="$HOME/Clion/$line/runners/lists"
[ -d "$D" ] || die "no runner lists under $D  (gcs-runners $line init)"

stamp="$(date '+%Y%m%d-%H%M%S')"
RUN="$D/runs/$stamp"
mkdir -p "$RUN"

log() { printf '\n=== %s  (%s)\n' "$*" "$(date '+%H:%M:%S')" | tee -a "$RUN/summary.txt"; }

# --- regenerate the test list -------------------------------------------------
# Always, never from a cache: a checkout can add and remove tests, and a stale
# list breaks with "path not found in checktree". The scan costs 0.14 s, so
# there is nothing to save.
log "phase 0: building the test list"
"$SCRIPT_DIR/gcs-testscan" "$line" split "$n" --out "$D" 2>&1 | tee -a "$RUN/summary.txt"
cp -p "$D/manifest.txt" "$D/units.tsv" "$RUN/" 2>/dev/null

# Keep the IDE run configurations in step with the checktree. Only for a project
# that already has generated ones -- their presence is the opt-in, so nobody who
# never asked for them finds 700 files appearing in their .idea. A checkout that
# added or removed tests would otherwise leave entries pointing at nothing, and
# the whole point of regenerating the list on every run is that it cannot go
# stale.
_ide="$HOME/Clion/$line/.idea/runConfigurations"
if compgen -G "$_ide/gcs_ts_*.xml" > /dev/null 2>&1; then
  log "phase 0b: refreshing IDE run configurations"
  "$SCRIPT_DIR/gcs-testscan" "$line" clion-configs "$_ide" --jobs "$n" 2>&1 \
    | tee -a "$RUN/summary.txt"
fi

# --- clear the ledger ---------------------------------------------------------
# gcs-teststate keeps its results until the installed binaries change, which is
# right for working through failures test by test, but wrong in front of a run
# that repeats everything anyway: the results of the previous run stay in the
# ledger, and "summary" then reports 100 % progress while this run is on its
# fifth unit. A change to the testsuite alone does not touch sge_qmaster, so the
# ledger does not invalidate itself here.
#
# Only for a complete run. With ctest arguments the caller has restricted the
# set -- what is not in it would be dropped to "not yet run" without ever being
# repeated, and the ledger would claim less knowledge than it has.
if [ $# -eq 0 ]; then
  log "phase 0c: clearing the test state ledger"
  "$SCRIPT_DIR/gcs-teststate" "$line" reset 2>&1 | tee -a "$RUN/summary.txt"
else
  log "phase 0c: keeping the ledger -- run restricted by ctest arguments ($*)"
fi

# --- health of the clusters ---------------------------------------------------
# A cluster whose execd has stopped processing its running jobs (CS-2495) is
# invisible in every other check: the port is open, the load arrives, jobs are
# accepted. What it produces is a fixed set of failures -- ctest pins each test to
# one cluster -- that read like product defects and cost a day to attribute. A
# minute of probing in front of a two hour run is the cheapest insurance there is.
#
# Aborting rather than warning: the run would otherwise report failures that say
# nothing about the code under test. GCS_SKIP_HEALTH=1 skips the check for the
# case where one knowingly runs against a degraded set.
if [ -z "${GCS_SKIP_HEALTH:-}" ]; then
  log "phase 0d: probing the clusters"
  if ! "$SCRIPT_DIR/gcs-runners" "$line" health "$n" 2>&1 | tee -a "$RUN/summary.txt"; then
    log "aborted -- unhealthy cluster(s), see above  (GCS_SKIP_HEALTH=1 runs anyway)"
    exit 2
  fi
else
  log "phase 0d: cluster probe skipped (GCS_SKIP_HEALTH)"
fi

# --- phase 1: parallel --------------------------------------------------------
log "phase 1: $n runners in parallel"
# What failed before this run started. The ledger survives across runs, so
# without this the reruns below would pick up failures nobody re-ran. For a
# complete run phase 0c has just cleared it and this is empty.
"$SCRIPT_DIR/gcs-teststate" "$line" failed 2>/dev/null | sort > "$RUN/failed-before.txt" || true

# -LE single skips the per-unit definitions gcs-testscan writes alongside the
# bundles. They exist so that phases 2 and 3 can rerun the one test that failed
# instead of the whole bundle around it; running them here would run everything
# twice.
t1=$(date +%s)
ctest --test-dir "$D" -j "$n" --resource-spec-file "$D/ts_cluster.json" \
      -LE single \
      --output-junit "$RUN/parallel.xml" --output-on-failure "$@" \
      > "$RUN/parallel.log" 2>&1
rc1=$?
t1=$(( $(date +%s) - t1 ))
grep -E "tests passed|tests failed out of" "$RUN/parallel.log" | tee -a "$RUN/summary.txt"
printf '  duration: %dm%02ds\n' $((t1/60)) $((t1%60)) | tee -a "$RUN/summary.txt"

# The tests that failed in this run, by name, one per line. Taken from the
# ledger rather than from LastTestsFailed.log: with bundling the latter names
# bundles, and what has to be rerun are the tests inside them. gcs-run-unit
# records one ledger entry per test even when they ran together.
failed_names() {
  "$SCRIPT_DIR/gcs-teststate" "$line" failed 2>/dev/null | sort \
    | comm -13 "$RUN/failed-before.txt" - 
}

# A ctest -R expression that matches exactly those names. The dots are escaped:
# unescaped they are "any character", which would let one name select others.
names_to_regex() {
  sed 's/[.+]/\\&/g' | paste -sd'|' - | sed 's/^/^(/; s/$/)$/'
}

failed1=$(failed_names | grep -c . || echo 0)
if [ "$failed1" -eq 0 ]; then
  log "phase 2 skipped -- no failures"
  exit 0
fi
failed_names > "$RUN/failed-parallel.log"

# --- phase 2: uncontended -----------------------------------------------------
# What distinguishes this phase from phase 1 is not that it is serial but that
# the units stop competing for the same handful of execution hosts. Four at a
# time is already six to eight times less contention than phase 1, which is the
# regime the timing related failures need in order to pass -- and it costs a
# fraction of the wall clock.
#
# That matters, because phase 2 is not an epilogue. Measured over the four runs
# kept under runs/: it took 22 to 50 percent of the total, and its length tracks
# the number of failures almost linearly, between 2.6 and 6.3 minutes each:
#
#   12 runners, 19 failures -> 114m49s      16 runners,  7 failures -> 24m42s
#   12 runners,  9 failures ->  57m03s      24 runners, 12 failures -> 31m32s
#
# More runners in phase 1 means more contention, more artifacts and therefore a
# longer phase 2 -- going from 16 to 24 runners saved 15 minutes in phase 1 and
# gave 7 of them back here. Shortening this phase is what keeps that trade
# worthwhile.
#
# The other clusters keep running but stay idle, so a conflict over a resource
# that an idle cluster also occupies would persist either way -- with one unit
# at a time as much as with four.
#
# GCS_PHASE2_JOBS=1 restores the strictly serial behaviour for a run where the
# verdict has to be beyond argument.
_p2_jobs="${GCS_PHASE2_JOBS:-4}"
# Never more than there are clusters: with fewer runners than that, ctest would
# be asked for a concurrency the resource specification cannot serve.
[ "$_p2_jobs" -gt "$n" ] && _p2_jobs="$n"
log "phase 2: rerunning $failed1 failures with -j $_p2_jobs"
t2=$(date +%s)
ctest --test-dir "$D" -j "$_p2_jobs" --resource-spec-file "$D/ts_cluster.json" \
      -R "$(failed_names | names_to_regex)" \
      --output-junit "$RUN/serial.xml" --output-on-failure \
      > "$RUN/serial.log" 2>&1
rc2=$?
t2=$(( $(date +%s) - t2 ))
printf '  duration: %dm%02ds\n' $((t2/60)) $((t2%60)) | tee -a "$RUN/summary.txt"

failed2=$(failed_names | grep -c . || echo 0)
failed_names > "$RUN/failed-phase2.log"

# --- phase 3: one cluster at a time --------------------------------------------
# Phase 2 is a filter, not a verdict. Two full runs of the same code five hours
# apart classified the same tests differently -- 3 real defects against 8, with
# only two tests agreed on by both, and one test called a defect by one run and
# an artifact by the other. Phase 2 took 53 s per failure in one run and 77 s in
# the other, which says it was itself under load; and a phase that is under load
# cannot tell load artifacts from defects, which is the whole point of it.
#
# So the answer is given here, with nothing else running. This is affordable
# precisely because it only sees what phase 2 could not clear: eighteen failures
# went into phase 2 in the run of 2026-08-03, eight came out. Rerunning those
# eight one at a time costs a fraction of what rerunning all eighteen serially
# used to cost, and it is the only number anyone should act on.
if [ "$failed2" -eq 0 ]; then
  log "phase 3 skipped -- phase 2 cleared everything"
  t3=0
else
  log "phase 3: rerunning $failed2 remaining failures one at a time"
  t3=$(date +%s)
  ctest --test-dir "$D" -j 1 --resource-spec-file "$D/ts_cluster.json" \
        -R "$(failed_names | names_to_regex)" \
        --output-junit "$RUN/single.xml" --output-on-failure \
        > "$RUN/single.log" 2>&1
  rc3=$?
  t3=$(( $(date +%s) - t3 ))
  printf '  duration: %dm%02ds\n' $((t3/60)) $((t3%60)) | tee -a "$RUN/summary.txt"
fi

# --- verdict ------------------------------------------------------------------
log "result"
{
  if [ "$failed2" -eq 0 ]; then
    echo "real defects: none -- every failure of phase 1 passed in phase 2"
  else
    echo "real defects (failed in phase 3, one cluster at a time):"
    grep -E '\*\*\*Failed|\*\*\*Timeout' "$RUN/single.log" \
      | sed -E 's/.*Test +#[0-9]+: ([^ ]+).*/  \1/' | sort
    echo
    echo "artifacts of load, seen only under a busy cluster (passed in phase 3):"
    grep -E 'Passed' "$RUN/single.log" \
      | sed -E 's/.*Test +#[0-9]+: ([^ ]+).*/  \1/' | sort
  fi
  echo
  echo "artifacts of parallel execution (passed already in phase 2) -- see CS-2481:"
  grep -E 'Passed' "$RUN/serial.log" \
    | sed -E 's/.*Test +#[0-9]+: ([^ ]+).*/  \1/' | sort
} | tee -a "$RUN/summary.txt"

if [ "$failed2" -eq 0 ]; then
  real_defects=0
else
  real_defects=$(grep -cE '\*\*\*Failed|\*\*\*Timeout' "$RUN/single.log")
fi
printf '\n  total: %dm%02ds  |  %d real defects  |  %d artifacts (%d cleared in phase 2, %d in phase 3)\n' \
  $(( (t1+t2+t3)/60 )) $(( (t1+t2+t3)%60 )) "$real_defects" "$(( failed1 - real_defects ))" \
  "$(( failed1 - failed2 ))" "$(( failed2 - real_defects ))" | tee -a "$RUN/summary.txt"
printf '  output: %s\n' "$RUN" | tee -a "$RUN/summary.txt"

[ "$real_defects" -eq 0 ] && exit 0 || exit 1
