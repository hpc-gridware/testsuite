#!/usr/bin/env bash
#
# gcs-runners -- N parallel testsuite clusters on ONE code base of a line.
#
# Purpose: cut the wall clock of a testsuite run by having several clusters work
# on the test list at the same time. The model is testsuite/jenkins/gcs-ci-cd,
# which runs exactly this in the lab: eight clusters (gcs-ci-cd-0..7) on the code
# base of cluster 0.
#
# Not to be confused with gcs-feature-workspace: that creates ONE workspace per
# feature with its own worktrees, hence its own code base. Here it is the other
# way round -- the code base of the line is shared, and only what a cluster
# strictly needs for itself is separated:
#
#   per runner              shared with the line
#   ------------------      -----------------------------
#   commd_port              source_dir
#   cluster_name            testsuite_root_dir / checktree_root_dir
#   product_root (inst/)    additional_checktree_dirs
#   results_dir             host/user/fs config, build artifacts
#
# Usage:
#   gcs-runners <line> init    [N]        # directories, .sav, wrapper
#   gcs-runners <line> install [N] [-s]   # mirror inst/ from the line + install
#                                         # parallel by default; -s = serial
#   gcs-runners <line> status
#   gcs-runners <line> health [N]         # does every execd still enforce h_rt?
#   gcs-runners <line> teardown [N] [--force] [-s]  # parallel by default; -s = serial
#
# Ports are NOT invented: only registered, even ports from <user>,portlist of the
# testsuite user configuration are eligible, because that is what vends the
# matching gid_range. Ports >= 8100 stay reserved for feature workspaces by
# convention.
#
# Why the .sav is additionally linked into <line>/config/: gcs-feature-workspace
# determines occupied ports with a glob over <root>/*/config/defaults-*.sav.
# Without that symlink a later ts-init would see the runner ports as free and
# hand one of them to a workspace.
#
# Where the fleet is stored is a segment question, not a constant -- see
# runners_dir(). On A it is <line>/runners as it always was, on B it is on the
# /scratch export. Nothing else in this script cares which of the two it is.

set -euo pipefail

CLION_ROOT="${GCS_CLION_ROOT:-$HOME/Clion}"

# Everything derived from this lands in symlinks, generated wrappers and .sav
# files that OTHER hosts read: the cluster hosts mount the home as /home/<user>
# and have no /export/home at all, which is what $HOME expands to on the server.
# A path written in the server's spelling is a dangling link everywhere else --
# that is how <line>-<feature> on PATH came to resolve only on server-00.
# /home is the spelling that holds on every host, and it is what the .sav files
# have always carried; fold onto it once, here, rather than at each use.
case "$CLION_ROOT" in /export/home/*) CLION_ROOT="/home${CLION_ROOT#/export/home}" ;; esac
# Follow symlinks: these tools are put on PATH as links, and they call each
# other via SCRIPT_DIR -- which has to be the checkout, not the link farm.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# Window from which runner ports are handed out. One window for every line: the
# runners of two lines must never compete for the same ports, and since the
# 2026-08-27 remap only one line keeps a fleet, so one window is all it takes.
#
# The map is what the ports actually are, not a preference:
#
#   8000..8008   release lines
#   8010..8098   feature workspaces  (window [8010,8100), see gcs-feature-workspace)
#   8100..8198   runners             (window [8100,8200))
#
# Remapped on 2026-08-27: the runner fleet needed 48 ports and only 45 fit below
# 8100, so runners and workspaces swapped windows -- the workspaces are few and
# fit in what the fleet vacated. The 91x runner ports (8200..8262) went away with
# that line's fleet; everything from 8200 up is free. Two workspaces still sit on
# 8106/8108 from before the swap. They stay registered and used_ports() keeps
# them out of the fleet, which is why the window holds 50 ports but vends 48.
#
# GCS_RUNNER_PORT_MIN/MAX still override, so a one-off run can use a window that
# is not mapped here. Keep this in sync with <user>,portlist of the testsuite
# user configuration -- a window without registered ports yields nothing, since
# it is the portlist that vends the matching gid_range.
line_port_window() {
  printf '%s %s' "${GCS_RUNNER_PORT_MIN:-8100}" "${GCS_RUNNER_PORT_MAX:-8200}"
}
# Probe parameters of "health". Ten seconds is far above the one second at which
# the execd checks its limits, and short enough to keep the check cheap. The wait
# has to cover the scheduler interval on top of the limit, otherwise a healthy
# cluster whose job has not been placed yet looks broken.
HEALTH_LIMIT="${GCS_HEALTH_LIMIT:-10}"
HEALTH_WAIT="${GCS_HEALTH_WAIT:-45}"

die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*" >&2; }

usage() { sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0" >&2; exit "${1:-0}"; }

line_root()   { printf '%s/%s' "$CLION_ROOT" "$1"; }

# Where the runner fleet of a line is stored.
#
# Not <line-root>/runners unconditionally any more: on segment B the fleet
# belongs on the /scratch export, for the same reason inst/ does. install mirrors
# the line's inst/ into every runner as root -- utilbin/<arch>/testsuidroot is
# setuid root and cannot be copied otherwise -- and /scratch/ebablick/Clion is
# the export that carries no_root_squash. Under root_squash that write is refused
# and the mirror fails.
#
# gcs-segment answers the A/B question for every tool here, and it is asked the
# same way gcs-pipeline asks it for inst: with the in-tree location as the
# fallback, which is precisely segment A's own answer. A missing or broken helper
# therefore degrades to what A has always done rather than to nothing.
#
# Memoised because runner_root() is called once per runner per operation, and a
# 48 runner fleet would otherwise fork the helper a few hundred times for an
# answer that cannot change within one invocation.
_rdir_line=""
_rdir_val=""
runners_dir() {
  if [ "$1" != "$_rdir_line" ]; then
    _rdir_val="$("$SCRIPT_DIR/gcs-segment" runners "$(line_root "$1")" 2>/dev/null)"       || _rdir_val="$(line_root "$1")/runners"
    [ -n "$_rdir_val" ] || _rdir_val="$(line_root "$1")/runners"
    _rdir_line="$1"
  fi
  printf '%s' "$_rdir_val"
}

# Directory that holds the line wrapper as it is reachable on PATH.
#
# One hop only: the tools themselves are installed as symlinks, so "readlink -f"
# resolves right through the link farm into the checkout -- and a runner wrapper
# dropped there is neither on PATH nor something that belongs in git.
line_bindir() {
  local lroot="$1" line="$2" p
  p="$lroot/config/$line"
  p="$(readlink "$p" 2>/dev/null || printf '%s' "$p")"
  case "$p" in /*) : ;; *) p="$lroot/config/$p" ;; esac
  dirname "$p"
}

runner_root() { printf '%s/r%s' "$(runners_dir "$1")" "$2"; }

# How many runners a line has -- the default for every command that takes an
# optional count.
#
# -mindepth 1 is not cosmetic. find also returns the start directory itself, and
# its basename "runners" matches 'r*', so the count came out one too high. Every
# call that relied on the default therefore walked into a non-existent r<N+1>
# and died there: install had mirrored all N runners and installed none of them
# by that point, which looked like a successful mirror rather than a failure.
# The trailing slash is not decoration either: the storage move once made
# runners/ a symlink, and find is handed the start directory as it is -- without
# the slash it refuses to descend into a link and the count is 0, which silently
# sizes every fleet operation to nothing. runners_dir() returns a real directory
# today, but a hand-placed link there must not resurrect that failure.
runner_count() {
  find "$(runners_dir "$1")/" -mindepth 1 -maxdepth 1 -name 'r*' -type d 2>/dev/null | wc -l
}
runner_name() { printf '%s-r%s' "$1" "$2"; }

# Has this line a fleet at all? Not the same question as whether the directory
# exists: init creates it before there is anything in it and teardown leaves it
# behind, so an empty one is the normal state of a line without runners. Asking
# the directory instead let an unmatched "r*/" glob through, which cmd_status
# then printed as a runner called "r*".
have_runners() { [ "$(runner_count "$1")" -gt 0 ]; }

# Read the value of a key from a .sav. A .sav carries the previous generation as
# an "<obj>.old" block BEFORE the current one, so the LAST occurrence is the
# authoritative value.
read_sav_value() {
  [ -f "$1" ] || return 0
  awk -v key=":$2:" '
    $0 == key { if ((getline v) > 0) { sub(/^:/,"",v); sub(/:$/,"",v); last = v } }
    END { if (last != "") print last }' "$1"
}

# Processes from an earlier life that still address a runner's ports.
#
# Diagnosed on r21 after two days of installs failing for a reason that was
# nowhere near the symptom. A testsuite check starts
# "qping -dump <host> <port> qmaster 1" as root (setup_qping_dump,
# tcl_files/remote_procedures.tcl:161; used by bugs/issuezilla/126 and 2372).
# Interrupt the check before cleanup_qping_dump_output runs and
# close_spawn_process never happens: the qping is reparented to init and keeps
# reconnecting.
#
# Reinstalling does NOT clear that. The install recreates the cell including a
# fresh TLS CA, so the stale client rejects every new certificate, aborts the
# handshake and retries -- nine connection attempts per forty seconds, for days.
# Each qmaster start then logs one "commlib error: got select error (Broken
# pipe)", which setup_check_messages_files reports as an unexpected error in a
# freshly installed cluster. The install fails, and nothing in the message points
# at the actual cause.
#
# Reported, never killed: it may be a diagnosis somebody is running on purpose,
# and what to do about it depends on what it is.
report_foreign_port_users() {
  local port="$1" tree="$2" snapshot found
  [ -n "$port" ] && [ -n "$tree" ] || return 0

  # Take the snapshot first and filter afterwards. Filtering in the same
  # pipeline puts grep's own command line -- which contains the port we search
  # for -- into the very output we are searching.
  local mygrp
  mygrp="$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')"
  snapshot="$(ps -eo pgid=,pid=,user=,lstart=,args= 2>/dev/null)" || return 0

  # Drop our own process group. Not only the caller: a command substitution
  # forks a subshell that inherits the caller's command line, so if that command
  # line mentions the port -- as it does whenever someone passes it -- the check
  # reports its own subshells and the real finding drowns in them. Excluding
  # ancestors is not enough, those subshells are children.
  #
  # Two conditions, because either alone is too coarse. The port as a standalone
  # argument is how clients take it -- but a shell that merely mentions the
  # number matches too. Being started from this line's tree is what a leftover
  # cluster client has -- but so has every daemon of every runner. Together they
  # describe what we are after: something out of this installation, addressing
  # this port.
  #
  # The daemons themselves read the port from the environment, so a runner's own
  # qmaster, execd and shadowd do not match and need no special case. A client
  # started from a different tree is missed; that is the price for a check that
  # stays quiet when nothing is wrong.
  found="$(printf '%s\n' "$snapshot" \
           | awk -v want="$port" -v want2="$((port + 1))" -v grp="$mygrp" -v tree="$tree" '
               $1 == grp { next }
               index($0, tree) == 0 { next }
               $0 ~ "(^| )(" want "|" want2 ")( |$)" { $1 = ""; sub(/^ +/, ""); print }')" || true

  [ -n "$found" ] || return 0

  info "  !! still addressing port $port/$((port + 1)):"
  printf '%s\n' "$found" | sed 's/^/       /' >&2
  info "     Left untouched. An interrupted check can leave a client behind that"
  info "     survives the install and then rejects its new TLS certificate, which"
  info "     shows up as an unexpected commlib error and fails the install."
}

# Every port some configuration already claims, plus everything that listens.
used_ports() {
  local f
  for f in "$CLION_ROOT"/*/config/defaults-*.sav \
           "$CLION_ROOT"/*-features/*/config/defaults-*.sav; do
    [ -f "$f" ] || continue
    read_sav_value "$f" commd_port
  done
  ss -ltnH 2>/dev/null | awk '{print $4}' | sed 's/.*://' | grep -E '^[0-9]+$' || true
}

# Registered, even, free ports below the workspace boundary, ascending.
free_runner_ports() {
  local line="$1" cfg ucf p used pmin pmax
  read -r pmin pmax <<<"$(line_port_window "$line")"
  cfg="$(line_root "$line")/config/defaults-$line.sav"
  [ -f "$cfg" ] || die "line configuration not found: $cfg"
  ucf="$(read_sav_value "$cfg" user_config_file)"
  [ -n "$ucf" ] && [ -f "$ucf" ] || die "testsuite user configuration not readable: ${ucf:-<unset>}"
  used=" $(used_ports | sort -un | tr '\n' ' ') "
  for p in $(read_sav_value "$ucf" "$USER,portlist" | tr ' ' '\n' | sort -n); do
    case "$p" in *[!0-9]*|"") continue ;; esac
    [ "$p" -ge "$pmin" ] || continue
    [ "$p" -lt "$pmax" ] || continue
    [ $((p % 2)) -eq 0 ] || continue
    case "$used" in *" $p "*|*" $((p+1)) "*) continue ;; esac
    printf '%s\n' "$p"
  done
}

# Derive the runner .sav from the line configuration: repoint ONLY port, cluster
# name, product_root and results_dir. source_dir/testsuite_root_dir/
# checktree_root_dir stay on the line -- that is the whole point of the exercise.
gen_sav() {
  local src="$1" dst="$2" port="$3" rroot="$4"
  python3 - "$src" "$dst" "$port" "$rroot" <<'PY'
import sys
src, dst, port, rroot = sys.argv[1:5]
repl = {
    "commd_port":   port,
    "cluster_name": f"p{port}",
    "product_root": f"{rroot}/inst",
    "results_dir":  f"{rroot}/results",
}
lines = open(src).read().split("\n")
hits = {k: 0 for k in repl}
for i, l in enumerate(lines):
    if l.startswith(":") and l.endswith(":") and l[1:-1] in repl:
        key = l[1:-1]
        lines[i+1] = ":" + repl[key] + ":"
        hits[key] += 1
missing = [k for k, n in hits.items() if n == 0]
if missing:
    sys.exit(f"keys not found: {missing}")
open(dst, "w").write("\n".join(lines))
PY
}

cmd_init() {
  local line="${1:?line required}" want="${2:-}"
  local lroot rroot name cfg dst_cfg link wrapper canon i port
  lroot="$(line_root "$line")"
  [ -d "$lroot" ] || die "line root missing: $lroot"
  # Before anything counts or globs runners, they need somewhere to be. On A this
  # is <line>/runners and usually exists already; on B it is the first thing that
  # puts the line onto the /scratch export.
  #
  # lists/ gehoert dazu: gcs-testrun legt dort seine Plaene und Laufordner ab und
  # verweist in seiner Fehlermeldung ausdruecklich auf "gcs-runners init". Auf A
  # existierte das Verzeichnis seit jeher, deshalb ist nie aufgefallen, dass es
  # niemand anlegt -- eine frisch aufgebaute Flotte scheitert daran sofort.
  mkdir -p "$(runners_dir "$line")/lists"
  cfg="$lroot/config/defaults-$line.sav"
  canon="$(readlink -f "$lroot/config/$line" 2>/dev/null || true)"
  [ -n "$canon" ] && [ -x "$canon" ] || canon="$SCRIPT_DIR/$line"
  # readlink -f canonicalises, and on the server that turns /home/<user> back
  # into /export/home/<user>, which no other host has. The value goes into the
  # generated wrapper as CS_TOOL_DIR and as the dot-sourced path, so it has to
  # hold wherever the wrapper runs -- gcs-run-unit invokes it on the runner's
  # own host, not here.
  case "$canon" in /export/home/*) canon="/home${canon#/export/home}" ;; esac
  [ -x "$canon" ] || die "line script not found: $canon"

  # Collect free ports. Important: a runner that already has a port keeps it --
  # otherwise init would not be repeatable, because used_ports() sees our own
  # runner configurations (through the symlinks in <line>/config/) and would
  # report every already assigned port as taken.
  local ports=() assigned=() need=0
  while IFS= read -r port; do ports+=("$port"); done < <(free_runner_ports "$line")
  [ -n "$want" ] || want=$(( ${#ports[@]} + $(runner_count "$line") ))
  for i in $(seq 1 "$want"); do
    port="$(read_sav_value "$(runner_root "$line" "$i")/config/defaults-$(runner_name "$line" "$i").sav" commd_port)"
    if [ -n "$port" ]; then assigned+=("$port"); else assigned+=(""); need=$((need+1)); fi
  done
  [ "${#ports[@]}" -ge "$need" ] \
    || die "only ${#ports[@]} free registered ports in [$(line_port_window "$line" | tr ' ' ',')), needed: $need
       register further even ports via the testsuite menu (user config) -- that is what vends the gid_range"

  local next=0
  for i in $(seq 1 "$want"); do
    if [ -z "${assigned[$((i-1))]}" ]; then assigned[$((i-1))]="${ports[$next]}"; next=$((next+1)); fi
  done

  info "line:    $lroot"
  info "runners: $want   ports: ${assigned[*]}"
  for i in $(seq 1 "$want"); do
    port="${assigned[$((i-1))]}"
    rroot="$(runner_root "$line" "$i")"
    name="$(runner_name "$line" "$i")"
    mkdir -p "$rroot/config" "$rroot/inst" "$rroot/html" "$rroot/results" "$rroot/pkg"

    # Mirror the line's repositories in so that the paths derived by the line
    # script (SGE_SOURCE/SGE_TEST/...) resolve, without copying anything.
    local d
    for d in "$lroot"/*/; do
      d="${d%/}"
      [ -e "$d/.git" ] || continue
      ln -sfn "$d" "$rroot/$(basename "$d")"
    done

    gen_sav "$cfg" "$rroot/config/defaults-$name.sav" "$port" "$rroot"

    # Companion configurations (defaults-<line>.<project>.sav, .mpi.sav for
    # instance) are located by inserting the project name before the .sav
    # extension of the main configuration IN USE -- so they have to sit next to
    # it under the runner's name, otherwise verifying the MPI configuration
    # aborts the install. They carry no line specific paths or ports, hence a
    # plain copy.
    local addcfg proj
    for addcfg in "$lroot"/config/defaults-"$line".*.sav; do
      [ -f "$addcfg" ] || continue
      proj="$(basename "$addcfg")"; proj="${proj#defaults-$line.}"; proj="${proj%.sav}"
      cp "$addcfg" "$rroot/config/defaults-$name.$proj.sav"
    done

    # port visibility for gcs-feature-workspace (see the header comment)
    link="$lroot/config/defaults-$name.sav"
    ln -sfn "$rroot/config/defaults-$name.sav" "$link"

    wrapper="$rroot/config/$name"
    cat > "$wrapper" <<EOF
#!/bin/sh
# Generated by gcs-runners -- runner $i of line $line.
# Thin env wrapper; all logic stays in the shared line script.
# Regenerate with: gcs-runners $line init
CS_PIPELINE=$name
CS_HOME=$rroot
CS_MASTER_PORT=$port
CS_WRAPPER_ACTIVE=1
# Where the tools live. Passed in rather than left to be guessed: this wrapper
# runs under /bin/sh, so the sourced script sees only \$0 -- which is this file,
# not the tool directory. Guessing via PATH fails under an IDE, which inherits
# the desktop session environment.
CS_TOOL_DIR=$(dirname "$canon")
export CS_PIPELINE CS_HOME CS_MASTER_PORT CS_WRAPPER_ACTIVE CS_TOOL_DIR
. $canon "\$@"
EOF
    chmod +x "$wrapper"
    ln -sfn "$wrapper" "$(line_bindir "$lroot" "$line")/$name"
    info "  + r$i  port $port/$((port+1))  cluster p$port  -> $rroot"
  done
  info ""
  info "next step: gcs-runners $line install $want"
}

# Ports that are listening on the host the clusters actually run on.
#
# Asked once, on master_host, and matched locally afterwards -- not once per
# runner, which would be one ssh round trip per row of the table.
#
# Asking the LOCAL ss was simply wrong: a runner's qmaster runs on master_host,
# so the check never saw it and the CLUSTER column reported "-" for every
# runner, running or not. Same blind spot that made a feature workspace look
# safe to tear down while its cluster was up.
listening_ports_on_master() {
  local line="$1" mh
  mh="$(read_sav_value "$(line_root "$1")/config/defaults-$line.sav" master_host)"
  [ -n "$mh" ] || mh="$(hostname -s)"
  if [ "$mh" = "$(hostname -s)" ]; then
    ss -ltnH 2>/dev/null | awk '{print $4}' | sed 's/.*://' | grep -E '^[0-9]+$' | sort -u
  else
    timeout 15 ssh -o BatchMode=yes -o ConnectTimeout=4 -o StrictHostKeyChecking=no "$mh" \
      "ss -ltnH 2>/dev/null | awk '{print \$4}' | sed 's/.*://' | grep -E '^[0-9]+\$' | sort -u" 2>/dev/null
  fi
}

cmd_status() {
  local line="${1:?line required}" d i port root state up
  have_runners "$line" || { info "(no runners for $line)"; return; }
  up=" $(listening_ports_on_master "$line" | tr '\n' ' ') "
  printf '%-10s %-6s %-9s %-8s %s\n' RUNNER PORT INST CLUSTER PATH
  for d in "$(runners_dir "$line")"/r*/; do
    d="${d%/}"; [ -d "$d" ] || continue
    i="$(basename "$d" | tr -d 'r')"
    port="$(read_sav_value "$d/config/defaults-$(runner_name "$line" "$i").sav" commd_port)"
    root="$(read_sav_value "$d/config/defaults-$(runner_name "$line" "$i").sav" product_root)"
    [ -d "$root/bin" ] && state=binary || state=empty
    if case "$up" in *" $port "*) true ;; *) false ;; esac; then
      printf '%-10s %-6s %-9s %-8s %s\n' "r$i" "$port" "$state" "running" "$d"
    else
      printf '%-10s %-6s %-9s %-8s %s\n' "r$i" "$port" "$state" "-" "$d"
    fi
  done
}

cmd_install() {
  # Parallel by default, like teardown. Serial installs the fleet one cluster
  # after the other at roughly three minutes each -- 32 runners are an hour and
  # a half of wall clock for work that has no reason to be sequential.
  # "-s" keeps the serial path for when it is wanted: it is the quiet one, every
  # cluster has the hosts to itself, and it avoids the install races of CS-2481
  # that only show up under the parallel load.
  local line="${1:?line required}" want="" par="-p"
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      -s|--serial) par="" ;;
      -p)          par="-p" ;;   # already the default; accepted so old invocations keep working
      *)           want="$1" ;;
    esac
    shift
  done
  local lroot linst rroot name i rc=0 pids=()
  lroot="$(line_root "$line")"
  # The source of the mirror moves with the segment exactly as its destination
  # does: on B the line's own inst/ is on /scratch, not in the tree. Asked the
  # same way and with the same fallback as everywhere else.
  linst="$("$SCRIPT_DIR/gcs-segment" inst "$lroot" 2>/dev/null)" || linst="$lroot/inst"
  [ -n "$linst" ] || linst="$lroot/inst"
  [ -d "$linst" ] || die "the line has nothing installed: $linst  ($line install)"
  have_runners "$line" || die "no runners -- run 'gcs-runners $line init' first"
  [ -n "$want" ] || want="$(runner_count "$line")"

  for i in $(seq 1 "$want"); do
    rroot="$(runner_root "$line" "$i")"
    [ -d "$rroot" ] || die "runner r$i missing -- run 'init' first"
    # Before touching anything: name what is still talking to this runner's
    # ports. See report_foreign_port_users() for why an install cannot fix it.
    report_foreign_port_users \
        "$(read_sav_value "$rroot/config/defaults-$(runner_name "$line" "$i").sav" commd_port)" \
        "$rroot"
    # Mirror the line's binaries; the cell (cluster state) stays out, the
    # install creates that itself.
    #
    # Why as root: inst/utilbin/<arch>/ holds testsuidroot as -r-s--x--x
    # root:root. An unprivileged user can neither read the file nor set the
    # setuid bit at the destination, so rsync aborts with code 23. The CI works
    # around this by running a full build per cluster and letting distinst do
    # the installation -- that costs N full builds. A root rsync takes seconds
    # and yields the same result. Ownership is preserved (rsync -a), so only
    # this single file ends up root:root.
    info "  r$i: mirroring $linst (as root, setuid binaries) ..."
    "$SCRIPT_DIR/as-root" "$(hostname -s)" \
        "rsync -a --delete --exclude=/default '$linst/' '$rroot/inst/'" >/dev/null
  done

  for i in $(seq 1 "$want"); do
    name="$(runner_name "$line" "$i")"
    if [ "$par" = "-p" ]; then
      # N clusters installing at the same moment is the densest load this setup
      # produces -- they all do the same thing at the same time. It is also where
      # the two install races were seen (qconf -Mconf returning a warning as an
      # error, install_shadowd with "configuration not defined"), both of them
      # the change_timeout_value path that ts_scale_timeout now scales, and both
      # fine when repeated on their own. See CS-2481.
      # The serial branch below stays at factor 1: it has the hosts to itself.
      ( CS_TIMEOUT_FACTOR="${CS_TIMEOUT_FACTOR:-3}" \
        "$name" install >"$(runner_root "$line" "$i")/install.log" 2>&1 ) & pids+=("$!")
      info "  r$i: install started (PID ${pids[-1]})"
    else
      info "  r$i: installing ..."
      if "$name" install >"$(runner_root "$line" "$i")/install.log" 2>&1; then
        info "  r$i: ok"
      else
        info "  r$i: FAILED (see $(runner_root "$line" "$i")/install.log)"; rc=1
      fi
    fi
  done
  if [ "$par" = "-p" ]; then
    for i in "${!pids[@]}"; do wait "${pids[$i]}" || { info "  r$((i+1)): FAILED"; rc=1; }; done
  fi
  # A freshly installed cluster is clean by definition, so the marker that
  # gcs-run-unit leaves behind on an interrupted run is stale now. Without this
  # every slot would reinstall itself once more on the first test of the next
  # run -- repairing what was just built.
  for i in $(seq 1 "$want"); do
    rm -f "$(runner_root "$line" "$i")/.unit-in-progress"
  done
  return $rc
}

# Parallel is the DEFAULT here, unlike install where it is opt-in. Why:
#
# A teardown is N independent testsuite shutdowns, and each one kills qmaster,
# execd and shadowd on EVERY execd host and waits for them to be gone -- 45 to
# 90 s per cluster. Serially that is half an hour for 32 runners, which is
# absurd for an operation whose whole job is to stop things.
#
# Parallel install has documented races (CS-2481: qconf -Mconf reporting a
# warning as an error, install_shadowd seeing "configuration not defined"), and
# both come from N clusters WRITING configuration at the same moment. A shutdown
# writes no configuration. The only shared thing this function touches is the
# line's config directory, and the per-runner .sav and symlink names are unique,
# so there is nothing to contend on.
#
# The shutdowns still get CS_TIMEOUT_FACTOR=3 like the parallel install: the
# testsuite's waits are absolute, and N clusters stopping at once is exactly the
# load those waits do not expect.
#
# Measured 2026-08-05: 22 clusters, 60 s in parallel against an estimated 20-30
# minutes serially. That is why it is the default rather than a flag nobody
# remembers to pass -- "-s"/"--serial" is there if a shutdown ever needs
# isolating, and "-p" is still accepted so existing invocations keep working.
#
# File removal is deliberately NOT parallel. It runs after every shutdown has
# been waited for, so a cluster is never removed underneath a shutdown that is
# still talking to it -- and rm is not what makes this slow.
cmd_teardown() {
  local line="${1:?line required}" want="" force="" par="-p"
  local lroot rroot name i a pids=()
  shift
  for a in "$@"; do
    case "$a" in
      --force)     force="--force" ;;
      -s|--serial) par="" ;;
      -p)          par="-p" ;;   # already the default; accepted so old invocations keep working
      ''|*[!0-9]*) die "teardown: unexpected argument '$a' (expected N, -s/--serial or --force)" ;;
      *)           want="$a" ;;
    esac
  done
  lroot="$(line_root "$line")"
  have_runners "$line" || { info "(no runners)"; return; }
  [ -n "$want" ] || want="$(runner_count "$line")"

  for i in $(seq 1 "$want"); do
    rroot="$(runner_root "$line" "$i")"; name="$(runner_name "$line" "$i")"
    [ -d "$rroot" ] || continue
    if [ "$par" = "-p" ]; then
      ( CS_TIMEOUT_FACTOR="${CS_TIMEOUT_FACTOR:-3}" \
        "$name" shutdown >"$rroot/shutdown.log" 2>&1 || true ) & pids+=("$!")
      info "  r$i: shutdown started (PID ${pids[-1]})"
    else
      "$name" shutdown >/dev/null 2>&1 || true
    fi
  done
  if [ "$par" = "-p" ]; then
    for i in "${!pids[@]}"; do wait "${pids[$i]}" || true; done
  fi

  for i in $(seq 1 "$want"); do
    rroot="$(runner_root "$line" "$i")"; name="$(runner_name "$line" "$i")"
    [ -d "$rroot" ] || continue
    # line_bindir, not "readlink -f" -- exactly as init placed it. readlink -f
    # follows through the link farm into the checkout, so teardown deleted
    # <checkout>/tools/<line>-rN, which never existed, and left the wrapper
    # symlink on PATH behind. That is how a torn down fleet kept leaving one dead
    # link per runner in the link farm.
    rm -f "$lroot/config/defaults-$name.sav" "$(line_bindir "$lroot" "$line")/$name"
    [ "$force" = "--force" ] && { rm -rf "$rroot"; info "  - r$i removed (including inst/results)"; } \
                             || info "  - r$i shut down, directory kept (--force removes it)"
  done
}

# Does every execd still process the jobs it is running?
#
# An execd can look perfectly healthy -- port open, load reported, jobs accepted,
# shepherds started -- while it has silently dropped its running jobs from its
# bookkeeping (CS-2495). Neither "status" nor qstat -f shows it. What it does show
# up as is a fixed subset of tests failing for reasons that read like product
# defects: no wallclock usage, no resource limit, no deleted_by in the accounting
# record. Since ctest pins each test to one cluster, one such execd quietly
# poisons its whole share of a run.
#
# The probe is the cheapest thing that touches exactly that code path: a job with
# a ten second hard limit. A healthy execd kills it, a stalled one does not. One
# job per cluster and execd host, all at the same time, so the check costs about
# a minute regardless of how many runners there are.
# qsub/qstat/qdel gegen einen Cluster ausfuehren -- aber VON EINEM CLUSTER-HOST.
#
# Auf A war der TS-Treiber zugleich master_host, deshalb lief das hier lokal und
# fiel jahrelang nicht auf. Auf B ist der Treiber server-00 und gehoert dem
# Cluster ueberhaupt nicht an: er steht in keiner Rolle der .sav, weder als
# submit_only_host noch als admin_only_host. Ein qsub von dort wird dann nicht
# einmal abgelehnt -- er bleibt in der Commlib haengen, ohne Fehler und ohne
# Timeout. Am 01.09.2026 stand der erste Probe-qsub so zwoelf Minuten, waehrend
# auf dem Master kein einziger Job ankam.
#
# master_host ist per Konstruktion Admin-Host, also die richtige Stelle. Ist er
# der lokale Rechner -- der A-Fall -- bleibt alles wie bisher, ohne ssh.
cluster_sh() {
  local mh="$1" root="$2" port="$3" cmd="$4"
  local pre="SGE_ROOT='$root' SGE_CELL=default SGE_QMASTER_PORT='$port' SGE_EXECD_PORT='$((port + 1))'"
  if [ "$mh" = "$(hostname -s)" ]; then
    sh -c "$pre $cmd"
  else
    timeout 60 ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no "$mh" "$pre $cmd"
  fi
}

cmd_health() {
  local line="${1:?line required}" want="${2:-}"
  local lroot cfg hosts root port arch qsub qstat qdel i h jid rc=0 mh
  local -a probes=()

  lroot="$(line_root "$line")"
  have_runners "$line" || die "no runners -- run 'gcs-runners $line init' first"
  [ -n "$want" ] || want="$(runner_count "$line")"

  hosts="$(read_sav_value "$lroot/config/defaults-$line.sav" execd_hosts)"
  [ -n "$hosts" ] || die "no execd_hosts in the line configuration"
  mh="$(read_sav_value "$lroot/config/defaults-$line.sav" master_host)"
  [ -n "$mh" ] || die "no master_host in the line configuration"
  [ "$mh" = "$(hostname -s)" ] || info "  submitting from $mh (this host is not part of the cluster)"

  info "  probing $want runners on: $hosts  (h_rt=$HEALTH_LIMIT)"
  for i in $(seq 1 "$want"); do
    cfg="$(runner_root "$line" "$i")/config/defaults-$(runner_name "$line" "$i").sav"
    root="$(read_sav_value "$cfg" product_root)"
    port="$(read_sav_value "$cfg" commd_port)"
    [ -d "$root/bin" ] || { info "  r$i: no installation -- skipped"; continue; }
    # `|| true` on every probe command, and it is not cosmetic. This script runs
    # under `set -euo pipefail`, and `var="$(cmd | ...)"` takes the pipeline's
    # status as the assignment's status -- so a cluster that refuses the submit
    # kills the whole probe on the spot. The guard on the next line never runs,
    # nothing is printed, and everything gathered so far is discarded.
    #
    # That is exactly what happened on 2026-08-08: r22 answered
    # `denied: host "h047" is no submit host`, and `health 32` returned a bare
    # header with status 1 -- indistinguishable from a probe that found nothing.
    # A health check whose whole purpose is to report broken clusters must not go
    # silent on the first broken cluster it meets.
    arch="$("$root/util/arch" 2>/dev/null)" || true
    if [ -z "$arch" ]; then
      info "  r$i: cannot determine arch -- skipped"; rc=1; continue
    fi
    for h in $hosts; do
      jid="$(cluster_sh "$mh" "$root" "$port" \
             "'$root/bin/$arch/qsub' -b y -l hostname='$h' -l h_rt='$HEALTH_LIMIT' -o /dev/null -e /dev/null sleep 300" \
             2>/dev/null | grep -oE '[0-9]+' | head -1)" || true
      [ -n "$jid" ] && probes+=("$i $h $jid") || { info "  r$i/$h: qsub failed"; rc=1; }
    done
  done

  # Long enough for the scheduler to place the job (interval) and for the limit to
  # expire on top of it. Shorter and a healthy cluster looks broken.
  sleep "$HEALTH_WAIT"

  # Quiet unless something is wrong: this runs in front of every complete test
  # run, and 96 lines of "ok" only bury the one line that matters. GCS_HEALTH_VERBOSE
  # prints every probe.
  local ok=0
  [ -n "${GCS_HEALTH_VERBOSE:-}" ] && printf '%-8s %-16s %-10s %s\n' RUNNER HOST JOB RESULT
  # No probe got submitted at all -- say so rather than reporting "0 of 0 ok",
  # which reads like a clean result.
  if [ "${#probes[@]}" -eq 0 ]; then
    info "  no cluster accepted a probe job -- nothing could be checked"
    return 1
  fi

  for p in "${probes[@]}"; do
    read -r i h jid <<< "$p"
    cfg="$(runner_root "$line" "$i")/config/defaults-$(runner_name "$line" "$i").sav"
    root="$(read_sav_value "$cfg" product_root)"
    port="$(read_sav_value "$cfg" commd_port)"
    # Same reason as above: under `set -euo pipefail` a failing qstat would end
    # the evaluation here, and the probes already submitted would never be
    # reported. A cluster that dies between submit and check is a finding, not a
    # reason to stop looking at the other 31.
    arch="$("$root/util/arch" 2>/dev/null)" || true
    local state
      state="$(cluster_sh "$mh" "$root" "$port" "'$root/bin/$arch/qstat' -u \\*" 2>/dev/null \
               | awk -v j="$jid" '$1 == j { print $5 }')" || true
    case "$state" in
      "")         ok=$((ok + 1))
                  [ -n "${GCS_HEALTH_VERBOSE:-}" ] && printf '%-8s %-16s %-10s %s\n' "r$i" "$h" "$jid" "ok" ;;
      qw|hqw|Eqw) printf '%-8s %-16s %-10s %s\n' "r$i" "$h" "$jid" "PENDING (never started -- host or queue unusable)"; rc=1 ;;
      *)          printf '%-8s %-16s %-10s %s\n' "r$i" "$h" "$jid" "STALLED (state $state, h_rt=$HEALTH_LIMIT ignored -- see CS-2495)"; rc=1 ;;
    esac
    # A stalled execd will not remove its own job -- and it is a "sleep 300".
    if [ -n "$state" ]; then
        cluster_sh "$mh" "$root" "$port" "'$root/bin/$arch/qdel' -f '$jid'" >/dev/null 2>&1 || true
    fi
  done

  [ "$rc" -eq 0 ] && info "  $ok of ${#probes[@]} probes ok -- every cluster enforces its limits" \
                  || info "  $ok of ${#probes[@]} probes ok -- restart the execd on the hosts listed above (as root: sgeexecd start)"
  return $rc
}

[ $# -ge 2 ] || usage 1
line="$1"; sub="$2"; shift 2 || true
case "$sub" in
  init)     cmd_init     "$line" "$@" ;;
  install)  cmd_install  "$line" "$@" ;;
  status)   cmd_status   "$line" "$@" ;;
  health)   cmd_health   "$line" "$@" ;;
  teardown) cmd_teardown "$line" "$@" ;;
  -h|--help|help) usage 0 ;;
  *) die "unknown command: '$sub' (init|install|status|health|teardown)" ;;
esac
